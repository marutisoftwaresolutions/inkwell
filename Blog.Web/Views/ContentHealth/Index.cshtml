@using Blog.Core.Domain
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Content Health";
    ViewData["Description"] = "Published posts that need maintenance — reviews falling due, missing answer blocks, and snippets that will truncate in search results. Read-only; each row links to the editor.";

    var items   = (IReadOnlyList<ContentHealthItem>)ViewBag.Items;
    var summary = (ContentHealthSummary)ViewBag.Summary;
    var filter  = (string)ViewBag.Filter;
    var q       = ViewData[Blog.Web.Models.ListPaging.QueryKey] as string ?? "";

    string Ago(DateTime? utc)
    {
        if (utc is null) return "—";
        var d = DateTime.UtcNow - utc.Value;
        if (d.TotalDays < 1) return "today";
        if (d.TotalDays < 30) return $"{(int)d.TotalDays}d ago";
        if (d.TotalDays < 365) return $"{(int)(d.TotalDays / 30)}mo ago";
        return $"{(int)(d.TotalDays / 365)}y ago";
    }
    string Due(DateTime? utc)
    {
        if (utc is null) return "not set";
        var d = utc.Value - DateTime.UtcNow;
        if (d.TotalDays < 0) return $"overdue {(int)-d.TotalDays}d";
        if (d.TotalDays < 30) return $"in {(int)d.TotalDays}d";
        return Dates.CalendarDate(utc, Blog.Core.Services.DateStyle.Medium);
    }
    string TileClass(string key) => filter == key
        ? "desk-kpi border-primary ring-1 ring-primary"
        : "desk-kpi hover:border-primary/60";
    string? Current(string key) => filter == key ? "page" : null;
    // Block pills: present → ok, missing → warn. Colour is never the only signal; the text says which.
    string BlockPill(bool has) => has ? "desk-pill pill-ok" : "desk-pill pill-warn";
    string AeoPill(int score) => score >= 70 ? "desk-pill pill-ok" : score >= 50 ? "desk-pill pill-warn" : "desk-pill pill-bad";
}

@if (filter != "attention")
{
    @section PageActions {
        <a href="/admin/content-health" class="desk-btn desk-btn-outline">Everything needing attention</a>
    }
}

@* ── Tiles double as filters ───────────────────────────────────────────── *@
<div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3 mb-6">
    <a href="?filter=all" class="@TileClass("all")" aria-current="@Current("all")">
        <div class="desk-kpi-value">@summary.Total</div>
        <div class="desk-kpi-label">Published</div>
    </a>
    <a href="?filter=overdue" class="@TileClass("overdue")" aria-current="@Current("overdue")">
        <div class="desk-kpi-value @(summary.ReviewOverdue > 0 ? "tone-bad" : "")">@summary.ReviewOverdue</div>
        <div class="desk-kpi-label">Review overdue</div>
    </a>
    <a href="?filter=duesoon" class="@TileClass("duesoon")" aria-current="@Current("duesoon")">
        <div class="desk-kpi-value @(summary.ReviewDueSoon > 0 ? "tone-warn" : "")">@summary.ReviewDueSoon</div>
        <div class="desk-kpi-label">Due in 30 days</div>
    </a>
    <a href="?filter=unverified" class="@TileClass("unverified")" aria-current="@Current("unverified")">
        <div class="desk-kpi-value">@summary.NeverVerified</div>
        <div class="desk-kpi-label">Never verified</div>
    </a>
    <a href="?filter=nokeyfacts" class="@TileClass("nokeyfacts")" aria-current="@Current("nokeyfacts")">
        <div class="desk-kpi-value @(summary.MissingKeyFacts > 0 ? "tone-warn" : "")">@summary.MissingKeyFacts</div>
        <div class="desk-kpi-label">No key facts</div>
    </a>
    <a href="?filter=meta" class="@TileClass("meta")" aria-current="@Current("meta")">
        <div class="desk-kpi-value @(summary.MetaIssues > 0 ? "tone-warn" : "")">@summary.MetaIssues</div>
        <div class="desk-kpi-label">Snippet issues</div>
    </a>
    <a href="?filter=staleyear" class="@TileClass("staleyear")" aria-current="@Current("staleyear")">
        <div class="desk-kpi-value @(summary.StaleYearStamps > 0 ? "tone-bad" : "")">@summary.StaleYearStamps</div>
        <div class="desk-kpi-label">Stale year in title</div>
    </a>
    <a href="?filter=weakaeo" class="@TileClass("weakaeo")" aria-current="@Current("weakaeo")" aria-describedby="tile-weakaeo-hint">
        <div class="desk-kpi-value @(summary.WeakAeo > 0 ? "tone-warn" : "")">@summary.WeakAeo</div>
        <div class="desk-kpi-label">Weak AEO (avg @summary.AverageAeoScore)</div>
        <span id="tile-weakaeo-hint" class="sr-only">Average across all published posts: @summary.AverageAeoScore out of 100</span>
    </a>
    @* Not counted up front: the check reads every article body, so it runs when this tile is opened. *@
    <a href="?filter=a11y" class="@TileClass("a11y")" aria-current="@Current("a11y")" aria-describedby="tile-a11y-hint">
        <div class="desk-kpi-value">@(filter == "a11y" ? items.Count.ToString() : "Check")</div>
        <div class="desk-kpi-label">Accessibility</div>
        <span id="tile-a11y-hint" class="sr-only">Images without alt text, skipped heading levels, vague link text, tables without a header row, very long paragraphs</span>
    </a>
</div>

@* ── Search Console tiles — only once a property is connected and has delivered data ── *@
@if (summary.SearchConnected)
{
    <div class="grid grid-cols-3 gap-3 mb-2">
        <a href="?filter=striking" class="@TileClass("striking")" aria-current="@Current("striking")" aria-describedby="tile-striking-hint">
            <div class="desk-kpi-value @(summary.StrikingDistance > 0 ? "tone-ok" : "")">@summary.StrikingDistance</div>
            <div class="desk-kpi-label">Striking distance</div>
            <span id="tile-striking-hint" class="sr-only">Position 8–20 with at least @Blog.Core.Services.SearchPerformanceAnalyzer.StrikingMinImpressions impressions in 28 days</span>
        </a>
        <a href="?filter=losing" class="@TileClass("losing")" aria-current="@Current("losing")" aria-describedby="tile-losing-hint">
            <div class="desk-kpi-value @(summary.LosingImpressions > 0 ? "tone-bad" : "")">@summary.LosingImpressions</div>
            <div class="desk-kpi-label">Losing impressions</div>
            <span id="tile-losing-hint" class="sr-only">Impressions at or below @((int)(Blog.Core.Services.SearchPerformanceAnalyzer.LosingRatio * 100))% of the previous 28 days</span>
        </a>
        <a href="?filter=lowctr" class="@TileClass("lowctr")" aria-current="@Current("lowctr")" aria-describedby="tile-lowctr-hint">
            <div class="desk-kpi-value @(summary.LowCtrForPosition > 0 ? "tone-warn" : "")">@summary.LowCtrForPosition</div>
            <div class="desk-kpi-label">Low CTR for rank</div>
            <span id="tile-lowctr-hint" class="sr-only">Page one with CTR under @((Blog.Core.Services.SearchPerformanceAnalyzer.LowCtrFloor * 100).ToString("0.0"))%</span>
        </a>
    </div>
    <p class="text-[11px] text-muted-foreground mb-6">Google Search, web results, 28 days through @Dates.CalendarDate(summary.SearchAsOf, Blog.Core.Services.DateStyle.Medium) against the 28 before.</p>
}
else if (ViewBag.SearchConfigured == true)
{
    <p class="text-[11px] text-muted-foreground mb-6">Search Console is connected; search tiles appear after the first nightly sync (see Admin → Dashboard → Scheduled jobs).</p>
}
else
{
    <p class="text-[11px] text-muted-foreground mb-6">Connect Search Console under <a href="/admin/settings" class="underline">Settings</a> to add striking-distance, losing-impressions and low-CTR filters here.</p>
}

@* ── Worklist ──────────────────────────────────────────────────────────── *@
<partial name="_ListSearch" />

<div class="desk-card overflow-hidden">
    @if (items.Count == 0)
    {
        if (!string.IsNullOrEmpty(q))
        {
            ViewData["EmptyQuery"] = q;
            ViewData["EmptyClearHref"] = $"?filter={filter}";
            ViewData["EmptyHint"] = "to see every post in this view.";
        }
        else
        {
            ViewData["EmptyTitle"] = filter == "a11y" ? "No accessibility problems found in published posts" : "Nothing needs attention here";
            ViewData["EmptyHint"] = filter == "attention" ? "Every published post is verified, reviewed on time and carries its answer blocks." : "Pick another tile above to see a different check.";
        }
        <partial name="_EmptyState" />
    }
    else
    {
    <div class="table-scroll"><table class="desk-table">
        <thead>
            <tr>
                <th>Post</th>
                <th>Verified</th>
                <th>Review</th>
                <th>Blocks</th>
                <th>Snippet</th>
                <th class="text-right">AEO</th>
                @if (summary.SearchConnected)
                {
                    <th class="text-right"><abbr title="Clicks / impressions / average position, last 28 days" class="no-underline">Search · 28d</abbr></th>
                }
                <th class="text-right"><span class="sr-only">Open</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in items)
            {
                <tr class="align-top">
                    <td class="align-top max-w-[26rem]">
                        <div class="text-foreground">@i.Title</div>
                        <div class="text-[11px] font-mono text-muted-foreground break-all">/@i.Slug</div>
                        @if (i.StaleYearStamp)
                        {
                            <span class="desk-pill pill-bad mt-1">year stamp is stale</span>
                        }
                        @if (i.Accessibility is { Count: > 0 } a11y)
                        {
                            <ul class="mt-1 space-y-0.5 text-[11px] tone-warn">
                                @foreach (var f in a11y) { <li>@f.Title</li> }
                            </ul>
                        }
                    </td>
                    <td class="align-top text-xs whitespace-nowrap @(i.NeverVerified ? "tone-warn" : "text-muted-foreground")"
                        title="@(i.LastVerifiedAt is null ? "never verified" : Dates.CalendarDate(i.LastVerifiedAt))">
                        @(i.NeverVerified ? "never" : Ago(i.LastVerifiedAt))
                    </td>
                    <td class="align-top text-xs whitespace-nowrap @(i.ReviewOverdue ? "tone-bad font-medium" : i.ReviewDueSoon ? "tone-warn" : "text-muted-foreground")"
                        title="@(i.NextReviewAt is null ? "no review date" : Dates.CalendarDate(i.NextReviewAt))">
                        @Due(i.NextReviewAt)
                    </td>
                    <td class="align-top whitespace-nowrap">
                        <span class="@BlockPill(i.HasKeyFacts)">Key facts<span class="sr-only">@(i.HasKeyFacts ? " present" : " missing")</span></span>
                        <span class="@BlockPill(i.HasFaq)">FAQ<span class="sr-only">@(i.HasFaq ? " present" : " missing")</span></span>
                    </td>
                    <td class="align-top text-xs whitespace-nowrap @(i.MetaMissing || i.MetaTooLong ? "tone-warn" : "text-muted-foreground")">
                        @if (i.MetaMissing)
                        {
                            <span>missing</span>
                        }
                        else
                        {
                            <span>@i.MetaLength chars@(i.MetaTooLong ? " · truncates" : "")</span>
                        }
                    </td>
                    <td class="align-top text-right whitespace-nowrap">
                        <span class="@AeoPill(i.AeoScore)" title="Answer-engine readiness. Open the post to see what is missing.">@i.AeoScore</span>
                    </td>
                    @if (summary.SearchConnected)
                    {
                        <td class="align-top text-right whitespace-nowrap text-xs">
                            @if (i.Search is { HasData: true } s)
                            {
                                <span class="text-foreground">@s.Clicks</span><span class="text-muted-foreground"> / @s.Impressions / @s.Position.ToString("0.0")</span>
                                @if (s.StrikingDistance) { <span class="desk-pill pill-ok ml-1"><abbr title="Striking distance" class="no-underline">SD</abbr></span> }
                                @if (s.LosingImpressions) { <span class="desk-pill pill-bad ml-1"><span aria-hidden="true">↓</span><span class="sr-only">Losing impressions</span></span> }
                                @if (s.LowCtrForPosition) { <span class="desk-pill pill-warn ml-1"><abbr title="Low click-through rate for rank" class="no-underline">CTR</abbr></span> }
                            }
                            else
                            {
                                <span class="text-muted-foreground" title="No impressions in the last 56 days">—</span>
                            }
                        </td>
                    }
                    <td class="align-top">
                        <div class="desk-row-actions">
                            <a href="/admin/posts/edit/@i.Id" class="desk-btn desk-btn-outline desk-btn-sm" aria-label="Edit “@i.Title”">Edit</a>
                            <a href="/@i.Slug" target="_blank" rel="noopener" class="desk-btn desk-btn-ghost desk-btn-sm" aria-label="View “@i.Title” on the site (opens in a new tab)">View</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
    }
</div>

<partial name="_ListPager" />

<p class="text-[11px] text-muted-foreground mt-3">
    Snippets are flagged over @ContentHealthItem.MetaDescriptionLimit characters, the point at which search
    results usually truncate. A stale year stamp means the title promises a year that has already passed —
    update the content, not just the number.
</p>
