@using Blog.Core.Domain
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Security";
    ViewData["Description"] = "Automatic IP blocking. Addresses that probe for exploits, hammer missing URLs, or fail sign-in repeatedly are scored and blocked without intervention. Admin-only.";

    var items      = (IReadOnlyList<IpFirewallRule>)ViewBag.Items;
    var stats      = (FirewallStats)ViewBag.Stats;
    var watchlist  = (IReadOnlyList<IpWatchEntry>)ViewBag.Watchlist;
    var settings   = (UserSettings)ViewBag.Settings;
    var invalid    = (IReadOnlyList<string>)ViewBag.InvalidAllowlistEntries;
    var yourIp     = (string)ViewBag.YourIp;
    var page       = (int)ViewBag.Page;
    string? filterKind  = ViewBag.FilterKind;
    string? filterQuery = ViewBag.FilterQuery;
    var qPart = string.IsNullOrEmpty(filterQuery) ? "" : "&q=" + Uri.EscapeDataString(filterQuery);

    string Ago(DateTime utc)
    {
        var d = DateTime.UtcNow - utc;
        if (d.TotalMinutes < 1) return "just now";
        if (d.TotalHours < 1) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalDays < 1) return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }
    string Until(DateTime? utc)
    {
        if (utc is null) return "permanent";
        var d = utc.Value - DateTime.UtcNow;
        if (d.TotalSeconds <= 0) return "expired";
        if (d.TotalHours < 1) return $"{(int)d.TotalMinutes}m left";
        if (d.TotalDays < 1) return $"{(int)d.TotalHours}h left";
        return $"{(int)d.TotalDays}d left";
    }
}

@* ── Summary tiles ─────────────────────────────────────────────── *@
<div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
    <div class="desk-kpi">
        <div class="desk-kpi-value">@stats.ActiveBlocks.ToString("N0")</div>
        <div class="desk-kpi-label">Active blocks</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value tone-warn">@stats.BlocksLast24h.ToString("N0")</div>
        <div class="desk-kpi-label">Blocked in 24h</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value tone-bad">@stats.PermanentBlocks.ToString("N0")</div>
        <div class="desk-kpi-label">Permanent</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value">@stats.RequestsDenied.ToString("N0")</div>
        <div class="desk-kpi-label">Requests denied</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value">@watchlist.Count.ToString("N0")</div>
        <div class="desk-kpi-label">Under observation</div>
    </div>
</div>

@if (!settings.FirewallEnabled)
{
    <div class="mb-6 rounded-lg border p-4 pill-warn text-sm">
        The firewall is <strong>off</strong> — existing rules are not enforced and no new blocks are created.
        Turn it on under Firewall settings below.
    </div>
}
@if (invalid.Count > 0)
{
    <div class="mb-6 rounded-lg border p-4 pill-warn text-sm">
        Ignoring unparseable allowlist @(invalid.Count == 1 ? "entry" : "entries"): <strong>@string.Join(", ", invalid)</strong>.
        Use an address (<code>203.0.113.7</code>) or a CIDR range (<code>203.0.113.0/24</code>).
    </div>
}

@* ── Manual rules ──────────────────────────────────────────────── *@
<div class="grid md:grid-cols-2 gap-3 mb-6">
    <form method="post" action="/admin/security/block" class="desk-card p-4"
          data-confirm-title="Block this address?" data-confirm-body="Every request from it gets a 403 until the block expires or you remove it. Your own address and allowlisted ranges can never be blocked." data-confirm-action="Block address" data-confirm-tone="warning">
        @Html.AntiForgeryToken()
        <h2 class="desk-card-title mb-3">Block an address</h2>
        <div class="flex flex-wrap gap-2">
            <input type="text" name="ip" placeholder="203.0.113.7" required aria-label="Address to block"
                   class="desk-input desk-input-sm flex-1 min-w-[9rem] font-mono" />
            <select name="hours" aria-label="Block duration" class="desk-select desk-select-sm w-auto">
                <option value="24">24 hours</option>
                <option value="168">7 days</option>
                <option value="720">30 days</option>
                <option value="0">Permanent</option>
            </select>
            <button type="submit" class="desk-btn desk-btn-sm desk-btn-danger">Block</button>
        </div>
        <input type="text" name="reason" placeholder="Reason (optional)" aria-label="Reason for blocking"
               class="desk-input desk-input-sm mt-2" />
    </form>

    <form method="post" action="/admin/security/allow" class="desk-card p-4">
        @Html.AntiForgeryToken()
        <h2 class="desk-card-title mb-3">Allowlist an address</h2>
        <div class="flex flex-wrap gap-2">
            <input type="text" name="ip" placeholder="@yourIp" required aria-label="Address to allowlist"
                   class="desk-input desk-input-sm flex-1 min-w-[9rem] font-mono" />
            <button type="submit" class="desk-btn desk-btn-sm desk-btn-primary">Allow</button>
        </div>
        <input type="text" name="reason" placeholder="Reason (optional)" aria-label="Reason for allowlisting"
               class="desk-input desk-input-sm mt-2" />
        <p class="desk-hint mt-2">
            Your current address is <span class="font-mono">@yourIp</span>. Loopback and private ranges are always allowed.
        </p>
    </form>
</div>

@* ── Watchlist ─────────────────────────────────────────────────── *@
@if (watchlist.Count > 0)
{
    <div class="desk-card overflow-hidden mb-6">
        <div class="desk-card-header">
            <h2 class="desk-card-title">Under observation</h2>
            <p class="desk-card-description">
                Scoring toward the @settings.FirewallThresholdScore-point threshold in the current @settings.FirewallWindowMinutes-minute window.
            </p>
        </div>
        <div class="table-scroll"><table class="desk-table desk-table-compact">
            <thead>
                <tr>
                    <th>IP</th>
                    <th class="text-right">Score</th>
                    <th class="text-right">Requests</th>
                    <th>Last signal</th>
                    <th>Seen</th>
                    <th class="text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var w in watchlist)
                {
                    <tr>
                        <td class="font-mono text-xs">@w.IpAddress</td>
                        <td class="text-right font-semibold tone-warn">@w.Score</td>
                        <td class="text-right text-xs text-muted-foreground">@w.Requests</td>
                        <td class="text-xs text-muted-foreground break-all max-w-[24rem]">@w.LastReason</td>
                        <td class="text-xs text-muted-foreground whitespace-nowrap" title="@Dates.DateTimeSeconds(w.LastSeenAt)">@Ago(w.LastSeenAt)</td>
                        <td class="text-right">
                            <form method="post" action="/admin/security/block" class="inline"
                                  data-confirm-title="Block @w.IpAddress for 24 hours?" data-confirm-body="Every request from it gets a 403 for the next 24 hours. Search and AI crawlers are identified by user agent, not by address, so check the watchlist row before blocking a shared range." data-confirm-action="Block for 24 hours" data-confirm-tone="warning">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ip" value="@w.IpAddress" />
                                <input type="hidden" name="hours" value="24" />
                                <input type="hidden" name="reason" value="Blocked from the watchlist (score @w.Score)" />
                                <button type="submit" aria-label="Block @w.IpAddress for 24 hours" class="desk-btn desk-btn-sm desk-btn-danger-outline">Block</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    </div>
}

@* ── Filters: rule kind as tabs (carrying the search); search box and pager from the shared partials ── *@
<nav class="desk-tabs mb-4" aria-label="Filter by rule kind">
    <a href="?kind=@qPart" class="desk-tab" aria-current="@(string.IsNullOrEmpty(filterKind) ? "page" : null)">All rules</a>
    <a href="?kind=Block@qPart" class="desk-tab" aria-current="@(filterKind == "Block" ? "page" : null)">Blocked</a>
    <a href="?kind=Allow@qPart" class="desk-tab" aria-current="@(filterKind == "Allow" ? "page" : null)">Allowlisted</a>
</nav>
<partial name="_ListSearch" />

@* ── Rules ─────────────────────────────────────────────────────── *@
<div class="desk-card overflow-hidden">
    @if (items.Count == 0)
    {
        if (!string.IsNullOrEmpty(filterQuery))
        {
            ViewData["EmptyQuery"] = filterQuery;
            ViewData["EmptyClearHref"] = "?kind=" + filterKind;
        }
        else
        {
            ViewData["EmptyTitle"] = string.IsNullOrEmpty(filterKind) ? "No firewall rules yet" : (filterKind == "Block" ? "No blocked addresses" : "No allowlisted addresses");
            ViewData["EmptyHint"] = string.IsNullOrEmpty(filterKind) ? "Automatic blocks appear here as they happen. Block or allowlist an address by hand above." : "Add one by hand above, or choose All rules to see every rule.";
        }
        <partial name="_EmptyState" />
    }
    else
    {
    <div class="table-scroll"><table class="desk-table">
        <thead>
            <tr>
                <th>IP</th>
                <th>Rule</th>
                <th>Reason</th>
                <th class="text-right">Denied</th>
                <th>Created</th>
                <th>Expires</th>
                <th class="text-right">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in items)
            {
                var isBlock = r.Kind == IpRuleKinds.Block;
                <tr class="align-top">
                    <td class="font-mono text-xs">@r.IpAddress</td>
                    <td>
                        <span class="desk-pill @(isBlock ? "pill-bad" : "pill-ok")">@r.Kind</span>
                        <div class="text-[10px] text-muted-foreground mt-1">
                            @r.Source@(isBlock && r.OffenseCount > 1 ? $" · offense #{r.OffenseCount}" : "")
                        </div>
                    </td>
                    <td class="max-w-[26rem]">
                        <div class="text-xs break-words">@r.Reason</div>
                        @if (!string.IsNullOrEmpty(r.LastPath))
                        {
                            <div class="text-[11px] font-mono text-muted-foreground break-all mt-0.5">@r.LastPath</div>
                        }
                    </td>
                    <td class="text-right font-semibold">@r.HitCount.ToString("N0")</td>
                    <td class="text-xs text-muted-foreground whitespace-nowrap" title="@Dates.DateTimeSeconds(r.CreatedAt)">@Ago(r.CreatedAt)</td>
                    <td class="text-xs whitespace-nowrap @(r.IsPermanent ? "tone-bad font-medium" : "text-muted-foreground")"
                        title="@(r.ExpiresAt is null ? "never" : Dates.DateTimeSeconds(r.ExpiresAt))">@Until(r.ExpiresAt)</td>
                    <td class="text-right">
                        <form method="post" action="/admin/security/remove/@r.Id?kind=@filterKind&q=@filterQuery&page=@(page)" class="inline"
                              data-confirm-title="@(isBlock ? "Unblock this address?" : "Remove from the allowlist?")" data-confirm-body="@(isBlock ? $"{r.IpAddress} can reach the site again immediately. It is blocked again automatically if it keeps probing." : $"{r.IpAddress} loses its never-block protection and becomes subject to automatic blocking like any other address.")" data-confirm-action="@(isBlock ? "Unblock" : "Remove entry")" data-confirm-tone="warning">
                            @Html.AntiForgeryToken()
                            <button type="submit" aria-label="@(isBlock ? "Unblock" : "Remove") @r.IpAddress" class="desk-btn desk-btn-sm desk-btn-outline">
                                @(isBlock ? "Unblock" : "Remove")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
    }
</div>

<partial name="_ListPager" />

@* ── Settings ──────────────────────────────────────────────────── *@
<details class="mt-6 desk-card" open="@(!settings.FirewallEnabled)">
    <summary class="px-5 py-4 cursor-pointer desk-card-title">Firewall settings</summary>
    <form method="post" action="/admin/security/settings" class="px-5 pb-5 border-t border-border pt-4">
        @Html.AntiForgeryToken()
        <div class="grid md:grid-cols-3 gap-4">
            <label class="flex items-start gap-2 text-sm md:col-span-3">
                <input type="checkbox" name="firewallEnabled" value="true" checked="@settings.FirewallEnabled" class="desk-checkbox mt-0.5" />
                <span>
                    <strong>Enable automatic IP blocking</strong>
                    <span class="block text-muted-foreground">When off, nothing is blocked and no scores are recorded. Existing rules are kept.</span>
                </span>
            </label>

            <label class="desk-label">
                Block at score
                <input type="number" name="thresholdScore" min="3" max="1000" value="@settings.FirewallThresholdScore"
                       class="desk-input desk-input-sm mt-1" />
                <span class="desk-hint font-normal">Exploit probe = 5, failed sign-in = 3, 404 = 1.</span>
            </label>

            <label class="desk-label">
                Scoring window (minutes)
                <input type="number" name="windowMinutes" min="1" max="1440" value="@settings.FirewallWindowMinutes"
                       class="desk-input desk-input-sm mt-1" />
                <span class="desk-hint font-normal">Scores reset after a quiet window.</span>
            </label>

            <label class="desk-label">
                First block lasts (hours)
                <input type="number" name="blockHours" min="1" max="8760" value="@settings.FirewallBlockHours"
                       class="desk-input desk-input-sm mt-1" />
                <span class="desk-hint font-normal">Escalation extends repeat offenders.</span>
            </label>

            <label class="flex items-start gap-2 text-sm">
                <input type="checkbox" name="escalate" value="true" checked="@settings.FirewallEscalateRepeatOffenders" class="desk-checkbox mt-0.5" />
                <span>
                    <strong>Escalate repeat offenders</strong>
                    <span class="block text-muted-foreground">Second block lasts a week; a third is permanent.</span>
                </span>
            </label>

            <label class="flex items-start gap-2 text-sm">
                <input type="checkbox" name="protectCrawlers" value="true" checked="@settings.FirewallProtectSearchCrawlers" class="desk-checkbox mt-0.5" />
                <span>
                    <strong>Protect search &amp; AI crawlers</strong>
                    <span class="block text-muted-foreground">Googlebot and friends are never blocked for 404s. Exploit probes still count.</span>
                </span>
            </label>

            <label class="flex items-start gap-2 text-sm">
                <input type="checkbox" name="notifyOnBlock" value="true" checked="@settings.FirewallNotifyOnBlock" class="desk-checkbox mt-0.5" />
                <span>
                    <strong>Email on automatic block</strong>
                    <span class="block text-muted-foreground">Uses the error-notification recipients from General settings.</span>
                </span>
            </label>

            <label class="flex items-start gap-2 text-sm md:col-span-3">
                <input type="checkbox" name="trustProxyHeaders" value="true" checked="@settings.FirewallTrustProxyHeaders" class="desk-checkbox mt-0.5" />
                <span>
                    <strong>Trust proxy headers (CF-Connecting-IP / X-Forwarded-For)</strong>
                    <span class="block text-muted-foreground">
                        Enable only when the site sits behind Cloudflare or another trusted proxy — otherwise a client can forge its address.
                    </span>
                </span>
            </label>

            <label class="desk-label md:col-span-3">
                Never-block list
                <textarea name="allowlist" rows="3" placeholder="203.0.113.7&#10;198.51.100.0/24"
                          class="desk-textarea mt-1 font-mono text-xs">@settings.FirewallIpAllowlist</textarea>
                <span class="desk-hint font-normal">
                    One address or CIDR range per line. Loopback and private ranges are always included.
                </span>
            </label>
        </div>

        <div class="mt-4">
            <button type="submit" class="desk-btn desk-btn-primary">Save settings</button>
        </div>
    </form>
</details>
