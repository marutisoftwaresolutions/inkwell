@using Blog.Core.Interfaces
@model PagedResult<Blog.Core.Domain.Post>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Posts";
    var status = ViewBag.Status as string;
    var search = ViewBag.Search as string;
    var page = ViewData[Blog.Web.Models.ListPaging.PageKey] as int? ?? 1;
    var total = ViewData[Blog.Web.Models.ListPaging.TotalKey] as int? ?? Model.TotalItems;
    ViewData["Description"] = total == 1 ? "1 post" : $"{total:N0} posts" + (string.IsNullOrEmpty(status) ? "" : $" · {status}");
    var statuses = new (string Value, string Label)[] { ("", "All statuses"), ("published", "Published"), ("draft", "Draft"), ("scheduled", "Scheduled"), ("review", "In review"), ("changes", "Needs changes") };
    string Keep(string? q, string? s) {
        var parts = new List<string>();
        if (!string.IsNullOrEmpty(q)) parts.Add("q=" + Uri.EscapeDataString(q));
        if (!string.IsNullOrEmpty(s)) parts.Add("status=" + Uri.EscapeDataString(s));
        return parts.Count == 0 ? "" : "?" + string.Join("&", parts);
    }
}

@section PageActions {
    <a href="/admin/posts/create" class="desk-btn desk-btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        New post
    </a>
}

<div class="space-y-4">
    @* Search and filter live in the query string, so the view survives a redirect after delete/bulk (UI/UX rule 10). *@
    <form method="get" class="flex flex-col sm:flex-row sm:items-center gap-2" role="search">
        <div class="relative flex-1 sm:max-w-xs">
            <input type="search" name="q" value="@search" placeholder="Search posts…" aria-label="Search posts" class="desk-input pl-9" />
            <svg class="absolute left-3 top-2.5 h-4 w-4 text-muted-foreground pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </div>
        <select name="status" aria-label="Filter by status" class="desk-select sm:w-44">
            @foreach (var (value, label) in statuses)
            {
                <!option value="@value" @(status == value || (string.IsNullOrEmpty(status) && value == "") ? "selected" : "")>@label</!option>
            }
        </select>
        <button type="submit" class="desk-btn desk-btn-outline">Filter</button>
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(status))
        {
            <a href="/admin/posts" class="desk-btn desk-btn-ghost">Clear</a>
        }
    </form>

    @if (!Model.Items.Any())
    {
        <div class="desk-card">
            @if (!string.IsNullOrWhiteSpace(search))
            {
                ViewData["EmptyQuery"] = search;
                ViewData["EmptyClearHref"] = "/admin/posts" + Keep(null, status);
                ViewData["EmptyHint"] = string.IsNullOrEmpty(status) ? $"to see all {total:N0} posts." : "to see every post with this status.";
            }
            else if (status == "review")
            {
                ViewData["EmptyTitle"] = "Nothing is waiting for review";
                ViewData["EmptyHint"] = "Posts submitted by authors appear here until an editor publishes them or sends them back.";
                ViewData["EmptyHref"] = "/admin/posts"; ViewData["EmptyAction"] = "Show all posts";
            }
            else if (status == "changes")
            {
                ViewData["EmptyTitle"] = "No posts are waiting on changes";
                ViewData["EmptyHref"] = "/admin/posts"; ViewData["EmptyAction"] = "Show all posts";
            }
            else if (!string.IsNullOrEmpty(status))
            {
                ViewData["EmptyTitle"] = "No posts with this status";
                ViewData["EmptyHref"] = "/admin/posts"; ViewData["EmptyAction"] = "Show all posts";
            }
            else
            {
                ViewData["EmptyTitle"] = "No posts yet";
                ViewData["EmptyHint"] = "Your first post is a click away. Drafts stay private until you publish.";
                ViewData["EmptyHref"] = "/admin/posts/create"; ViewData["EmptyAction"] = "Write your first post";
                ViewData["EmptyIcon"] = "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"12\" y1=\"18\" x2=\"12\" y2=\"12\"/><line x1=\"9\" y1=\"15\" x2=\"15\" y2=\"15\"/>";
            }
            <partial name="_EmptyState" />
        </div>
    }
    else
    {
        @* Bulk actions: the row checkboxes belong to this form via form="bulkForm"; the toolbar shows once any is ticked. *@
        <form id="bulkForm" method="post" action="/admin/posts/bulk" class="hidden items-center flex-wrap gap-2 p-3 desk-card text-sm" aria-live="polite">
            @Html.AntiForgeryToken()
            <input type="hidden" name="q" value="@search" />
            <input type="hidden" name="status" value="@status" />
            <input type="hidden" name="page" value="@(page)" />
            <span id="bulkCount" class="font-medium">0 selected</span>
            <select name="action" id="bulkAction" class="desk-select desk-select-sm w-auto" aria-label="Bulk action">
                <option value="publish">Publish</option>
                <option value="draft">Move to draft</option>
                <option value="tag">Add tag…</option>
                <option value="delete">Delete</option>
            </select>
            <input type="text" name="tag" id="bulkTag" placeholder="Tag name" class="desk-input desk-input-sm w-40 hidden" aria-label="Tag to add" />
            <button type="submit" class="desk-btn desk-btn-primary desk-btn-sm">Apply</button>
            <button type="button" id="bulkClear" class="desk-btn desk-btn-ghost desk-btn-sm">Clear</button>
        </form>

        <div class="desk-card overflow-hidden">
            <div class="table-scroll"><table class="desk-table">
                <thead>
                    <tr>
                        <th class="w-8 !pr-0"><input type="checkbox" id="bulkAll" aria-label="Select all posts on this page" class="desk-checkbox" /></th>
                        <th>Title</th>
                        <th>Status</th>
                        <th class="hidden md:table-cell">Author</th>
                        <th class="text-right hidden sm:table-cell">Views</th>
                        <th class="text-right hidden sm:table-cell">Comments</th>
                        <th class="hidden lg:table-cell">Date</th>
                        <th class="text-right"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var post in Model.Items)
                    {
                        var canEdit = post.AuthorId == ViewBag.CurrentUserId || ViewBag.IsAdmin || ViewBag.IsEditor;
                        var isLive = post.Status == Blog.Core.Domain.PostStatus.Published || (post.Status == Blog.Core.Domain.PostStatus.Scheduled && post.ScheduledAt <= DateTime.UtcNow);
                        var displayStatus = post.Status;
                        if (isLive) { displayStatus = Blog.Core.Domain.PostStatus.Published; }
                        <tr>
                            <td class="w-8 !pr-0"><input type="checkbox" name="ids" value="@post.Id" form="bulkForm" class="bulk-row desk-checkbox" aria-label="Select “@post.Title”" /></td>
                            <td>
                                <div class="flex items-center gap-3 min-w-[14rem]">
                                    @if (!string.IsNullOrEmpty(post.FeatureImage))
                                    {
                                        <img src="@post.FeatureImage" alt="" width="40" height="40" class="w-10 h-10 object-cover rounded-md border border-border shrink-0" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="w-10 h-10 bg-muted rounded-md border border-border flex items-center justify-center text-muted-foreground shrink-0" aria-hidden="true">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        </div>
                                    }
                                    <div class="min-w-0">
                                        @if (canEdit)
                                        {
                                            <a href="/admin/posts/edit/@post.Id" class="font-medium text-foreground hover:underline underline-offset-4 block truncate">@post.Title</a>
                                        }
                                        else
                                        {
                                            <span class="font-medium text-foreground block truncate">@post.Title</span>
                                        }
                                        <div class="text-xs text-muted-foreground mt-0.5 truncate">/@post.Slug</div>
                                        @if (post.Status == Blog.Core.Domain.PostStatus.NeedsChanges && !string.IsNullOrWhiteSpace(post.ReviewNote)
                                             && ((bool?)ViewBag.CanPublish == true || post.AuthorId == (Guid)ViewBag.CurrentUserId))
                                        {
                                            <div class="text-xs tone-warn mt-0.5 line-clamp-1">Editor's note: @post.ReviewNote</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                @* Dark-safe tinted pills (admin.css); fixed palette classes did not follow the colour scheme. *@
                                <span class="desk-pill @(displayStatus == Blog.Core.Domain.PostStatus.Published ? "pill-ok" :
                                      displayStatus == Blog.Core.Domain.PostStatus.Draft ? "pill-warn" :
                                      displayStatus == Blog.Core.Domain.PostStatus.NeedsChanges ? "pill-bad" : "pill-info")">
                                    @(displayStatus switch
                                    {
                                        Blog.Core.Domain.PostStatus.InReview => "In review",
                                        Blog.Core.Domain.PostStatus.NeedsChanges => "Needs changes",
                                        _ => displayStatus.ToString(),
                                    })
                                </span>
                            </td>
                            <td class="text-muted-foreground hidden md:table-cell">
                                <div class="flex items-center gap-2">
                                    @{
                                        var pAuthorImg = !string.IsNullOrEmpty(post.AvatarUrl)
                                            ? post.AvatarUrl
                                            : $"/avatar/{System.Net.WebUtility.UrlEncode(string.IsNullOrEmpty(post.AuthorName) ? "A" : post.AuthorName)}";
                                    }
                                    <img src="@pAuthorImg" alt="" width="24" height="24" class="w-6 h-6 rounded-full object-cover bg-muted" loading="lazy" />
                                    <span class="truncate">@(string.IsNullOrEmpty(post.AuthorName) ? "Anonymous" : post.AuthorName)</span>
                                </div>
                            </td>
                            <td class="text-right tabular-nums hidden sm:table-cell">@post.ViewCount.ToString("N0")</td>
                            <td class="text-right tabular-nums hidden sm:table-cell @(post.CommentCount > 0 ? "" : "text-muted-foreground")">@post.CommentCount</td>
                            @{
                                // The date a reader of this list actually wants: when it goes live for a scheduled post,
                                // when it went live for a published one, otherwise when it was created.
                                var isScheduledAhead = post.Status == Blog.Core.Domain.PostStatus.Scheduled && post.ScheduledAt > DateTime.UtcNow;
                                var rowDate = isScheduledAhead ? post.ScheduledAt : (isLive ? (post.PublishedAt ?? post.ScheduledAt ?? post.CreatedAt) : post.CreatedAt);
                                var rowDateLabel = isScheduledAhead ? "Goes live " : "";
                            }
                            <td class="text-muted-foreground whitespace-nowrap hidden lg:table-cell"><span title="@Dates.DateTimeSeconds(rowDate)">@rowDateLabel@(isScheduledAhead ? Dates.DateTime(rowDate) : Dates.Medium(rowDate))</span></td>
                            <td>
                                <div class="desk-row-actions">
                                    @if (canEdit)
                                    {
                                        <a href="/admin/posts/edit/@post.Id" class="desk-btn desk-btn-ghost desk-btn-icon desk-btn-sm" aria-label="Edit “@post.Title”" title="Edit">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                        </a>
                                    }
                                    @if (isLive)
                                    {
                                        <a href="/@post.Slug" target="_blank" rel="noopener" class="desk-btn desk-btn-ghost desk-btn-icon desk-btn-sm" aria-label="View “@post.Title” on the site (opens in a new tab)" title="View">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                                        </a>
                                    }
                                    @if (canEdit)
                                    {
                                        <form method="post" action="/admin/posts/delete/@post.Id" data-confirm-title="Delete this post?" data-confirm-body="“@post.Title” will be removed permanently and /@post.Slug will return 404. If the page has inbound links or search traffic, add a redirect under Growth → Redirects first." data-confirm-action="Delete post" data-confirm-tone="danger" class="inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="q" value="@search" />
                                            <input type="hidden" name="status" value="@status" />
                                            <input type="hidden" name="page" value="@(page)" />
                                            <button type="submit" class="desk-btn desk-btn-ghost desk-btn-icon desk-btn-sm hover:text-destructive" aria-label="Delete “@post.Title”" title="Delete">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </div>

        <partial name="_ListPager" />
    }
</div>

<script>
    // Bulk selection: toolbar appears when any row is ticked; the tag box appears for "Add tag";
    // Delete goes through the Desk dialog by setting the confirm attributes just before submit.
    (function () {
        var form = document.getElementById('bulkForm'), all = document.getElementById('bulkAll');
        if (!form || !all) return;
        var rows = function () { return Array.from(document.querySelectorAll('input.bulk-row')); };
        var count = document.getElementById('bulkCount'), action = document.getElementById('bulkAction'), tag = document.getElementById('bulkTag');
        function refresh() {
            var n = rows().filter(function (c) { return c.checked; }).length;
            count.textContent = n + ' selected';
            form.classList.toggle('hidden', n === 0);
            form.classList.toggle('flex', n > 0);
            all.indeterminate = n > 0 && n < rows().length;
            all.checked = n > 0 && n === rows().length;
            tag.classList.toggle('hidden', action.value !== 'tag');
            tag.required = action.value === 'tag';
            if (action.value === 'delete') {
                form.dataset.confirmTitle = 'Delete ' + n + ' post' + (n === 1 ? '' : 's') + '?';
                form.dataset.confirmBody = 'They are removed permanently and their URLs return 404. Add redirects first for any with inbound links or search traffic.';
                form.dataset.confirmAction = 'Delete ' + n + ' post' + (n === 1 ? '' : 's');
                form.dataset.confirmTone = 'danger';
                if (n >= 5) form.dataset.confirmTyped = 'DELETE'; else delete form.dataset.confirmTyped;
            } else {
                ['confirmTitle', 'confirmBody', 'confirmAction', 'confirmTone', 'confirmTyped'].forEach(function (k) { delete form.dataset[k]; });
            }
        }
        document.addEventListener('change', function (e) {
            if (e.target === all) { rows().forEach(function (c) { c.checked = all.checked; }); }
            if (e.target === all || e.target.classList.contains('bulk-row') || e.target === action) refresh();
        });
        document.getElementById('bulkClear').addEventListener('click', function () { rows().forEach(function (c) { c.checked = false; }); all.checked = false; refresh(); });
        refresh();
    })();
</script>
