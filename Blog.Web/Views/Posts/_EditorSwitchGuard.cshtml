@* Switching editors with unsaved work on the page (ADR-0022). On an existing post the switch is a separate
   save of the stored post, so unsaved edits would be lost: offer to save the draft first. On a new post the
   switch reloads an empty editor: say the text will not come along, and only then leave without the
   browser's own second prompt. Without unsaved work, the switch proceeds as usual. *@
<script>
document.addEventListener('click', function (e) {
    var trigger = e.target.closest && e.target.closest('[data-editor-switch]');
    if (!trigger || !window.InkwellDesk || !InkwellDesk.isDirty() || !window.InkwellDialog) return;
    e.preventDefault();
    e.stopPropagation();
    if (trigger.tagName === 'A') {
        InkwellDialog.confirm({
            title: 'Switch editors and lose this draft?',
            body: 'The title and text on this page are not carried over to the other editor. Save the draft first to keep them.',
            action: 'Discard and switch', cancel: 'Keep editing', tone: 'danger',
        }).then(function (ok) { if (ok) { InkwellDesk.markClean(); window.location.href = trigger.href; } });
        return;
    }
    InkwellDialog.confirm({
        title: 'Save your changes first?',
        body: 'Switching editors uses the post as it was last saved, so the changes on this page would be lost. Save the draft, then switch.',
        action: 'Save draft', cancel: 'Keep editing', tone: 'warning',
    }).then(function (ok) {
        if (!ok) return;
        var save = document.querySelector('#postForm button[value="draft"]');
        if (save) save.click();
    });
}, true);
</script>
