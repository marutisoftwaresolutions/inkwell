<script>
    // Phone-width settings sheet: hidden until asked for, then covers the canvas. Desktop keeps the fixed column.
    window.toggleSettingsPanel = function (open) {
        var panel = document.getElementById('settingsPanel'), toggle = document.getElementById('settingsToggle');
        var show = typeof open === 'boolean' ? open : panel.classList.contains('hidden');
        panel.classList.toggle('hidden', !show);
        panel.classList.toggle('flex', show);
        if (toggle) toggle.setAttribute('aria-expanded', show ? 'true' : 'false');
        if (show) { var close = panel.querySelector('[data-settings-close]'); if (close) close.focus(); }
        else if (toggle) toggle.focus();
    };
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape' || !window.matchMedia('(max-width: 767.98px)').matches) return;
        var panel = document.getElementById('settingsPanel');
        if (panel && !panel.classList.contains('hidden')) toggleSettingsPanel(false);
    });
    // Sidebar sections remember whether they were open, per section, in this browser only.
    (function () {
        document.querySelectorAll('details[data-desk-section]').forEach(function (d) {
            var key = 'desk.section.' + d.dataset.deskSection;
            try { var saved = localStorage.getItem(key); if (saved === '1') d.open = true; else if (saved === '0') d.open = false; } catch (e) { /* storage unavailable: keep the default */ }
            d.addEventListener('toggle', function () { try { localStorage.setItem(key, d.open ? '1' : '0'); } catch (e) { /* nothing to remember with */ } });
        });
    })();
</script>

<link rel="stylesheet" href="~/css/inkwell-builder.css" asp-append-version="true" />

@section Scripts {
    <partial name="_EditorSwitchGuard" />
    @if (Model.IsMarkdown)
    {
        <partial name="_MarkdownEditorScripts" />
    }
    <script>
        window.categoriesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Categories ?? new List<Blog.Core.Domain.Category>()));
        window.selectedCategoryIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.SelectedCategoryIds ?? new List<Guid>()));
        window.tagsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Tags ?? new List<Blog.Core.Domain.Tag>()));
        window.selectedTagNames = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(((string)ViewBag.SelectedTagNames ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()).ToList()));
        function faqManager() {
            return {
                faqs: JSON.parse(document.getElementById('faqJsonInput').value || '[]'),
                init() { this.serialize(); },
                add() { this.faqs.push({ question: '', answer: '' }); this.serialize(); },
                remove(i) { this.faqs.splice(i, 1); this.serialize(); },
                serialize() {
                    document.getElementById('faqJsonInput').value =
                        JSON.stringify(this.faqs.filter(f => f.question || f.answer));
                }
            };
        }

        function keyFactsManager() {
            return {
                facts: JSON.parse(document.getElementById('keyFactsJsonInput').value || '[]'),
                init() { this.serialize(); },
                add() { this.facts.push({ label: '', value: '' }); this.serialize(); },
                remove(i) { this.facts.splice(i, 1); this.serialize(); },
                serialize() {
                    document.getElementById('keyFactsJsonInput').value =
                        JSON.stringify(this.facts.filter(f => f.label || f.value));
                }
            };
        }

        function howToManager() {
            return {
                steps: JSON.parse(document.getElementById('howToJsonInput').value || '[]'),
                init() { this.serialize(); },
                add() { this.steps.push({ name: '', text: '' }); this.serialize(); },
                remove(i) { this.steps.splice(i, 1); this.serialize(); },
                serialize() {
                    document.getElementById('howToJsonInput').value =
                        JSON.stringify(this.steps.filter(s => s.name || s.text));
                }
            };
        }
        function categoryDropdown() {
            return { open:false, search:'', items:window.categoriesData, selected:window.selectedCategoryIds,
                get filteredItems(){return this.items.filter(i=>i.Name.toLowerCase().includes(this.search.toLowerCase()))},
                toggle(id){if(this.selected.includes(id))this.selected=this.selected.filter(x=>x!==id);else this.selected.push(id);}
            }
        }
        function tagDropdown() {
            return { open:false, search:'', items:window.tagsData, selected:window.selectedTagNames,
                get filteredItems(){return this.items.filter(i=>i.Name.toLowerCase().includes(this.search.toLowerCase()))},
                toggle(n){if(this.selected.includes(n))this.selected=this.selected.filter(x=>x!==n);else this.selected.push(n);},
                addTag(){const v=this.search.trim();if(v&&!this.selected.includes(v)){this.selected.push(v);this.search='';}}
            }
        }
    </script>
    <script src="~/js/inkwell-builder.js" asp-append-version="true"></script>
    <script>
        (function(){
            // The block builder is shared with the page editor (wwwroot/js/inkwell-builder.js); this view adds the
            // post's slug, schedule-aware publish button, plain-text copy and pending social-image uploads.
            const builder = InkwellBuilder.init({
                canvas: 'canvas', canvasEmpty: 'canvasEmpty', canvasScroll: 'canvasScroll',
                settingsView: 'postSettingsView', componentView: 'componentSettingsView',
                componentTitle: 'compSettingsTitle', componentBody: 'compSettingsBody',
                content: 'postContent', hydrate: true
            });
            function fill(){document.getElementById('postContent').value=builder.extract();document.getElementById('postPlaintext').value=builder.extractText();}

            // Slug
            document.getElementById('postTitle').addEventListener('input',function(){const s=document.querySelector('input[name="Slug"]');if(s&&!s.dataset.manual)s.value=this.value.toLowerCase().replace(/[^a-z0-9\s-]/g,'').replace(/[\s_]+/g,'-').replace(/-+/g,'-').replace(/^-+|-+$/g,'');});
            const slugEl=document.querySelector('input[name="Slug"]');if(slugEl)slugEl.addEventListener('input',function(){this.dataset.manual='true';this.value=this.value.toLowerCase().replace(/[^a-z0-9\s-]/g,'').replace(/[\s_]+/g,'-').replace(/-+/g,'-').replace(/^-+|-+$/g,'');});

            // Publish/Schedule
            // Publish / schedule / submit confirmation goes through the shared Desk dialog (focus trap, Escape, both schemes).
            var pBtn=document.getElementById('publishBtn'),sI=document.querySelector('input[name="ScheduledAt"]');
            var confirmCopy={title:@Json.Serialize(modalTitle),body:@Json.Serialize(modalDesc),action:@Json.Serialize(modalConfirm)};
            // Compare in the site's zone (data-now), never the browser's clock: the server decides "scheduled" the same way.
            function upb(){if(@(canPublish ? "true" : "false")&&sI&&sI.value&&sI.value>(sI.dataset.now||'')){pBtn.innerText='Update schedule';confirmCopy={title:'Ready to schedule?',body:'The post goes live at the scheduled time and stays hidden until then.',action:'Schedule post'};return;}pBtn.innerText=@Json.Serialize(publishLabel);confirmCopy={title:@Json.Serialize(modalTitle),body:@Json.Serialize(modalDesc),action:@Json.Serialize(modalConfirm)};}
            if(sI){sI.addEventListener('input',upb);upb();}
            pBtn.addEventListener('click',function(){InkwellDialog.confirm({title:confirmCopy.title,body:confirmCopy.body,action:confirmCopy.action,tone:'neutral'}).then(function(ok){if(ok)window.confirmPublish();});});
            window.confirmPublish=async function(){fill();pBtn.disabled=true;pBtn.innerText='@(canPublish ? "Publishing…" : "Submitting…")';await uploadPendingImages();var f=document.getElementById('postForm');var a=f.querySelector('input[name="submitAction"]');if(a)a.value='publish';else{a=document.createElement('input');a.type='hidden';a.name='submitAction';a.value='publish';f.appendChild(a);}InkwellDesk.submit(f);};
            document.querySelector('button[value="draft"]').addEventListener('click',async function(e){e.preventDefault();this.innerText='Saving...';this.disabled=true;fill();await uploadPendingImages();var f=document.getElementById('postForm');var a=f.querySelector('input[name="submitAction"]');if(a)a.value='draft';else{a=document.createElement('input');a.type='hidden';a.name='submitAction';a.value='draft';f.appendChild(a);}InkwellDesk.submit(f);});
        })();
        // OG/Twitter uploads
        window.previewImage=function(i,p){if(i.files&&i.files[0]){var img=document.getElementById(p);img.src=URL.createObjectURL(i.files[0]);img.classList.remove('hidden');}};
        async function directUploadAsync(file,folder){var fd=new FormData();fd.append('file',file);fd.append('folder',folder);var tk=document.querySelector('input[name="__RequestVerificationToken"]')?.value;if(tk)fd.append('__RequestVerificationToken',tk);try{const r=await fetch('/admin/media/upload',{method:'POST',body:fd});if(r.ok){const d=await r.json();return d.url;}}catch(e){console.error(e);}return null;}
        window.uploadPendingImages=async function(){var og=document.getElementById('OgImageUpload');if(og?.files?.[0]){var u=await directUploadAsync(og.files[0],'og');if(u)document.getElementById('OgImageInput').value=u;}var tw=document.getElementById('TwitterImageUpload');if(tw?.files?.[0]){var u=await directUploadAsync(tw.files[0],'twitter');if(u)document.getElementById('TwitterImageInput').value=u;}};
    </script>
}

