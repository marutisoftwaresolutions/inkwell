@model Blog.Core.Domain.Post
@* Editorial workflow panel above the post editor. A partial of its own because its forms are actions
   (approve, send back), not editors: they sit outside the tracked editor form and are not change-tracked.
   Tints use the Desk's dark-safe pill-* classes (admin.css): Tailwind opacity modifiers on theme colours do not
   generate CSS with the Desk's bare var() colours. *@
@{
    var canPublish = User.HasClaim("Permission", "posts.publish");
    var inReview = Model.Status == Blog.Core.Domain.PostStatus.InReview;
    var needsChanges = Model.Status == Blog.Core.Domain.PostStatus.NeedsChanges;
    // On the edit screen ScheduledAt is already in the site's display zone (PostsController.Edit), so "now" is too.
    var displayNow = Blog.Core.Services.TimeZoneHelper.ToDisplay(DateTime.UtcNow, ViewBag.DisplayTimeZone as string);
    var scheduled = Model.ScheduledAt is { } at && at > displayNow;
    var scheduledText = scheduled ? Dates.Wall(Model.ScheduledAt) : null;   // already in the site's zone
}
@if (needsChanges)
{
    <div class="mb-3 rounded-lg border pill-warn p-3 text-sm">
        <p class="font-medium">Changes requested</p>
        <p class="mt-1 whitespace-pre-line text-foreground">@Model.ReviewNote</p>
        <p class="mt-1 text-xs text-muted-foreground">
            @(canPublish
                ? "Waiting for the author to make these changes. You can still publish it yourself."
                : "Make the changes, then use Submit for review. Save Draft keeps your work and this note.")
        </p>
    </div>
}
@if (inReview && canPublish)
{
    <div class="mb-3 rounded-lg border pill-info p-3 text-sm flex flex-wrap items-start justify-between gap-3" x-data="{ sendBack: false, noteErr: false }">
        <div class="max-w-xl">
            <p class="font-medium">Waiting for review</p>
            <p class="mt-1 text-muted-foreground">
                Submitted by @(string.IsNullOrWhiteSpace(Model.AuthorName) ? "its author" : Model.AuthorName). Read it through, then approve it or send it back with a note.
                Approve publishes the saved version. Save Draft keeps it in review with your edits; Publish in the toolbar publishes with them.
            </p>
        </div>
        <div class="flex flex-wrap items-start gap-2">
            <form method="post" action="/admin/posts/@Model.Id/approve"
                  data-confirm-title="Approve and publish?"
                  data-confirm-body="@(scheduled ? $"“{Model.Title}” is scheduled to go live on {scheduledText}." : $"“{Model.Title}” goes live now.") Unsaved edits in the editor below are not included."
                  data-confirm-action="Approve and publish" data-confirm-tone="warning">
                @Html.AntiForgeryToken()
                <button type="submit" class="px-4 py-2 bg-primary text-primary-foreground rounded-md text-sm font-medium shadow-sm">Approve and publish</button>
            </form>
            <button type="button" x-ref="sendBackBtn" @@click="sendBack = !sendBack; $nextTick(() => sendBack && $refs.note.focus())"
                    aria-expanded="false" :aria-expanded="sendBack.toString()" aria-controls="review-send-back"
                    class="px-4 py-2 rounded-md text-sm border border-input bg-background hover:bg-muted">Request changes</button>
        </div>
        <form id="review-send-back" x-show="sendBack" method="post" action="/admin/posts/@Model.Id/request-changes" class="w-full space-y-2" style="display:none"
              @@keydown.escape.prevent="sendBack = false; $refs.sendBackBtn.focus()"
              @@submit="if (!$refs.note.value.trim()) { $event.preventDefault(); noteErr = true; $refs.note.focus(); }">
            @Html.AntiForgeryToken()
            <label for="review-note" class="block text-xs font-medium text-foreground">What should change?</label>
            <textarea id="review-note" x-ref="note" name="note" required maxlength="@Blog.Core.Services.EditorialWorkflow.MaxNoteLength" rows="4"
                      aria-describedby="review-note-error" :aria-invalid="noteErr ? 'true' : null" @@input="noteErr = false"
                      class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm text-foreground"
                      placeholder="For example: add the pricing source, and shorten the introduction."></textarea>
            <p id="review-note-error" x-show="noteErr" class="field-validation-error text-xs text-destructive" style="display:none">Say what needs to change, so the author knows what to fix.</p>
            <div class="flex flex-wrap gap-2">
                <button type="submit" class="px-3 py-2 rounded-md text-sm bg-primary text-primary-foreground">Send back to the author</button>
                <button type="button" @@click="sendBack = false; noteErr = false; $nextTick(() => $refs.sendBackBtn.focus())" class="px-3 py-2 rounded-md text-sm border border-input bg-background hover:bg-muted">Cancel</button>
            </div>
        </form>
    </div>
}
else if (inReview)
{
    <div class="mb-3 rounded-lg border pill-info p-3 text-sm">
        <p class="font-medium">Waiting for an editor's review</p>
        <p class="mt-1 text-xs text-muted-foreground">You can keep editing. Submit for review again to send your latest changes, or Save Draft to withdraw it from review.</p>
    </div>
}
