@model Blog.Core.Domain.NewsletterIssue
@using Blog.Core.Domain
@{
    ViewData["Title"] = Model.Subject;
    ViewData["Description"] = $"Queued by {Model.QueuedByName ?? "an Admin"} · {Dates.DateTime(Model.QueuedAt)}";
    Layout = "_AdminLayout";
    var deliveries = ViewBag.Deliveries as IReadOnlyList<NewsletterDelivery> ?? Array.Empty<NewsletterDelivery>();
    string Pill(string s) => s switch
    {
        NewsletterDeliveryStatus.Sent => "pill-ok",
        NewsletterDeliveryStatus.Failed => "pill-bad",
        NewsletterDeliveryStatus.Pending => "pill-info",
        _ => "pill-warn",
    };
}

@section PageActions {
    <a href="/admin/newsletter" class="desk-btn desk-btn-outline">Back to newsletters</a>
    @if (Model.IsActive)
    {
            <form method="post" action="/admin/newsletter/@Model.Id/cancel"
                  data-confirm-title="Stop sending?"
                  data-confirm-body="Subscribers who have not been sent a copy yet will not get one. Copies already sent cannot be recalled. The newsletter cannot be resumed."
                  data-confirm-action="Stop sending" data-confirm-tone="warning">
                @Html.AntiForgeryToken()
                <button type="submit" class="desk-btn desk-btn-danger-outline">Stop sending</button>
            </form>
    }
}

<div class="max-w-5xl space-y-6">

    <partial name="_Progress" model="Model" />

    <section aria-labelledby="log-title" class="space-y-2">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 id="log-title" class="desk-section-title">Send log <span class="text-xs font-normal text-muted-foreground">(failures first, up to 100)</span></h2>
            @if (Model.IsActive)
            {
                <a href="/admin/newsletter/@Model.Id" class="desk-btn desk-btn-link text-xs">Refresh the log</a>
            }
        </div>
        <div class="desk-card overflow-hidden"><div class="table-scroll"><table class="desk-table desk-table-compact">
                <thead>
                    <tr><th>Subscriber</th><th>Status</th><th>Tries</th><th>Sent</th><th>Problem</th></tr>
                </thead>
                <tbody>
                    @if (deliveries.Count == 0)
                    {
                        <tr><td colspan="5" class="py-6 text-center text-muted-foreground">No copies yet: the list of recipients is drawn up when sending starts.</td></tr>
                    }
                    @foreach (var d in deliveries)
                    {
                        <tr>
                            <td class="text-foreground">@d.Email</td>
                            <td><span class="desk-pill @Pill(d.Status)">@d.Status</span></td>
                            <td class="text-muted-foreground">@d.Attempts</td>
                            <td class="text-muted-foreground whitespace-nowrap">@Dates.DateTime(d.SentAt)</td>
                            <td class="text-xs text-muted-foreground">@d.Error</td>
                        </tr>
                    }
                </tbody>
            </table></div>
        </div>
    </section>

    <section aria-labelledby="preview-title" class="space-y-2">
        <h2 id="preview-title" class="desk-section-title">The email as sent</h2>
        <iframe src="/admin/newsletter/@Model.Id/preview" title="The email as sent" sandbox class="w-full h-[42rem] rounded-lg border border-border bg-white"></iframe>
    </section>
</div>
