@model IEnumerable<Blog.Core.Domain.NewsletterIssue>
@using Blog.Core.Domain
@{
    ViewData["Title"] = "Newsletter";
    Layout = "_AdminLayout";
    var subscribers = (int)(ViewBag.Subscribers ?? 0);
    var emailConfigured = (bool)(ViewBag.EmailConfigured ?? false);
    var q = ViewData[Blog.Web.Models.ListPaging.QueryKey] as string;
    ViewData["Description"] = $"Write an issue, preview it, send a test to yourself, then send it to your {subscribers} confirmed subscriber{(subscribers == 1 ? "" : "s")}.";
    ViewData["ListSearchPlaceholder"] = "Search by subject";
    string Pill(string status) => status switch
    {
        NewsletterStatus.Sent => "pill-ok",
        NewsletterStatus.Queued or NewsletterStatus.Sending => "pill-info",
        NewsletterStatus.Cancelled => "pill-warn",
        _ => "desk-pill-muted",
    };
}

@section PageActions {
    <a href="/admin/newsletter/new" class="desk-btn desk-btn-primary">New newsletter</a>
}

<div class="max-w-5xl space-y-6">
    @if (!emailConfigured)
    {
        <p class="rounded-lg border p-4 pill-warn text-sm" role="note">Outgoing email is not set up on this server, so newsletters can be written and previewed but not sent. Set the <code>Smtp</code> settings in <code>appsettings.json</code>.</p>
    }

    <partial name="_ListSearch" />
    <div class="desk-card overflow-hidden">
        @if (!Model.Any())
        {
            if (string.IsNullOrEmpty(q))
            {
                ViewData["EmptyTitle"] = "No newsletters yet.";
                ViewData["EmptyHint"] = "Write the first one with New newsletter.";
                ViewData["EmptyHref"] = "/admin/newsletter/new";
                ViewData["EmptyAction"] = "New newsletter";
            }
            else
            {
                ViewData["EmptyQuery"] = q;
                ViewData["EmptyClearHref"] = "?";
                ViewData["EmptyHint"] = "to see them all.";
            }
            <partial name="_EmptyState" />
        }
        else
        {
        <div class="table-scroll"><table class="desk-table">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Status</th>
                    <th>Recipients</th>
                    <th>Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <td><a href="/admin/newsletter/@i.Id" class="font-medium text-foreground hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded">@i.Subject</a></td>
                        <td><span class="desk-pill @Pill(i.Status)">@i.Status</span></td>
                        <td class="text-muted-foreground whitespace-nowrap">
                            @if (i.IsDraft) { <span>—</span> }
                            else if (i.IsActive) { <span>Sending… open it to follow progress</span> }
                            else { <span>@i.SentCount of @i.RecipientCount sent@(i.FailedCount > 0 ? $", {i.FailedCount} failed" : "")</span> }
                        </td>
                        <td class="text-muted-foreground whitespace-nowrap">@Dates.DateTime(i.FinishedAt ?? i.QueuedAt ?? i.UpdatedAt)</td>
                    </tr>
                }
            </tbody>
        </table></div>
        }
    </div>
    <partial name="_ListPager" />
</div>
