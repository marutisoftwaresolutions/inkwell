@model Blog.Web.Controllers.BackupsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Backups";
    ViewData["Description"] = "A backup is one ZIP file holding the whole site: posts, pages, taxonomy, users, settings, menus, subscribers, comments, the audit trail and every uploaded file. Restore it into a fresh install from the setup wizard to move the site to a new server or recover it.";
    // Retention deletes the oldest backup when this one lands; say so before it happens.
    var displaced = Model.Files.Count >= Model.Keep ? Model.Files[^1] : null;
}

<div class="flex flex-col gap-6">
    <form method="post" action="/admin/backups/create" class="desk-card max-w-2xl"
          data-confirm-title="@(displaced is null ? null : "Make a backup?")"
          data-confirm-body="@(displaced is null ? null : $"The oldest backup ({displaced.Name}, {displaced.CreatedAtUtc:d MMM yyyy}) is deleted to make room, because the newest {Model.Keep} are kept. Download it first if you need it.")"
          data-confirm-action="@(displaced is null ? null : "Make backup")"
          data-confirm-tone="@(displaced is null ? null : "warning")">
        @Html.AntiForgeryToken()
        <div class="desk-card-header">
            <h2 class="desk-card-title">Make a backup</h2>
        </div>
        <div class="desk-card-body flex flex-col gap-3">
        <label class="flex items-start gap-2 text-sm text-foreground">
            <input type="checkbox" name="includeAnalytics" value="true" class="desk-checkbox mt-1" />
            <span>
                Include page-view analytics
                <span class="block text-xs text-muted-foreground">Can be millions of rows and make the backup much larger and slower. The site works without them.</span>
            </span>
        </label>
        <div class="flex flex-wrap items-center gap-3">
            <button type="submit" id="make-backup" class="desk-btn desk-btn-primary"
                    disabled="@(Model.InProgress ? "disabled" : null)" aria-describedby="make-backup-hint">Make backup</button>
            <span id="make-backup-hint" class="text-xs text-muted-foreground">@(Model.InProgress ? "A backup is already on its way." : "Runs in the background; the list below updates when it is done.")</span>
        </div>
        </div>
    </form>

    <div id="backup-list">
        <partial name="_BackupList" model="Model" />
    </div>
    <div class="desk-card max-w-3xl">
        <div class="desk-card-header">
            <h2 class="desk-card-title">Keep backups safe</h2>
        </div>
        <div class="desk-card-body text-xs text-muted-foreground space-y-2">
        <p>A backup contains every account's password hash and every subscriber's email address. Store it the way you would store a password:
           somewhere private, never in a public folder or a shared link.</p>
        <p>What is <strong class="text-foreground">not</strong> in a backup: the encryption key ring (so the Search Console connection and webhook signing
           secrets must be entered again after a restore), crawler and error logs, search-performance data (fetched again from Search Console),
           the webhook delivery log, import staging and password-reset links.</p>
        <p>The newest @Model.Keep backups are kept; older ones are deleted when a new one is made. Backups are stored on the server outside the
           web root, so download the ones you want to keep elsewhere.</p>
        <p><strong class="text-foreground">To restore:</strong> install Inkwell on an empty database, copy the ZIP into the new server's backups folder
           (<code>App_Data/backups</code> unless <code>Backups:Path</code> is set), open the site and choose <em>Restore from a backup</em> on the first
           setup screen.</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // When the polled list reports the backup done, the button comes back without a reload.
    document.addEventListener('htmx:afterSwap', function (e) {
        if (!e.detail || !e.detail.target || e.detail.target.id !== 'backup-list') return;
        if (e.detail.target.querySelector('[data-backup-pending]')) return;
        var btn = document.getElementById('make-backup');
        var hint = document.getElementById('make-backup-hint');
        if (btn) btn.disabled = false;
        if (hint) hint.textContent = 'Runs in the background; the list below updates when it is done.';
    });
})();
</script>
}
