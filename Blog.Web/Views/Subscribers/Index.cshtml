@model List<Blog.Core.Domain.Member>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Subscribers";

    var currentStatus = ViewBag.Status as string;
    var total = (int)ViewBag.Total;
    var page = (int)ViewBag.Page;
    var confirmedCount = (int)ViewBag.ConfirmedCount;
    ViewData["Description"] = $"{confirmedCount} confirmed subscriber{(confirmedCount == 1 ? "" : "s")}";

    string? TabCurrent(string? s) => currentStatus == s ? "page" : null;

    string StatusBadge(string status) => status switch
    {
        "confirmed"    => "pill-ok",
        "pending"      => "pill-warn",
        _              => "desk-pill-muted"
    };
}

<nav class="desk-tabs mb-5" aria-label="Filter by status">
    <a href="/admin/subscribers" class="desk-tab" aria-current="@TabCurrent(null)">All (@total)</a>
    <a href="/admin/subscribers?status=confirmed" class="desk-tab" aria-current="@TabCurrent("confirmed")">Confirmed</a>
    <a href="/admin/subscribers?status=pending" class="desk-tab" aria-current="@TabCurrent("pending")">Pending</a>
    <a href="/admin/subscribers?status=unsubscribed" class="desk-tab" aria-current="@TabCurrent("unsubscribed")">Unsubscribed</a>
</nav>

<div class="desk-card overflow-hidden">
    @if (!Model.Any())
    {
        ViewData["EmptyTitle"] = string.IsNullOrEmpty(currentStatus) ? "No subscribers yet" : $"No {currentStatus} subscribers";
        ViewData["EmptyHint"] = string.IsNullOrEmpty(currentStatus)
            ? "Readers who subscribe from the site appear here."
            : "Choose All to see every subscriber.";
        <partial name="_EmptyState" />
    }
    else
    {
        <div class="table-scroll"><table class="desk-table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th class="hidden sm:table-cell">Name</th>
                    <th>Status</th>
                    <th class="hidden md:table-cell">Joined</th>
                    <th class="hidden md:table-cell">Confirmed</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td class="font-medium">@m.Email</td>
                        <td class="text-muted-foreground hidden sm:table-cell">@(m.Name ?? "—")</td>
                        <td>
                            <span class="desk-pill @StatusBadge(m.Status)">
                                @m.Status
                            </span>
                        </td>
                        <td class="text-muted-foreground hidden md:table-cell text-xs">@Dates.Medium(m.CreatedAt)</td>
                        <td class="text-muted-foreground hidden md:table-cell text-xs">
                            @(m.ConfirmedAt.HasValue ? Dates.Medium(m.ConfirmedAt) : "—")
                        </td>
                        <td class="text-right">
                            <form method="post" action="/admin/subscribers/delete/@m.Id?status=@currentStatus&page=@(page)"
                                  data-confirm-title="Remove this subscriber?" data-confirm-body="@m.Email stops receiving newsletters and is removed from the list. They can subscribe again at any time." data-confirm-action="Remove subscriber" data-confirm-tone="danger">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="desk-btn desk-btn-sm desk-btn-danger-outline" aria-label="Remove @m.Email">
                                    Remove
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</div>

<partial name="_ListPager" />
