@model Blog.Core.Domain.ImportJob
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Import summary";
    ViewData["Description"] = $"{Model.Source}: {Model.FileName}. Import {(Model.Status == Blog.Core.Domain.ImportJobStatus.Completed ? "complete" : Model.Status.ToString().ToLowerInvariant())}.";
    var failed = ViewBag.Failed as List<Blog.Core.Domain.ImportItem> ?? new();
}

@section PageActions {
    <a href="/admin/import" class="desk-btn desk-btn-outline">Back to imports</a>
}

<div class="flex flex-col gap-6 max-w-3xl">
    <div class="grid grid-cols-4 gap-3 text-center">
        <div class="desk-card p-3"><div class="text-2xl font-semibold">@Model.ImportedItems</div><div class="text-xs text-muted-foreground">Imported</div></div>
        <div class="desk-card p-3"><div class="text-2xl font-semibold text-destructive">@Model.FailedItems</div><div class="text-xs text-muted-foreground">Failed</div></div>
        <div class="desk-card p-3"><div class="text-2xl font-semibold text-muted-foreground">@Model.SkippedItems</div><div class="text-xs text-muted-foreground">Skipped</div></div>
        <div class="desk-card p-3"><div class="text-2xl font-semibold">@Model.TotalItems</div><div class="text-xs text-muted-foreground">Total</div></div>
    </div>

    <div class="flex items-center gap-3 flex-wrap">
        <a href="/admin/posts" class="desk-btn desk-btn-primary">View imported posts</a>
        <a href="/admin/import/report/@Model.Id" class="desk-btn desk-btn-outline">Download report (.xlsx)</a>
        @if (Model.Status == Blog.Core.Domain.ImportJobStatus.Completed && Model.ImportedItems > 0
             && !string.Equals(Model.Options.SlugConflict, "Overwrite", StringComparison.OrdinalIgnoreCase))
        {
            <form method="post" action="/admin/import/undo/@Model.Id" data-confirm-title="Undo this import?" data-confirm-body="Removes the @Model.ImportedItems item(s) this import created — posts, pages, images and comments. Categories and tags are kept. This cannot be reversed." data-confirm-action="Undo import" data-confirm-tone="danger" data-confirm-typed="UNDO">
                @Html.AntiForgeryToken()
                <button type="submit" class="desk-btn desk-btn-danger-outline">Undo import</button>
            </form>
        }
    </div>

    @if (failed.Any())
    {
        <div class="desk-card p-4">
            <h2 class="desk-card-title mb-3">Failed items (@failed.Count)</h2>
            <div class="table-scroll"><table class="desk-table desk-table-compact">
                <thead><tr><th>Type</th><th>Title</th><th>Problem</th></tr></thead>
                <tbody>
                    @foreach (var f in failed)
                    {
                        <tr><td>@f.ItemType</td><td>@f.Title</td><td class="text-xs text-destructive font-mono">@f.Error</td></tr>
                    }
                </tbody>
            </table></div>
        </div>
    }
</div>
