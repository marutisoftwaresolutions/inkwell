@using Blog.Core.Domain
@using Blog.Core.Services
@model ImportJob
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Preview import";
    ViewData["Description"] = $"What would happen if this import ran ({Model.Source}, {Model.FileName}). Nothing has been written: this is a prediction from the staged file and your current options, not a trial run. Images are counted, not downloaded.";
    var p = (ImportPreview)ViewBag.Preview;

    string Badge(ImportOutcome o) => o switch
    {
        ImportOutcome.Overwrite        => "pill-bad",
        ImportOutcome.CreateWithNewSlug=> "pill-warn",
        ImportOutcome.Skip             => "desk-pill-muted",
        _                              => "pill-ok"
    };
    string Label(ImportOutcome o) => o switch
    {
        ImportOutcome.CreateWithNewSlug => "new slug",
        ImportOutcome.Overwrite         => "overwrite",
        ImportOutcome.Skip              => "skip",
        _                               => "create"
    };
}

@section PageActions {
    <a href="/admin/import/configure/@Model.Id" class="desk-btn desk-btn-outline">Change options</a>
}

<div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
    <div class="desk-card p-4">
        <div class="text-2xl font-bold tabular-nums tone-ok">@p.Creates</div>
        <div class="text-xs text-muted-foreground mt-1">Will be created</div>
    </div>
    <div class="desk-card p-4">
        <div class="text-2xl font-bold tabular-nums @(p.Renames > 0 ? "tone-warn" : "text-foreground")">@p.Renames</div>
        <div class="text-xs text-muted-foreground mt-1">Given a new slug</div>
    </div>
    <div class="desk-card p-4">
        <div class="text-2xl font-bold tabular-nums @(p.Overwrites > 0 ? "tone-bad" : "text-foreground")">@p.Overwrites</div>
        <div class="text-xs text-muted-foreground mt-1">Will overwrite</div>
    </div>
    <div class="desk-card p-4">
        <div class="text-2xl font-bold tabular-nums text-foreground">@p.Skips</div>
        <div class="text-xs text-muted-foreground mt-1">Skipped</div>
    </div>
    <div class="desk-card p-4">
        <div class="text-2xl font-bold tabular-nums text-foreground">@p.ImagesToFetch</div>
        <div class="text-xs text-muted-foreground mt-1">Images to fetch</div>
    </div>
</div>

@if (p.Overwrites > 0)
{
    <div class="mb-6 rounded-lg border p-4 pill-bad text-sm" role="alert">
        <strong>@p.Overwrites existing @(p.Overwrites == 1 ? "post or page" : "posts or pages") would be replaced.</strong>
        The current content is overwritten and is not recoverable from the import. Change the slug-conflict
        policy to <em>Suffix</em> or <em>Skip</em> on the previous step if that is not what you intend.
    </div>
}

@if (p.BrokenLinks.Count > 0)
{
    <div class="desk-card overflow-hidden mb-6">
        <div class="desk-card-header">
            <h2 class="desk-card-title">Links that would not resolve (@p.BrokenLinks.Count)</h2>
            <p class="desk-card-description">These point at content this import does not bring and that does not already exist here.</p>
        </div>
        <div class="table-scroll"><table class="desk-table desk-table-compact">
            <thead>
                <tr>
                    <th>In</th>
                    <th>Link</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var l in p.BrokenLinks.Take(100))
                {
                    <tr>
                        <td class="text-xs text-foreground max-w-[24rem]">@l.InPostTitle</td>
                        <td class="font-mono text-[11px] text-muted-foreground break-all">@l.Href</td>
                    </tr>
                }
            </tbody>
        </table></div>
    </div>
}

@foreach (var group in p.ByType)
{
    <div class="desk-card overflow-hidden mb-4">
        <div class="desk-card-header">
            <h2 class="desk-card-title">@group.Key (@group.Count())</h2>
        </div>
        <div class="table-scroll"><table class="desk-table desk-table-compact">
            <tbody>
                @foreach (var item in group.Take(200))
                {
                    <tr class="align-top">
                        <td class="w-24">
                            <span class="desk-pill @Badge(item.Outcome)">@Label(item.Outcome)</span>
                        </td>
                        <td class="max-w-[24rem]">
                            <div class="text-xs text-foreground">@item.Title</div>
                            @if (!string.IsNullOrEmpty(item.Slug))
                            {
                                <div class="text-[11px] font-mono text-muted-foreground">/@item.Slug</div>
                            }
                        </td>
                        <td class="text-xs text-muted-foreground">@item.Reason</td>
                    </tr>
                }
            </tbody>
        </table></div>
    </div>
}

@{
    // The confirmation names the counts the tiles show, so what the dialog promises is what the preview predicted.
    var runBody = $"Creates {p.Creates}, gives {p.Renames} a new slug, overwrites {p.Overwrites} and skips {p.Skips}. "
                + $"{p.ImagesToFetch} image{(p.ImagesToFetch == 1 ? "" : "s")} will be fetched from the old site while it runs.";
    if (p.Overwrites > 0)
        runBody += $" The {p.Overwrites} overwritten {(p.Overwrites == 1 ? "post or page" : "posts or pages")} cannot be recovered from the import.";
}
<div class="flex flex-wrap gap-3 mt-6">
    <a href="/admin/import/configure/@Model.Id" class="desk-btn desk-btn-outline">Change options</a>
    @if (p.Overwrites > 0)
    {
        <form method="post" action="/admin/import/run/@Model.Id"
              data-confirm-title="Run the import?" data-confirm-body="@runBody"
              data-confirm-action="Run import" data-confirm-tone="danger" data-confirm-typed="OVERWRITE">
            @Html.AntiForgeryToken()
            <button type="submit" class="desk-btn desk-btn-primary">Run the import</button>
        </form>
    }
    else
    {
        <form method="post" action="/admin/import/run/@Model.Id"
              data-confirm-title="Run the import?" data-confirm-body="@runBody"
              data-confirm-action="Run import" data-confirm-tone="neutral">
            @Html.AntiForgeryToken()
            <button type="submit" class="desk-btn desk-btn-primary">Run the import</button>
        </form>
    }
</div>
