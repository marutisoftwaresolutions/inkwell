@using Blog.Web.Models
@model SettingsViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
    ViewData["Description"] = "How your site presents itself, what readers can do, and how search engines and answer engines see it. Changes on every tab are saved together with the Save changes button at the bottom.";
    var inputCls = "desk-input";
    var selectCls = "desk-select";
    var labelCls = "desk-label";
    var helpCls = "desk-hint";
    var errCls = "desk-error text-destructive"; // text-destructive is also the selector the tab error-counter script uses
    var checkCls = "desk-checkbox mt-1";
}

<style>[x-cloak]{display:none!important}</style>

@*
    Settings is one form split into tabs. Every tab's fields post together, so switching tabs never
    loses anything; the sticky bar at the bottom keeps Save in view on every tab; a validation error
    on a hidden tab switches to that tab before the browser tries to focus the field.
*@
<div class="max-w-5xl mx-auto" x-data="settingsTabs()">
    <form asp-action="Update" method="post" data-track-changes x-ref="form" class="grid gap-6 md:grid-cols-[220px_minmax(0,1fr)] items-start">
        @Html.AntiForgeryToken()

        @* ── Tab list: horizontal on phones, a sticky column on wider screens ── *@
        <nav id="settings-tabs" role="tablist" aria-label="Settings sections"
             class="md:sticky md:top-4 flex md:flex-col gap-1 overflow-x-auto md:overflow-visible -mx-1 px-1 pb-1 md:pb-0 text-sm">
            <template x-for="t in tabs" :key="t.key">
                <a :href="'#s-' + t.key" role="tab" :id="'tab-' + t.key" :aria-selected="tab === t.key ? 'true' : 'false'" :aria-controls="'s-' + t.key" :tabindex="tab === t.key ? 0 : -1"
                   @@click.prevent="go(t.key)" @@keydown.arrow-down.prevent="next(1)" @@keydown.arrow-up.prevent="next(-1)" @@keydown.arrow-right.prevent="next(1)" @@keydown.arrow-left.prevent="next(-1)"
                   class="whitespace-nowrap rounded-md px-3 py-2 transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                   :class="tab === t.key ? 'bg-muted font-medium text-foreground' : 'text-muted-foreground'">
                    <span x-text="t.label"></span>
                    <span x-show="errors[t.key]" x-cloak class="ml-1 inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-destructive px-1 text-[10px] font-semibold text-destructive-foreground" :title="errors[t.key] + ' field(s) need attention'" x-text="errors[t.key]"></span>
                </a>
            </template>
            @* Server-rendered anchors so the section links exist without JavaScript (and for the source tests). *@
            <noscript>
                <a href="#s-general">General</a> <a href="#s-display">Display</a> <a href="#s-comments">Comments</a>
                <a href="#s-analytics">Search &amp; analytics</a> <a href="#s-housekeeping">Notifications &amp; housekeeping</a>
                <a href="#s-social">Social</a> <a href="#s-identity">Identity</a> <a href="#s-fields">Custom fields</a>
            </noscript>
        </nav>

        <div class="min-w-0">
            @if (TempData["Error"] != null)
            {
                <div class="p-3 mb-4 rounded-md bg-destructive/10 text-destructive text-xs font-medium">@TempData["Error"]</div>
            }
            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-destructive"></div>

            @* ────────────────────────────── General ────────────────────────────── *@
            <section id="s-general" role="tabpanel" aria-labelledby="tab-general" x-show="tab === 'general'" x-cloak data-tab="general"
                     class="desk-card p-6 space-y-6 scroll-mt-16">
                <header>
                    <h2 class="desk-card-title">General</h2>
                    <p class="@helpCls mt-1">The name and images that identify the site. They appear in the browser tab, the header and footer, feeds, social previews and structured data.</p>
                </header>

                <div class="grid gap-6 md:grid-cols-2">
                    <div class="space-y-2">
                        <label asp-for="SiteName" class="@labelCls"></label>
                        <input asp-for="SiteName" class="@inputCls" />
                        <p class="@helpCls">Shown in the header, the browser title after every page name, the RSS feed and the publisher name in structured data.</p>
                        <span asp-validation-for="SiteName" class="@errCls"></span>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="SiteTagline" class="@labelCls"></label>
                        <input asp-for="SiteTagline" class="@inputCls" placeholder="One sentence that says what this site is about" />
                        <p class="@helpCls">Used as the home page description for search results and shown under the site name in most layouts. Aim for 60 to 150 characters.</p>
                        <span asp-validation-for="SiteTagline" class="@errCls"></span>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="SiteLanguage" class="@labelCls"></label>
                        <input asp-for="SiteLanguage" placeholder="en" class="@inputCls" />
                        <p class="@helpCls">BCP-47 code (<code>en</code>, <code>es</code>, <code>hi</code>, <code>fr-CA</code>…). Sets the page <code>lang</code>, hreflang and schema language.</p>
                    </div>
                </div>

                <div class="grid gap-6 md:grid-cols-2 pt-2 border-t border-border">
                    <div class="space-y-2">
                        <label for="SiteLogoInput" class="@labelCls">@Html.DisplayNameFor(m => m.SiteLogoUrl)</label>
                        <div class="flex gap-2 mb-2 @(string.IsNullOrEmpty(Model.SiteLogoUrl) ? "hidden" : "")" id="SiteLogoPreviewWrapper">
                            <img id="SiteLogoPreview" src="@Model.SiteLogoUrl" alt="Site logo preview" class="w-full h-auto max-h-32 object-contain rounded border" />
                        </div>
                        <div class="flex gap-2">
                            <input asp-for="SiteLogoUrl" id="SiteLogoInput" class="@inputCls" placeholder="https://" />
                            <button type="button"
                                    onclick="window.dispatchEvent(new CustomEvent('open-media-selector', { detail: { targetInput: 'SiteLogoInput', previewImg: 'SiteLogoPreview', folder: 'images' } })); document.getElementById('SiteLogoPreviewWrapper').classList.remove('hidden');"
                                    class="desk-btn desk-btn-secondary shrink-0">Select</button>
                        </div>
                        <p class="@helpCls">Header logo. Pick from the media library or paste a URL; leave blank to show the site name as text. A transparent PNG or SVG about 400 × 100 px works best.</p>
                    </div>
                    <div class="space-y-2">
                        <label for="SiteFaviconInput" class="@labelCls">@Html.DisplayNameFor(m => m.SiteFaviconUrl)</label>
                        <div class="flex gap-2 mb-2 @(string.IsNullOrEmpty(Model.SiteFaviconUrl) ? "hidden" : "")" id="SiteFaviconPreviewWrapper">
                            <img id="SiteFaviconPreview" src="@Model.SiteFaviconUrl" alt="Favicon preview" class="w-16 h-16 object-contain rounded border" />
                        </div>
                        <div class="flex gap-2">
                            <input asp-for="SiteFaviconUrl" id="SiteFaviconInput" class="@inputCls" placeholder="https://" />
                            <button type="button"
                                    onclick="window.dispatchEvent(new CustomEvent('open-media-selector', { detail: { targetInput: 'SiteFaviconInput', previewImg: 'SiteFaviconPreview', folder: 'images' } })); document.getElementById('SiteFaviconPreviewWrapper').classList.remove('hidden');"
                                    class="desk-btn desk-btn-secondary shrink-0">Select</button>
                        </div>
                        <p class="@helpCls">The small icon in browser tabs and bookmarks. A square PNG or ICO, 32 × 32 px or larger.</p>
                    </div>
                </div>

                <div class="space-y-2">
                    <label for="SiteCoverInput" class="@labelCls">@Html.DisplayNameFor(m => m.SiteCoverUrl)</label>
                    <div class="flex gap-2 mb-2 @(string.IsNullOrEmpty(Model.SiteCoverUrl) ? "hidden" : "")" id="SiteCoverPreviewWrapper">
                        <img id="SiteCoverPreview" src="@Model.SiteCoverUrl" alt="Cover image preview" class="w-full h-32 object-cover rounded border" />
                    </div>
                    <div class="flex gap-2">
                        <input asp-for="SiteCoverUrl" id="SiteCoverInput" class="@inputCls" placeholder="https://" />
                        <button type="button"
                                onclick="window.dispatchEvent(new CustomEvent('open-media-selector', { detail: { targetInput: 'SiteCoverInput', previewImg: 'SiteCoverPreview', folder: 'images' } })); document.getElementById('SiteCoverPreviewWrapper').classList.remove('hidden');"
                                class="desk-btn desk-btn-secondary shrink-0">Select</button>
                    </div>
                    <p class="@helpCls">Wide hero/banner image at the top of the home page in layouts that show one (recommended 1500 × 500 px). Also the fallback social preview image for pages without their own.</p>
                </div>
            </section>

            @* ────────────────────────────── Display ────────────────────────────── *@
            <section id="s-display" role="tabpanel" aria-labelledby="tab-display" x-show="tab === 'display'" x-cloak data-tab="display"
                     class="desk-card p-6 space-y-6 scroll-mt-16">
                <header>
                    <h2 class="desk-card-title">Display</h2>
                    <p class="@helpCls mt-1">How lists, dates and times, and colours are shown. Layouts, presets and fonts live under <a href="/admin/theme" class="underline">Theme</a>.</p>
                </header>
                <div class="grid gap-6 md:grid-cols-2">
                    <div class="space-y-2">
                        <label asp-for="PostsPerPage" class="@labelCls"></label>
                        <input asp-for="PostsPerPage" type="number" min="1" max="100" class="@inputCls" />
                        <p class="@helpCls">Posts on the home page and on category, tag and search pages before a "next page" link (1 to 100).</p>
                        <span asp-validation-for="PostsPerPage" class="@errCls"></span>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="ColorScheme" class="@labelCls"></label>
                        <select asp-for="ColorScheme" class="@selectCls">
                            <option value="system">System — follow each reader's device setting</option>
                            <option value="light">Always light</option>
                            <option value="dark">Always dark</option>
                        </select>
                        <p class="@helpCls">Applies to the public site and this Desk. Presets that are already dark (Ink, Onyx) keep their own palette.</p>
                    </div>
                    @await Component.InvokeAsync("DateSettings", new { country = Model.Country, zone = Model.DisplayTimeZoneId, locale = Model.DateLocale, format = Model.DateFormat, clock = Model.ClockFormat })
                </div>
            </section>

            @* ────────────────────────────── Comments ────────────────────────────── *@
            <section id="s-comments" role="tabpanel" aria-labelledby="tab-comments" x-show="tab === 'comments'" x-cloak data-tab="comments"
                     class="desk-card p-6 space-y-6 scroll-mt-16">
                <header>
                    <h2 class="desk-card-title">Comments</h2>
                    <p class="@helpCls mt-1">Whether readers can comment and whether a person approves each comment first. The spam filter (honeypot, timing, link and duplicate checks) is always on and needs no setup; what it rejects is reported to the <a href="/admin/security" class="underline">firewall</a>.</p>
                </header>
                <div class="space-y-5">
                    <div class="flex items-start space-x-3">
                        <input asp-for="CommentsEnabled" type="checkbox" class="@checkCls" />
                        <div class="grid gap-1.5 leading-none">
                            <label asp-for="CommentsEnabled" class="@labelCls">Enable comments</label>
                            <p class="text-sm text-muted-foreground">Shows the comment form under posts that allow it. Turning this off hides the form everywhere but keeps existing comments.</p>
                        </div>
                    </div>
                    <div class="flex items-start space-x-3">
                        <input asp-for="CommentsModeration" type="checkbox" class="@checkCls" />
                        <div class="grid gap-1.5 leading-none">
                            <label asp-for="CommentsModeration" class="@labelCls">Hold comments for approval</label>
                            <p class="text-sm text-muted-foreground">New comments wait in <a href="/admin/comments" class="underline">Admin → Comments</a> until approved. Off means they appear immediately.</p>
                        </div>
                    </div>
                </div>
            </section>

            @* ────────────────────────── Search & analytics ────────────────────────── *@
            <section id="s-analytics" role="tabpanel" aria-labelledby="tab-analytics" x-show="tab === 'analytics'" x-cloak data-tab="analytics"
                     class="desk-card p-6 space-y-8 scroll-mt-16">
                <header>
                    <h2 class="desk-card-title">Search &amp; analytics</h2>
                    <p class="@helpCls mt-1">Prove you own the site to search engines, get new posts indexed fast, and pull real search performance into the Desk. Everything here is optional; blank fields simply switch a feature off.</p>
                </header>

                <div class="space-y-4">
                    <h3 class="text-sm font-semibold text-foreground">Ownership verification</h3>
                    <div class="grid gap-6 md:grid-cols-2">
                        <div class="space-y-2">
                            <label asp-for="GoogleSiteVerification" class="@labelCls"></label>
                            <input asp-for="GoogleSiteVerification" class="@inputCls" placeholder="content value from the google-site-verification meta tag" />
                            <p class="@helpCls">Search Console → Settings → Ownership verification → HTML tag. Paste only the <code>content</code> value; the tag is emitted for you.</p>
                        </div>
                        <div class="space-y-2">
                            <label asp-for="BingSiteVerification" class="@labelCls"></label>
                            <input asp-for="BingSiteVerification" class="@inputCls" placeholder="content value from the msvalidate.01 meta tag" />
                            <p class="@helpCls">Bing Webmaster Tools → verify via meta tag. Paste only the <code>content</code> value.</p>
                        </div>
                    </div>
                </div>

                <div class="space-y-4 pt-6 border-t border-border">
                    <h3 class="text-sm font-semibold text-foreground">Analytics</h3>
                    <div class="space-y-2">
                        <label asp-for="GoogleAnalyticsId" class="@labelCls"></label>
                        <input asp-for="GoogleAnalyticsId" class="@inputCls" placeholder="G-XXXXXXXXXX" />
                        <p class="@helpCls">GA4 Measurement ID from Google Analytics → Admin → Data Streams. Leave blank to load no tracker at all; the built-in <a href="/admin/analytics" class="underline">Analytics</a> works either way.</p>
                        <span asp-validation-for="GoogleAnalyticsId" class="@errCls"></span>
                    </div>
                    <div class="flex items-start gap-3">
                        <input asp-for="CookieConsentEnabled" type="checkbox" class="@checkCls" aria-describedby="cookie-consent-help" />
                        <div>
                            <label asp-for="CookieConsentEnabled" class="@labelCls"></label>
                            <p id="cookie-consent-help" class="@helpCls mt-1">On by default. Readers see a banner with equal Accept and Reject buttons, and Google Analytics loads only after they accept; the choice is remembered for @Blog.Core.Services.CookieConsent.RememberDays days and can be changed from the “Cookie settings” link at the foot of every page. With no Measurement ID set, the banner only says the site uses essential cookies. Turn it off only if no visitor is covered by consent rules such as the EU and UK GDPR and ePrivacy, Brazil’s LGPD or California’s CCPA.</p>
                        </div>
                    </div>
                </div>

                <div class="space-y-3 pt-6 border-t border-border">
                    <h3 class="text-sm font-semibold text-foreground">IndexNow</h3>
                    <div class="flex items-start gap-3">
                        <input asp-for="IndexNowEnabled" type="checkbox" class="@checkCls" />
                        <div>
                            <label asp-for="IndexNowEnabled" class="@labelCls">Enable IndexNow (instant indexing)</label>
                            <p class="@helpCls mt-1">Pings Bing, Yandex, Seznam and Naver the moment you publish or update a post, so they re-crawl in minutes instead of days. Google does not use IndexNow; verify with Search Console above instead.</p>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="IndexNowApiKey" class="@labelCls"></label>
                        <input asp-for="IndexNowApiKey" class="@inputCls font-mono" placeholder="Leave blank to auto-generate a key on save" />
                        @if (!string.IsNullOrEmpty(Model.IndexNowApiKey))
                        {
                            <p class="@helpCls">Verification file: <a href="/@(Model.IndexNowApiKey).txt" target="_blank" class="underline"><code>/@(Model.IndexNowApiKey).txt</code></a> — served automatically at the site root. No file upload needed.</p>
                        }
                        else
                        {
                            <p class="@helpCls">A key (a–z, 0–9, dashes) is generated automatically when you enable this and save. It's then served at <code>/{key}.txt</code> (site root) for ownership verification.</p>
                        }
                    </div>
                </div>

                <div class="space-y-3 pt-6 border-t border-border">
                    <h3 class="text-sm font-semibold text-foreground">Search Console</h3>
                    @if (Model.SearchConsoleConnectedAs is not null)
                    {
                        <p class="text-xs rounded-lg border p-3 pill-ok">
                            Connected to <code>@Model.SearchConsoleProperty</code> as <code>@Model.SearchConsoleConnectedAs</code>.
                            @if (Model.SearchConsoleLatestDate is DateTime latest)
                            {
                                <span>Data through <strong>@Dates.CalendarDate(latest, Blog.Core.Services.DateStyle.Medium)</strong>.</span>
                            }
                            else
                            {
                                <span>No data pulled yet — the nightly sync runs within a minute of startup and then every 24 hours; check Admin → Dashboard → Scheduled jobs.</span>
                            }
                        </p>
                    }
                    else if (Model.SearchConsoleCredentialStored)
                    {
                        <p class="text-xs rounded-lg border p-3 pill-warn">
                            A key file is stored but cannot be read (the Data Protection key ring changed) or no property is set. Paste the key file again and set the property.
                        </p>
                    }
                    else
                    {
                        <p class="@helpCls">
                            Pulls clicks, impressions, CTR and position for every page into the editor, Content Health and the dashboard — no more spreadsheet exports.
                            Create a <strong>service account</strong> in Google Cloud (IAM → Service Accounts → Keys → JSON), then add its email as a <em>Full</em> or <em>Restricted</em> user on your property in Search Console → Settings → Users and permissions.
                        </p>
                    }
                    <div class="space-y-2">
                        <label asp-for="SearchConsoleProperty" class="@labelCls"></label>
                        <input asp-for="SearchConsoleProperty" placeholder="example.com  or  https://www.example.com/" class="@inputCls font-mono" />
                        <p class="@helpCls">A bare domain becomes a domain property (<code>sc-domain:example.com</code>); a URL becomes a URL-prefix property.</p>
                        <span asp-validation-for="SearchConsoleProperty" class="@errCls"></span>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="SearchConsoleServiceAccountJson" class="@labelCls"></label>
                        <textarea asp-for="SearchConsoleServiceAccountJson" rows="4" autocomplete="off" spellcheck="false" placeholder='@(Model.SearchConsoleCredentialStored ? "Paste a new key file only to replace the stored one." : "{ \"type\": \"service_account\", \"client_email\": \"…\", \"private_key\": \"…\" }")' class="desk-textarea text-xs font-mono"></textarea>
                        <p class="@helpCls">Stored encrypted; never shown again, logged, or exported. Leave empty to keep the stored key.</p>
                        <span asp-validation-for="SearchConsoleServiceAccountJson" class="@errCls"></span>
                    </div>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label asp-for="SearchPerformanceRetentionMonths" class="@labelCls"></label>
                            <input asp-for="SearchPerformanceRetentionMonths" type="number" min="1" max="16" class="@inputCls" />
                            <p class="@helpCls">Search Console itself keeps 16 months; the first sync backfills this far.</p>
                            <span asp-validation-for="SearchPerformanceRetentionMonths" class="@errCls"></span>
                        </div>
                        @if (Model.SearchConsoleCredentialStored)
                        {
                            <div class="flex items-start gap-3 pt-6">
                                <input asp-for="SearchConsoleDisconnect" type="checkbox" class="@checkCls" />
                                <div>
                                    <label asp-for="SearchConsoleDisconnect" class="@labelCls"></label>
                                    <p class="@helpCls mt-1">Removes the stored key and property on save. Pulled data is kept until it ages out.</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </section>

            @* ──────────────────── Notifications & housekeeping ──────────────────── *@
            <section id="s-housekeeping" role="tabpanel" aria-labelledby="tab-housekeeping" x-show="tab === 'housekeeping'" x-cloak data-tab="housekeeping"
                     class="desk-card p-6 space-y-8 scroll-mt-16">
                <header>
                    <h2 class="desk-card-title">Notifications &amp; housekeeping</h2>
                    <p class="@helpCls mt-1">Alerts for the operator and how long the platform keeps its own working data. The nightly jobs that apply these limits are listed on the <a href="/admin/dashboard" class="underline">dashboard</a>.</p>
                </header>
                <div class="space-y-3">
                    <h3 class="text-sm font-semibold text-foreground">Error alerts</h3>
                    <div class="flex items-start gap-3">
                        <input asp-for="ErrorNotificationsEnabled" type="checkbox" class="@checkCls" />
                        <div>
                            <label asp-for="ErrorNotificationsEnabled" class="@labelCls">Email me when a server error occurs</label>
                            <p class="@helpCls mt-1">Sends an alert the first time a new server-error (5xx) signature is detected, so repeats don't flood your inbox. All errors (incl. 404s) are always visible in <a href="/admin/errors" class="underline">Admin → Error Monitor</a>. Needs SMTP configured on the server.</p>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="ErrorNotificationEmails" class="@labelCls"></label>
                        <input asp-for="ErrorNotificationEmails" class="@inputCls" placeholder="ops@example.com, dev@example.com" />
                        <p class="@helpCls">One or more addresses, separated by commas, semicolons, or new lines.</p>
                    </div>
                </div>
                <div class="grid gap-6 md:grid-cols-2 pt-6 border-t border-border">
                    <div class="space-y-2">
                        <label asp-for="CrawlerVisitRetentionDays" class="@labelCls"></label>
                        <input asp-for="CrawlerVisitRetentionDays" type="number" min="7" max="3650" class="@inputCls" />
                        <p class="@helpCls">How long <a href="/admin/ai-crawlers" class="underline">Admin → AI Crawlers</a> keeps each crawler request (7–3650 days). Older rows are pruned nightly.</p>
                        <span asp-validation-for="CrawlerVisitRetentionDays" class="@errCls"></span>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="PageViewRetentionDays" class="@labelCls"></label>
                        <input asp-for="PageViewRetentionDays" type="number" min="0" max="3650" class="@inputCls" />
                        <p class="@helpCls">How long each recorded page view is kept in full (address hash, browser, exact time). <a href="/admin/analytics" class="underline">Admin → Analytics</a> keeps its figures either way, from a daily summary. 0 keeps every view; otherwise 31–3650 days, removed a little at a time each hour.</p>
                        <span asp-validation-for="PageViewRetentionDays" class="@errCls"></span>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="RevisionsPerItem" class="@labelCls"></label>
                        <input asp-for="RevisionsPerItem" type="number" min="1" max="200" class="@inputCls" />
                        <p class="@helpCls">A revision is written each time a post or page is saved with changed content; the oldest beyond this count are pruned.</p>
                        <span asp-validation-for="RevisionsPerItem" class="@errCls"></span>
                    </div>
                </div>
                @if (User.IsInRole("Admin"))
                {
                    <fieldset class="space-y-3 pt-6 border-t border-border">
                        <legend class="text-sm font-semibold text-foreground">Two-factor sign-in</legend>
                        <p class="@helpCls">Anyone can turn on two-factor sign-in for their own account under <a href="/account/security" class="underline">Two-factor sign-in</a>. Tick a role to require it: people in that role must set it up before they reach the Desk, including anyone signed in now. Make sure your own account is set up before requiring it for Admins.</p>
                        <div class="flex flex-wrap gap-x-6 gap-y-2">
                            @foreach (var role in Blog.Core.Services.TwoFactor.Roles)
                            {
                                <label class="flex items-center gap-2 text-sm text-foreground">
                                    <input type="checkbox" name="TwoFactorRequiredRoles" value="@role" checked="@(Model.TwoFactorRequiredRoles.Contains(role))" class="@checkCls" />
                                    @role
                                </label>
                            }
                        </div>
                        <input type="hidden" name="TwoFactorRolesPosted" value="true" />
                    </fieldset>
                }
            </section>

            @* ────────────────────────────── Social ────────────────────────────── *@
            <section id="s-social" role="tabpanel" aria-labelledby="tab-social" x-show="tab === 'social'" x-cloak data-tab="social"
                     class="desk-card p-6 space-y-6 scroll-mt-16">
                <header>
                    <h2 class="desk-card-title">Social</h2>
                    <p class="@helpCls mt-1">Profile links shown as icons in the header or footer of most layouts and listed as <code>sameAs</code> in the publisher's structured data. Leave a field blank to hide that icon. Use the full profile URL.</p>
                </header>
                <div class="grid gap-6 md:grid-cols-2">
                    <div class="space-y-2">
                        <label asp-for="SocialTwitter" class="@labelCls"></label>
                        <input asp-for="SocialTwitter" class="@inputCls" placeholder="https://x.com/username" />
                    </div>
                    <div class="space-y-2">
                        <label asp-for="SocialFacebook" class="@labelCls"></label>
                        <input asp-for="SocialFacebook" class="@inputCls" placeholder="https://facebook.com/username" />
                    </div>
                    <div class="space-y-2">
                        <label asp-for="SocialInstagram" class="@labelCls"></label>
                        <input asp-for="SocialInstagram" class="@inputCls" placeholder="https://instagram.com/username" />
                    </div>
                    <div class="space-y-2">
                        <label asp-for="SocialYoutube" class="@labelCls"></label>
                        <input asp-for="SocialYoutube" class="@inputCls" placeholder="https://youtube.com/@@username" />
                    </div>
                    <div class="space-y-2">
                        <label asp-for="SocialLinkedin" class="@labelCls"></label>
                        <input asp-for="SocialLinkedin" class="@inputCls" placeholder="https://linkedin.com/in/username" />
                    </div>
                    <div class="space-y-2">
                        <label asp-for="SocialGithub" class="@labelCls"></label>
                        <input asp-for="SocialGithub" class="@inputCls" placeholder="https://github.com/username" />
                    </div>
                </div>
            </section>

            @* ────────────────────────────── Identity ────────────────────────────── *@
            <section id="s-identity" role="tabpanel" aria-labelledby="tab-identity" x-show="tab === 'identity'" x-cloak data-tab="identity"
                     class="desk-card p-6 space-y-6 scroll-mt-16">
                <header>
                    <h2 class="desk-card-title">Publisher identity</h2>
                    <p class="@helpCls mt-1">
                        Who this publication <em>is</em>, as an entity rather than a website. Search and answer engines
                        resolve a brand by cross-referencing authoritative profiles — this is how they tell you apart
                        from a similarly named site, or from whatever your domain published before. Every field is
                        optional; blanks are omitted from structured data rather than guessed at. Feeds the publisher
                        node in structured data and the Identity section of <code>llms.txt</code>.
                    </p>
                </header>

                <div class="grid gap-6 md:grid-cols-2">
                    <div class="space-y-2">
                        <label asp-for="EntityType" class="@labelCls">Publisher type</label>
                        <select asp-for="EntityType" class="@selectCls">
                            <option value="Organization">Organization</option>
                            <option value="Person">Person (a personal publication)</option>
                        </select>
                        <p class="@helpCls">Sets the schema.org type of the publisher node.</p>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="EntityLegalName" class="@labelCls">Legal name</label>
                        <input asp-for="EntityLegalName" class="@inputCls" placeholder="Registered name, if different from the site name" />
                    </div>
                    <div class="space-y-2">
                        <label asp-for="EntityFounder" class="@labelCls">Founder</label>
                        <input asp-for="EntityFounder" class="@inputCls" placeholder="Full name" />
                    </div>
                    <div class="space-y-2">
                        <label asp-for="EntityFoundingDate" class="@labelCls">Founded</label>
                        <input asp-for="EntityFoundingDate" class="@inputCls" placeholder="2019 or 2019-04-01" />
                        <p class="@helpCls">A year or a full date. Anything else is left out rather than reshaped.</p>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="EntityContactEmail" class="@labelCls">Contact email</label>
                        <input asp-for="EntityContactEmail" type="email" class="@inputCls" placeholder="hello@example.com" />
                        <span asp-validation-for="EntityContactEmail" class="@errCls"></span>
                    </div>
                    <div class="space-y-2">
                        <label asp-for="EntityContactUrl" class="@labelCls">Contact page</label>
                        <input asp-for="EntityContactUrl" class="@inputCls" placeholder="/contact or https://…" />
                        <span asp-validation-for="EntityContactUrl" class="@errCls"></span>
                    </div>
                    <div class="space-y-2 md:col-span-2">
                        <label asp-for="EntityContactType" class="@labelCls">Contact type</label>
                        <input asp-for="EntityContactType" class="@inputCls" placeholder="customer support" maxlength="60" />
                        <span asp-validation-for="EntityContactType" class="@errCls"></span>
                        <p class="@helpCls">With an email or a contact page, search and answer engines are told how to reach you (<code>contactPoint</code> in the publisher's structured data; the email is also listed in llms.txt). Leave both empty to publish neither. The type says who answers, for example customer support or editorial.</p>
                    </div>
                </div>

                <div class="space-y-2">
                    <label asp-for="EntitySameAs" class="@labelCls">Authority profiles</label>
                    <textarea asp-for="EntitySameAs" rows="4" class="desk-textarea" placeholder="https://en.wikipedia.org/wiki/Your_Publication&#10;https://www.wikidata.org/wiki/Q123456&#10;https://www.crunchbase.com/organization/your-company"></textarea>
                    <p class="@helpCls">
                        One URL per line — Wikipedia, Wikidata, a company register, Crunchbase, an ORCID. These join your
                        social links in <code>sameAs</code>. Only absolute http(s) URLs are used; a bare handle would
                        invalidate the whole node.
                    </p>
                </div>

                <div class="space-y-2">
                    <label asp-for="EntityIdentityStatement" class="@labelCls">Identity statement</label>
                    <textarea asp-for="EntityIdentityStatement" rows="4" class="desk-textarea" placeholder="Leave blank to use the generated wording."></textarea>
                    <p class="@helpCls">
                        Written for answer engines and published verbatim in the Identity section of
                        <code>llms.txt</code>. Say plainly what this publication is — and, if your domain previously
                        published something else, what it is not. Blank keeps the generated wording.
                    </p>
                </div>
            </section>

            @* ────────────────────────────── Custom fields ────────────────────────────── *@
            @{
                var cfErrors = ViewData["CustomFieldErrors"] as IDictionary<int, string> ?? new Dictionary<int, string>();
            }
            <section id="s-fields" role="tabpanel" aria-labelledby="tab-fields" x-show="tab === 'fields'" x-cloak data-tab="fields"
                     class="desk-card p-6 space-y-6 scroll-mt-16"
                     x-data='customFieldsEditor(@Json.Serialize(Model.CustomFieldsJson ?? "[]"), @Json.Serialize(cfErrors))'>
                <header>
                    <h2 class="desk-card-title">Custom fields</h2>
                    <p class="@helpCls mt-1">Extra facts you record on every post or page, such as a price, a version or an event date. Each field appears in the editor; fields marked <strong>Show to readers</strong> are listed under “Details” on the page and added to its structured data (<code>additionalProperty</code>). Fields are shown in this order.</p>
                </header>
                <input type="hidden" name="CustomFieldsPosted" value="true" />
                <input type="hidden" name="CustomFieldsJson" :value="json()" />
                @if (cfErrors.Count > 0 || ViewData.ModelState["CustomFieldsJson"]?.Errors.Count > 0)
                {
                    <p class="@errCls" role="alert">@(ViewData.ModelState["CustomFieldsJson"]?.Errors.FirstOrDefault()?.ErrorMessage ?? "Some custom fields need attention.") Correct the rows marked below, then save.</p>
                }
                <p x-show="rows.length === 0" class="@helpCls">No custom fields yet. Add one below; nothing appears in the editors or on the site until you do.</p>
                <ol class="space-y-4 list-none p-0 m-0" x-show="rows.length > 0">
                    <template x-for="(row, i) in rows" :key="row.uid">
                        <li class="rounded-lg border border-border p-4 space-y-3">
                            <div class="grid gap-3 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)]">
                                <div class="space-y-1">
                                    <label class="@labelCls" :for="'cf-label-' + i">Label</label>
                                    <input class="@inputCls" :id="'cf-label-' + i" x-model="row.Label" maxlength="60" placeholder="Price from"
                                           @@input="clearError(row)"
                                           :aria-invalid="errors[row.uid] ? 'true' : null" :aria-describedby="errors[row.uid] ? 'cf-err-' + i : null" />
                                </div>
                                <div class="space-y-1">
                                    <label class="@labelCls" :for="'cf-type-' + i">Type</label>
                                    <select class="@selectCls" :id="'cf-type-' + i" x-model="row.Type" :aria-describedby="row.Key && row.Type !== row.origType ? 'cf-typewarn-' + i : null">
                                        <option value="text">Text</option>
                                        <option value="number">Number</option>
                                        <option value="date">Date</option>
                                        <option value="url">Web address</option>
                                        <option value="yesno">Yes / no</option>
                                    </select>
                                </div>
                                <div class="space-y-1">
                                    <label class="@labelCls" :for="'cf-applies-' + i">Used on</label>
                                    <select class="@selectCls" :id="'cf-applies-' + i" x-model="row.AppliesTo">
                                        <option value="posts">Posts</option>
                                        <option value="pages">Pages</option>
                                        <option value="both">Posts and pages</option>
                                    </select>
                                </div>
                            </div>
                            <p class="@errCls" x-show="errors[row.uid]" :id="'cf-err-' + i" x-text="errors[row.uid]"></p>
                            <p class="text-xs tone-warn" x-show="row.Key && row.Type !== row.origType" :id="'cf-typewarn-' + i">Values already entered are kept. Any that do not fit the new type are flagged in the editor for you to correct.</p>
                            <div class="flex flex-wrap items-center justify-between gap-3">
                                <label class="flex items-center gap-2 text-sm text-foreground">
                                    <input type="checkbox" class="@checkCls mt-0" x-model="row.ShowOnPage" /> Show to readers<span class="sr-only" x-text="': ' + (row.Label || 'new field')"></span>
                                </label>
                                <div class="flex items-center gap-2">
                                    <span class="@helpCls" x-text="row.Key ? 'Export key: ' + row.Key : 'New field'"></span>
                                    <button type="button" :id="'cf-up-' + i" class="desk-btn desk-btn-outline desk-btn-icon" :disabled="i === 0" @@click="move(i, -1)" :aria-label="'Move ' + (row.Label || 'this field') + ' up'">↑</button>
                                    <button type="button" :id="'cf-down-' + i" class="desk-btn desk-btn-outline desk-btn-icon" :disabled="i === rows.length - 1" @@click="move(i, 1)" :aria-label="'Move ' + (row.Label || 'this field') + ' down'">↓</button>
                                    <button type="button" class="desk-btn desk-btn-danger-outline" @@click="remove(i)" :aria-label="'Remove ' + (row.Label || 'this field')">Remove</button>
                                </div>
                            </div>
                        </li>
                    </template>
                </ol>
                <div class="flex flex-wrap items-center gap-3">
                    <button type="button" id="cf-add" @@click="add()" class="desk-btn desk-btn-outline">Add field</button>
                    <p class="@helpCls">Up to @Blog.Core.Services.CustomFields.MaxFields fields. Renaming a field keeps its values. Removing one hides it everywhere but keeps the values already entered: add a field with the same label again and they return.</p>
                </div>
            </section>

            @* ── Sticky action bar: Save is visible on every tab, at every scroll position ── *@
            <div class="sticky bottom-0 z-10 mt-6 -mx-1 px-1 pb-[env(safe-area-inset-bottom,0px)]">
                <div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-border bg-card/95 backdrop-blur px-4 py-3 shadow-lg">
                    <div class="flex items-center gap-3 text-xs text-muted-foreground">
                        <span data-dirty-indicator hidden>Unsaved changes</span>
                        <span>Saving applies the fields on every tab.</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <a href="/admin/settings" class="desk-btn desk-btn-outline">Discard</a>
                        <button type="submit" class="desk-btn desk-btn-primary">
                            Save changes
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

