@* No client-side validation library here: the Desk layout does not load the one it needs, so it never ran
   (it only logged a console error). Fields are checked by the browser's own constraints and, authoritatively, by SettingsController. *@

<script>
    // Settings tabs: one form, eight panels. The hash remembers the tab (#s-general …), a validation
    // error switches to the tab that holds it, and the browser's own "required" check reveals the
    // panel before it tries to focus the field (an invisible field cannot be focused, and the submit
    // would otherwise fail silently).
    document.addEventListener('alpine:init', function () {
        Alpine.data('settingsTabs', function () {
            return {
                tabs: [
                    { key: 'general',      label: 'General' },
                    { key: 'display',      label: 'Display' },
                    { key: 'comments',     label: 'Comments' },
                    { key: 'analytics',    label: 'Search & analytics' },
                    { key: 'housekeeping', label: 'Notifications & housekeeping' },
                    { key: 'social',       label: 'Social' },
                    { key: 'identity',     label: 'Identity' },
                    { key: 'fields',       label: 'Custom fields' }
                ],
                tab: 'general',
                errors: {},
                init: function () {
                    var self = this;
                    var fromHash = (location.hash || '').replace('#s-', '');
                    if (this.tabs.some(function (t) { return t.key === fromHash; })) this.tab = fromHash;

                    // Count server-side validation errors per tab and open the first offending tab.
                    var first = null;
                    this.$refs.form.querySelectorAll('[data-tab]').forEach(function (panel) {
                        var n = Array.from(panel.querySelectorAll('.field-validation-error, .text-destructive')).filter(function (e) { return e.textContent.trim(); }).length;
                        if (n) { self.errors[panel.dataset.tab] = n; if (!first) first = panel; }
                    });
                    if (first) {
                        this.tab = first.dataset.tab;
                        this.$nextTick(function () {
                            var err = first.querySelector('.field-validation-error, .text-destructive');
                            if (err) err.scrollIntoView({ block: 'center' });
                            // Errors are placed, then focused (UI rule 12): the field itself, not just the message.
                            var field = first.querySelector('[aria-invalid="true"], .input-validation-error');
                            if (field && field.focus) field.focus({ preventScroll: true });
                        });
                    }

                    // Native "required"/"min"/"max" checks: reveal the tab before the browser focuses the field.
                    this.$refs.form.addEventListener('invalid', function (e) {
                        var panel = e.target.closest('[data-tab]');
                        if (panel && self.tab !== panel.dataset.tab) self.tab = panel.dataset.tab;
                    }, true);

                    window.addEventListener('hashchange', function () {
                        var k = (location.hash || '').replace('#s-', '');
                        if (self.tabs.some(function (t) { return t.key === k; })) self.tab = k;
                    });
                },
                go: function (key) {
                    this.tab = key;
                    if (history.replaceState) history.replaceState(null, '', '#s-' + key);
                    var t = document.getElementById('tab-' + key); if (t) t.focus();
                },
                next: function (delta) {
                    var i = this.tabs.findIndex(function (t) { return t.key === this.tab; }.bind(this));
                    var n = (i + delta + this.tabs.length) % this.tabs.length;
                    this.go(this.tabs[n].key);
                }
            };
        });
    });
</script>

<script>
    // Custom fields tab (ADR-0025): the rows are edited here and posted as one JSON value. The server
    // keeps each existing field's key, so renaming a label never detaches the values already entered.
    // Server errors arrive keyed by row position and are re-keyed to the row, so reordering keeps them.
    document.addEventListener('alpine:init', function () {
        Alpine.data('customFieldsEditor', function (json, serverErrors) {
            var uid = 0;
            var parsed = [];
            try { parsed = JSON.parse(json || '[]') || []; } catch (e) { parsed = []; }
            var rows = parsed.map(function (r) {
                var type = r.Type || r.type || 'text';
                return { uid: ++uid, Key: r.Key || r.key || '', Label: r.Label || r.label || '', Type: type, origType: type,
                         AppliesTo: r.AppliesTo || r.appliesTo || 'posts', ShowOnPage: (r.ShowOnPage ?? r.showOnPage) !== false };
            });
            var errors = {};
            Object.keys(serverErrors || {}).forEach(function (i) { if (rows[i]) errors[rows[i].uid] = serverErrors[i]; });
            return {
                rows: rows,
                errors: errors,
                json: function () {
                    return JSON.stringify(this.rows.map(function (r) {
                        return { Key: r.Key, Label: r.Label, Type: r.Type, AppliesTo: r.AppliesTo, ShowOnPage: !!r.ShowOnPage };
                    }));
                },
                changed: function () {
                    // The hidden input changes without an input event; tell the unsaved-changes guard.
                    this.$nextTick(function () {
                        var h = document.querySelector('input[name="CustomFieldsJson"]');
                        if (h) h.dispatchEvent(new Event('input', { bubbles: true }));
                    });
                },
                clearError: function (row) { delete this.errors[row.uid]; },
                add: function () {
                    this.rows.push({ uid: ++uid, Key: '', Label: '', Type: 'text', origType: 'text', AppliesTo: 'posts', ShowOnPage: true });
                    this.changed();
                    var i = this.rows.length - 1;
                    this.$nextTick(function () { var el = document.getElementById('cf-label-' + i); if (el) el.focus(); });
                },
                remove: function (i) {
                    var gone = this.rows.splice(i, 1)[0];
                    if (gone) delete this.errors[gone.uid];
                    this.changed();
                    var self = this;
                    this.$nextTick(function () {
                        var next = document.getElementById('cf-label-' + Math.min(i, self.rows.length - 1));
                        (next || document.getElementById('cf-add')).focus();
                    });
                },
                move: function (i, d) {
                    var j = i + d;
                    if (j < 0 || j >= this.rows.length) return;
                    var r = this.rows.splice(i, 1)[0];
                    this.rows.splice(j, 0, r);
                    this.changed();
                    // Keep focus on the moved row: the same arrow, or the other one at the top or bottom.
                    this.$nextTick(function () {
                        var same = document.getElementById((d < 0 ? 'cf-up-' : 'cf-down-') + j);
                        var other = document.getElementById((d < 0 ? 'cf-down-' : 'cf-up-') + j);
                        (same && !same.disabled ? same : other).focus();
                    });
                }
            };
        });
    });
</script>
