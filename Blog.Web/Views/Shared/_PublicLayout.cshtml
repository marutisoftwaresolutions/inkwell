@inject Blog.Core.Interfaces.ICustomThemeSettingRepository ThemeSettingsRepo
@inject Blog.Core.Interfaces.ISettingRepository SettingsRepo
@inject Blog.Core.Interfaces.ITenantContext TenantContext
@inject Blog.Core.Interfaces.IUserRepository UserRepo
@inject Blog.Core.Interfaces.ICategoryRepository CategoryRepo
@inject Microsoft.Extensions.Configuration.IConfiguration _rcfg
@using System.Security.Claims
@{
	Guid contentId = Guid.Empty;
	if (TenantContext.IsCloudMode)
	{
		if (TenantContext.IsResolved)
		{
			contentId = TenantContext.UserId;
		}
		else if (Guid.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var id))
		{
			contentId = id;
		}
	}

	if (contentId == Guid.Empty)
	{
		var admin = await UserRepo.GetFirstAdminAsync();
		contentId = admin?.Id ?? Guid.Empty;
	}

	Guid brandingId = contentId;

	var themeSettings = await ThemeSettingsRepo.GetAllAsync(brandingId);
	var themeDict = themeSettings.ToDictionary(s => s.SettingKey, s => s.EffectiveValue);

	string GetTheme(string key, string fallback) => themeDict.TryGetValue(key, out var v) ? v : fallback;

	// Normalizes a stored Twitter/X value (full URL or bare handle) into an @handle for twitter:site.
	static string TwitterHandle(string raw)
	{
		if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
		raw = raw.Trim();
		if (raw.Contains("twitter.com/", StringComparison.OrdinalIgnoreCase) || raw.Contains("x.com/", StringComparison.OrdinalIgnoreCase))
		{
			var seg = raw.TrimEnd('/').Split('/').LastOrDefault();
			raw = seg ?? string.Empty;
		}
		raw = raw.TrimStart('@');
		return string.IsNullOrEmpty(raw) ? string.Empty : "@" + raw;
	}

	var fontHeading = GetTheme("font-heading", "Inter");
	var fontBody = GetTheme("font-body", "Inter");
	var fontsToLoad = new HashSet<string> { fontHeading, fontBody, "Inter" };

	var userSettings = await SettingsRepo.GetSettingsAsync(brandingId);
	var siteName = userSettings.SiteName;
	var siteDescription = userSettings.SiteDescription;

	var globalSettings = await SettingsRepo.GetSettingsAsync(brandingId);

	// ── Title template ──────────────────────────────────────────────────────
	// Every page ends up with a single " | {SiteName}" suffix: no missing brand,
	// no double brand. A title that already contains the site name is left as-is
	// (e.g. the homepage "SiteName – Tagline", or a MetaTitle that includes it).
	var brandedTitle = Blog.Core.Services.TextHelper.BrandTitle((string?)ViewData["Title"], siteName);

	var robotsDirective = (string?)ViewData["Robots"];

	// ── Content language (drives <html lang>, hreflang, og:locale, schema inLanguage) ──
	var siteLang = string.IsNullOrWhiteSpace(userSettings.SiteLanguage) ? "en" : userSettings.SiteLanguage.Trim();
	var siteLocale = Blog.Core.Services.LocaleHelper.OgLocale(siteLang);
}
<!DOCTYPE html>
<html lang="@siteLang">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@brandedTitle</title>
	<meta name="description" content="@ViewData["Description"]" />
	@if (!string.IsNullOrEmpty(robotsDirective))
	{
		<meta name="robots" content="@robotsDirective" />
	}
	@if (!string.IsNullOrEmpty(globalSettings.SiteFaviconUrl))
	{
		<link rel="icon" type="image/x-icon" href="@globalSettings.SiteFaviconUrl" />
	}
	@* Search-engine ownership verification (Google Search Console / Bing Webmaster Tools) *@
	@if (!string.IsNullOrWhiteSpace(globalSettings.GoogleSiteVerification))
	{
		<meta name="google-site-verification" content="@globalSettings.GoogleSiteVerification" />
	}
	@if (!string.IsNullOrWhiteSpace(globalSettings.BingSiteVerification))
	{
		<meta name="msvalidate.01" content="@globalSettings.BingSiteVerification" />
	}

	@* ── Performance: preconnect + preload the two critical brand fonts ─────────
	   Geist (headings/UI) and Source Serif 4 (body copy) are the Inkwell design-system
	   defaults used on virtually every page; preloading their latin subsets removes a
	   font-swap round-trip on the LCP text. font-display:swap is already set in fonts.css. *@
	@if (!string.IsNullOrWhiteSpace(globalSettings.GoogleAnalyticsId))
	{
		<link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
	}
	<link rel="preload" href="~/fonts/gyByhwUxId8gMEwcGFU.woff2" as="font" type="font/woff2" crossorigin />
	<link rel="preload" href="~/fonts/vEFI2_tTDB4M7-auWDN0ahZJW1gb8tc.woff2" as="font" type="font/woff2" crossorigin />

	@* ── Canonical + universal metadata (every public page) ─────────────────── *@
	@{
		var canonicalUrl = (string?)ViewData["Canonical"];
		if (string.IsNullOrEmpty(canonicalUrl))
			canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
		var pageTitle = brandedTitle;
		var pageDesc = (string?)(ViewData["Description"]) ?? siteDescription;
		themeDict.TryGetValue("bg", out var themeColor);
	}
	<link rel="canonical" href="@canonicalUrl" />
	@* Self-referential hreflang. For a single-language site this declares the page's language and
	   marks it as the default; when translated URLs exist, add their alternates alongside these. *@
	<link rel="alternate" hreflang="@siteLang" href="@canonicalUrl" />
	<link rel="alternate" hreflang="x-default" href="@canonicalUrl" />
	<meta name="author" content="@siteName" />
	<meta name="theme-color" content="@(string.IsNullOrEmpty(themeColor) ? "#ffffff" : themeColor)" />
	@* AI-crawler discovery hint — points assistants at the plain-text site summary *@
	<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly site summary" />

	@* Default Open Graph / Twitter for pages that don't define their own MetaTags (home, index, category, tag, CMS pages). Post pages define MetaTags and own their OG/Twitter block. *@
	@if (!IsSectionDefined("MetaTags"))
	{
		var defaultImage = !string.IsNullOrEmpty(globalSettings.SiteCoverUrl) ? globalSettings.SiteCoverUrl
			: !string.IsNullOrEmpty(globalSettings.SiteLogoUrl) ? globalSettings.SiteLogoUrl
			: string.Empty;
			// og:image / twitter:image must be ABSOLUTE — most social scrapers reject relative paths.
			if (defaultImage.StartsWith("/"))
				defaultImage = $"{Context.Request.Scheme}://{Context.Request.Host}{defaultImage}";
		<meta property="og:type" content="website" />
		<meta property="og:title" content="@pageTitle" />
		<meta property="og:description" content="@pageDesc" />
		<meta property="og:url" content="@canonicalUrl" />
		<meta property="og:site_name" content="@siteName" />
		<meta property="og:locale" content="@siteLocale" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="@pageTitle" />
		<meta name="twitter:description" content="@pageDesc" />
		if (!string.IsNullOrEmpty(defaultImage))
		{
			<meta property="og:image" content="@defaultImage" />
			<meta name="twitter:image" content="@defaultImage" />
		}
		var twSite = TwitterHandle(globalSettings.SocialTwitter);
		if (!string.IsNullOrEmpty(twSite))
		{
			<meta name="twitter:site" content="@twSite" />
		}
	}
	@await RenderSectionAsync("MetaTags", required: false)
	@if (!string.IsNullOrWhiteSpace(globalSettings.GoogleAnalyticsId))
	{
		<script async src="https://www.googletagmanager.com/gtag/js?id=@globalSettings.GoogleAnalyticsId"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', '@globalSettings.GoogleAnalyticsId');
		</script>
	}

	<!-- Inkwell Fonts (self-hosted) -->
	<link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true" />

	<!-- Bootstrap Icons (self-hosted) -->
	<link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />

	@* Tailwind CSS — precompiled static stylesheet (replaces the render-blocking runtime
	   JIT compiler). Color utilities map to CSS variables so runtime theming still works.
	   Regenerate after adding new utility classes with the npx command in tailwind.config.js. *@
	<link rel="stylesheet" href="~/css/tailwind.css" asp-append-version="true" />

	<!-- Theme CSS Variables -->
	@if (themeSettings.Any())
	{
		<style>
			:root {
			@foreach (var
			s in themeSettings.Where(s => s.SettingGroup == "colors"))
			{
				@:-- @(s.SettingKey) : @(s.EffectiveValue);
			}
			--font-sans: '@fontHeading', sans-serif;
			--font-body: '@fontBody', sans-serif;
			--radius: @(GetTheme("border-radius", "0.5rem"));
			}
		</style>
	}
	else
	{
		<style>
			:root {
			--background: var(--ink-cream);
			--foreground: var(--ink-black);
			--primary: var(--ink-black);
			--primary-foreground: var(--ink-cream);
			--secondary: var(--ink-cream-deep);
			--secondary-foreground: var(--ink-black);
			--muted: var(--ink-cream-deep);
			--muted-foreground: var(--ink-sepia);
			--accent: var(--ink-cream-edge);
			--accent-foreground: var(--ink-black);
			--card: var(--ink-cream-deep);
			--card-foreground: var(--ink-black);
			--border: var(--ink-cream-edge);
			--destructive: #8C2A1F;
			--font-sans: 'Geist', sans-serif;
			--font-body: 'Source Serif 4', serif;
			--radius: 2px;
			}
		</style>
	}

	<!-- Inkwell Design System -->
	<link rel="stylesheet" href="~/css/inkwell.css" asp-append-version="true" />
	<!-- Legacy neutral styles (filters, pagination, non-Magazine layouts) -->
	<link rel="stylesheet" href="~/css/neutral-blog.css" asp-append-version="true" />

	<!-- Highlight.js + Lucide are loaded on demand (only when the page actually
	     contains code blocks / lucide icons) so they never block first paint on the
	     common case of a text-only article. Paths go through Url.Content so they
	     resolve correctly under a virtual-directory deployment. -->
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			// Syntax highlighting — only if the page has <pre><code> blocks.
			if (document.querySelector('pre code')) {
				var hlCss = document.createElement('link');
				hlCss.rel = 'stylesheet';
				hlCss.href = '@Url.Content("~/lib/highlightjs/github-dark.min.css")';
				document.head.appendChild(hlCss);
				var hlJs = document.createElement('script');
				hlJs.src = '@Url.Content("~/lib/highlightjs/highlight.min.js")';
				hlJs.onload = function () {
					document.querySelectorAll('pre code').forEach(function (el) {
						if (window.hljs) hljs.highlightElement(el);
					});
				};
				document.head.appendChild(hlJs);
			}
			// Lucide icons — only if the page uses data-lucide (public pages use Bootstrap Icons).
			if (document.querySelector('[data-lucide]')) {
				var lu = document.createElement('script');
				lu.src = '@Url.Content("~/lib/lucide/lucide.min.js")';
				lu.onload = function () { if (window.lucide) lucide.createIcons(); };
				document.head.appendChild(lu);
			}
		});
	</script>
	<!-- Alpine.js (self-hosted) -->
	<script defer src="~/lib/alpinejs/alpine.min.js"></script>

	<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/feed" />

	@{
		var orgBaseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
		var orgSchema = new System.Text.Json.JsonSerializerOptions { WriteIndented = false };
		var orgData = new System.Collections.Generic.Dictionary<string, object>
		{
			["@context"] = "https://schema.org",
			["@type"] = "Organization",
			["@id"] = $"{orgBaseUrl}/#organization",
			["name"] = siteName,
			["url"] = orgBaseUrl,
			["description"] = siteDescription
		};
		if (!string.IsNullOrEmpty(globalSettings.SiteLogoUrl))
			orgData["logo"] = new System.Collections.Generic.Dictionary<string, string>
			{
				["@type"] = "ImageObject",
				["url"] = globalSettings.SiteLogoUrl
			};
		// sameAs — every configured social profile strengthens the entity graph for Google & AI answer engines.
		var sameAs = new[]
		{
			globalSettings.SocialTwitter, globalSettings.SocialFacebook, globalSettings.SocialInstagram,
			globalSettings.SocialYoutube, globalSettings.SocialLinkedin, globalSettings.SocialGithub
		}.Where(s => !string.IsNullOrWhiteSpace(s)).ToArray();
		if (sameAs.Length > 0)
			orgData["sameAs"] = sameAs;

		// knowsAbout — the tenant's own categories describe the entity's topical expertise, which helps
		// Google and AI answer engines disambiguate this brand and pick it for topic-relevant answers.
		var orgTopics = (await CategoryRepo.GetAllAsync(brandingId))
			.Select(c => c.Name)
			.Where(n => !string.IsNullOrWhiteSpace(n))
			.Distinct(StringComparer.OrdinalIgnoreCase)
			.Take(15)
			.ToArray();
		if (orgTopics.Length > 0)
			orgData["knowsAbout"] = orgTopics;

		// WebSite schema — establishes the canonical site name/entity and its publisher.
		var siteData = new System.Collections.Generic.Dictionary<string, object>
		{
			["@context"] = "https://schema.org",
			["@type"] = "WebSite",
			["@id"] = $"{orgBaseUrl}/#website",
			["name"] = siteName,
			["url"] = orgBaseUrl,
			["description"] = siteDescription,
			["inLanguage"] = siteLang,
			["publisher"] = new System.Collections.Generic.Dictionary<string, string> { ["@id"] = $"{orgBaseUrl}/#organization" },
			// SearchAction → Google sitelinks search box (target is the real /search?q= route).
			["potentialAction"] = new System.Collections.Generic.Dictionary<string, object>
			{
				["@type"] = "SearchAction",
				["target"] = new System.Collections.Generic.Dictionary<string, object>
				{
					["@type"] = "EntryPoint",
					["urlTemplate"] = $"{orgBaseUrl}/search?q={{search_term_string}}"
				},
				["query-input"] = "required name=search_term_string"
			}
		};
	}
	<script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(orgData, orgSchema))</script>
	<script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(siteData, orgSchema))</script>
</head>

@{
	var inkwellPreset = GetTheme("inkwell-preset", "cream");
}
<body class="inkwell-root font-sans" data-preset="@inkwellPreset" style="color: var(--fg-body); background: var(--bg);">

	@if (ViewData["HideLayoutChrome"] == null)
	{
		<!-- Header -->
		<div class="relative z-50">
			@await Component.InvokeAsync("Navbar", new { ownerId = brandingId })
		</div>
	}

	<!-- Main Content -->
	<main class="relative">
		@RenderBody()
	</main>

	@if (ViewData["HideLayoutChrome"] == null)
	{
		<!-- Footer -->
		@await Component.InvokeAsync("Footer", new { ownerId = brandingId })
	}

	<!-- Scroll to Top -->
	<a href="#" id="backToTop" class="back-top fixed py-2 px-3 border border-dashed end-4 bottom-4" style="background: var(--muted); border-color: var(--border); color: var(--muted-foreground);" aria-label="Scroll To Top">
		<i class="bi bi-arrow-up"></i>
	</a>

	<script src="~/lib/htmx/htmx.min.js"></script>
	<script>
		// Scroll to top
		(function () {
		var btn = document.getElementById('backToTop');
		if (!btn) return;
		window.addEventListener('scroll', function () {
		btn.classList.toggle('show', window.scrollY > 300);
		});
		btn.addEventListener('click', function (e) {
		e.preventDefault();
		window.scrollTo({ top: 0, behavior: 'smooth' });
		});
		})();
	</script>
	@if (!string.IsNullOrEmpty(_rcfg["ReCaptcha:SiteKey"]))
	{
		<script src="https://www.google.com/recaptcha/api.js" async defer></script>
	}
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
