@*
    Site search for the public header. A <details> element so it works with no JavaScript: the
    summary is the icon button, opening it reveals the form, which GETs /search?q=… Positioned by
    .ink-nav-search in inkwell.css (top-right of whichever header includes it), so every navbar
    variant gets the same control without layout-specific markup.
*@
<details class="ink-nav-search">
    <summary aria-label="Search this site" title="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </summary>
    <form method="get" action="/search" role="search" class="ink-nav-search__form">
        <input type="search" name="q" placeholder="Search articles…" aria-label="Search articles" autocomplete="off" required minlength="2" />
        <button type="submit">Search</button>
    </form>
</details>
<script>
    // Focus the box when opened; close on Escape. Progressive enhancement only.
    (function () {
        var d = document.currentScript && document.currentScript.previousElementSibling;
        if (!d || d.tagName !== 'DETAILS') return;
        d.addEventListener('toggle', function () { if (d.open) { var i = d.querySelector('input'); if (i) i.focus(); } });
        d.addEventListener('keydown', function (e) { if (e.key === 'Escape') { d.open = false; d.querySelector('summary').focus(); } });
    })();
</script>
