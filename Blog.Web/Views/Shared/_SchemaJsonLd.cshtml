@model Blog.Core.Domain.Post
@using System.Text.Json
@{
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var postUrl = $"{baseUrl}/{Model.Slug}";
    var siteName = (string)(ViewData["SiteName"] ?? "");
    var siteLogoUrl = (string)(ViewData["SiteLogoUrl"] ?? "");
    var description = !string.IsNullOrEmpty(Model.MetaDescription)
        ? Model.MetaDescription
        : Blog.Core.Services.TextHelper.SmartTruncate(Model.Plaintext);
    var imageUrl = !string.IsNullOrEmpty(Model.OgImage) ? Model.OgImage
                 : !string.IsNullOrEmpty(Model.FeatureImage) ? Model.FeatureImage
                 : null;
    var wordCount = Model.Plaintext?.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length ?? 0;

    // ── Article / BlogPosting schema ─────────────────────────────────────────
    var authorName = string.IsNullOrEmpty(Model.AuthorName) ? "Anonymous" : Model.AuthorName;
    var author = new Dictionary<string, object> { ["@type"] = "Person", ["name"] = authorName };
    if (!string.IsNullOrEmpty(Model.AuthorSpecialty)) author["jobTitle"] = Model.AuthorSpecialty;
    if (!string.IsNullOrEmpty(Model.AuthorCredentials))
        author["hasCredential"] = new Dictionary<string, string>
        {
            ["@type"] = "EducationalOccupationalCredential",
            ["credentialCategory"] = "degree",
            ["name"] = Model.AuthorCredentials
        };
    var publisher = new Dictionary<string, object>
    {
        ["@type"] = "Organization",
        ["name"] = siteName,
        ["logo"] = new Dictionary<string, string> { ["@type"] = "ImageObject", ["url"] = siteLogoUrl }
    };
    var article = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BlogPosting",
        ["@id"] = postUrl,
        ["headline"] = Model.Title,
        ["description"] = description,
        ["datePublished"] = Model.PublishedAt?.ToString("O") ?? Model.CreatedAt.ToString("O"),
        ["dateModified"] = Model.UpdatedAt.ToString("O"),
        ["wordCount"] = wordCount,
        ["mainEntityOfPage"] = new Dictionary<string, string> { ["@type"] = "WebPage", ["@id"] = postUrl },
        ["author"] = author,
        ["publisher"] = publisher,
        ["inLanguage"] = (string?)(ViewData["SiteLanguage"]) is { Length: > 0 } lang ? lang : "en"
    };
    // The capsule is the passage written to be quoted, so name it explicitly rather than leaving an
    // answer engine to guess which sentence carries the answer.
    if (Model.HasAnswerCapsule) article["abstract"] = Model.AnswerCapsule!;
    if (imageUrl is not null) article["image"] = imageUrl;
    if (Model.Categories.Any()) article["articleSection"] = Model.Categories.First().Name;
    if (Model.Tags.Any()) article["keywords"] = string.Join(", ", Model.Tags.Select(t => t.Name));

    // ── BreadcrumbList schema ────────────────────────────────────────────────
    var items = new List<Dictionary<string, object>>
    {
        new() { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = baseUrl }
    };
    int pos = 2;
    if (Model.Categories.Any())
    {
        var cat = Model.Categories.First();
        items.Add(new() { ["@type"] = "ListItem", ["position"] = pos++, ["name"] = cat.Name, ["item"] = $"{baseUrl}/category/{cat.Slug}" });
    }
    items.Add(new() { ["@type"] = "ListItem", ["position"] = pos, ["name"] = Model.Title, ["item"] = postUrl });

    var breadcrumb = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "BreadcrumbList",
        ["itemListElement"] = items
    };

    // ── FAQPage schema ───────────────────────────────────────────────────────
    Dictionary<string, object>? faqPage = null;
    if (Model.Faqs.Any())
    {
        var questions = Model.Faqs.Select(f => new Dictionary<string, object>
        {
            ["@type"] = "Question",
            ["name"] = f.Question,
            ["acceptedAnswer"] = new Dictionary<string, string>
            {
                ["@type"] = "Answer",
                ["text"] = f.Answer
            }
        }).ToList<object>();

        faqPage = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "FAQPage",
            ["mainEntity"] = questions
        };
    }

    // ── HowTo schema ─────────────────────────────────────────────────────────
    Dictionary<string, object>? howTo = null;
    var howToSteps = Model.HowToSteps
        .Where(s => !string.IsNullOrWhiteSpace(s.Name) || !string.IsNullOrWhiteSpace(s.Text))
        .ToList();
    if (howToSteps.Count > 0)
    {
        var steps = howToSteps.Select((s, i) =>
        {
            var step = new Dictionary<string, object>
            {
                ["@type"] = "HowToStep",
                ["position"] = i + 1,
                ["text"] = string.IsNullOrWhiteSpace(s.Text) ? s.Name : s.Text
            };
            if (!string.IsNullOrWhiteSpace(s.Name)) step["name"] = s.Name;
            return (object)step;
        }).ToList();

        howTo = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "HowTo",
            ["name"] = Model.Title,
            ["step"] = steps
        };
    }

    // ── ItemList + Review schema (Verdict roundup posts) ─────────────────────
    // Each ranked entry becomes a ListItem wrapping the reviewed thing (SoftwareApplication
    // by default), carrying its own single editorial Review + reviewRating. We deliberately do
    // NOT emit an AggregateRating: an aggregate implies many pooled user ratings, and a single
    // editor score dressed up as `ratingCount:1` is a self-serving rating that search engines
    // may flag. One editorial opinion → one Review, never an AggregateRating.
    Dictionary<string, object>? itemList = null;
    var roundup = Model.Roundup;
    if (roundup is not null)
    {
        var listItems = new List<object>();
        foreach (var e in roundup.Ranked)
        {
            var reviewed = new Dictionary<string, object>
            {
                ["@type"] = string.IsNullOrWhiteSpace(roundup.ListType) ? "SoftwareApplication" : roundup.ListType,
                ["name"] = e.Name
            };
            // The product's canonical URL is its real website; fall back to an external CtaUrl.
            // Never claim our internal review page as the product's own URL.
            if (e.HasWebsite) reviewed["url"] = e.Website!;
            else if (e.CtaIsExternal) reviewed["url"] = e.CtaUrl!;
            if (!string.IsNullOrEmpty(e.LogoUrl)) reviewed["image"] = e.LogoUrl;
            if (!string.IsNullOrEmpty(e.Category)) reviewed["applicationCategory"] = e.Category;
            if (!string.IsNullOrEmpty(e.Standout)) reviewed["description"] = e.Standout;

            // First-party product (OptoSoft): list it as a SoftwareApplication but never emit a
            // self-authored Review/AggregateRating — that would be a self-serving rating.
            if (e.Score > 0 && !e.IsFirstParty)
            {
                var review = new Dictionary<string, object>
                {
                    ["@type"] = "Review",
                    ["author"] = author,
                    ["reviewRating"] = new Dictionary<string, object>
                    {
                        ["@type"] = "Rating",
                        ["ratingValue"] = e.Score,
                        ["bestRating"] = 10,
                        ["worstRating"] = 0
                    }
                };
                if (!string.IsNullOrEmpty(e.Body)) review["reviewBody"] = e.Body;
                if (e.Pros.Any())
                    review["positiveNotes"] = new Dictionary<string, object>
                    {
                        ["@type"] = "ItemList",
                        ["itemListElement"] = e.Pros.Select((p, i) => (object)new Dictionary<string, object>
                        {
                            ["@type"] = "ListItem", ["position"] = i + 1, ["name"] = p
                        }).ToList()
                    };
                if (e.Cons.Any())
                    review["negativeNotes"] = new Dictionary<string, object>
                    {
                        ["@type"] = "ItemList",
                        ["itemListElement"] = e.Cons.Select((c, i) => (object)new Dictionary<string, object>
                        {
                            ["@type"] = "ListItem", ["position"] = i + 1, ["name"] = c
                        }).ToList()
                    };

                reviewed["review"] = review;
            }

            listItems.Add(new Dictionary<string, object>
            {
                ["@type"] = "ListItem",
                ["position"] = e.Rank,
                ["item"] = reviewed
            });
        }

        itemList = new Dictionary<string, object>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "ItemList",
            ["name"] = Model.Title,
            ["description"] = description,
            ["numberOfItems"] = listItems.Count,
            ["itemListOrder"] = "https://schema.org/ItemListOrderDescending",
            ["mainEntityOfPage"] = new Dictionary<string, string> { ["@type"] = "WebPage", ["@id"] = postUrl },
            ["itemListElement"] = listItems
        };
    }

    var opts = new JsonSerializerOptions { WriteIndented = false };
}
<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(article, opts))</script>
<script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(breadcrumb, opts))</script>
@if (itemList is not null)
{
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(itemList, opts))</script>
}
@if (faqPage is not null)
{
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(faqPage, opts))</script>
}
@if (howTo is not null)
{
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(howTo, opts))</script>
}
