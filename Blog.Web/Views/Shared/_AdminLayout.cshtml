@using Blog.Web.Models
@inject Blog.Web.Services.DeskShellService DeskShell
@{
    // One service call per request builds everything the shell needs (site name, scheme, avatar, nav, badges);
    // the layout itself never queries a repository (architecture rule: views never query).
    var shell = await DeskShell.GetAsync(User, ViewContext.RouteData.Values);
    var title = ViewData["Title"]?.ToString() ?? "";
    var description = ViewData["Description"]?.ToString();
    var current = shell.Current;
    var crumb = current?.Group;
    var groups = DeskNavigation.GroupOrder.Select(g => (Name: g, Items: shell.Items.Where(i => i.Group == g).ToList())).Where(g => g.Items.Count > 0).ToList();
}
<!DOCTYPE html>
<html lang="en" data-theme="@shell.ColorScheme">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title – @shell.SiteName Desk</title>
    <meta name="robots" content="noindex,nofollow" />

    <!-- Inkwell Fonts (self-hosted) -->
    <link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true" />
    <!-- Desk tokens: light palette plus the dark scheme (prefers-color-scheme: dark and data-theme="dark") -->
    <link rel="stylesheet" href="~/css/desk-tokens.css" asp-append-version="true" />
    <!-- Desk stylesheet: Tailwind compiled at build time from tailwind.desk.config.js + desk.src.css (no runtime compiler) -->
    <link rel="stylesheet" href="~/css/desk.css" asp-append-version="true" />
    <!-- Desk extras and editor skins -->
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <script defer src="~/lib/alpinejs/alpine.min.js"></script>
    @* Sidebar rail preference is applied before first paint so the shell never jumps. *@
    <script>try{if(localStorage.getItem('desk.rail')==='1')document.documentElement.setAttribute('data-desk-rail','true');}catch(e){}</script>
</head>
<body class="min-h-screen flex antialiased bg-background text-foreground">

    <!-- Sidebar -->
    <aside id="sidebar" aria-label="Admin navigation" class="w-64 bg-sidebar border-r border-sidebar-border flex flex-col fixed inset-y-0 left-0 z-50 transition-[transform,width] duration-200 transform -translate-x-full md:translate-x-0">
        <div class="h-14 flex items-center gap-2 px-3 border-b border-sidebar-border">
            <a href="/admin/dashboard" class="flex items-center gap-2.5 min-w-0 rounded-md px-1.5 py-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label="@shell.SiteName dashboard">
                <span class="w-8 h-8 rounded-md bg-sidebar-primary text-sidebar-primary-foreground flex items-center justify-center font-serif text-lg shrink-0" aria-hidden="true">@shell.SiteInitial</span>
                <span class="desk-rail-hide font-semibold text-sidebar-foreground truncate">@shell.SiteName</span>
            </a>
            <button type="button" class="desk-rail-toggle hidden md:inline-flex ml-auto desk-btn desk-btn-ghost desk-btn-icon desk-btn-sm" data-rail-toggle aria-label="Collapse sidebar" aria-pressed="false">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/><polyline points="15 9 13 12 15 15"/></svg>
            </button>
            <button type="button" class="md:hidden ml-auto desk-btn desk-btn-ghost desk-btn-icon desk-btn-sm" data-nav-close aria-label="Close menu">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <nav class="flex-1 overflow-y-auto py-3 px-2 space-y-4">
            @{
                var controller = ViewContext.RouteData.Values["controller"]?.ToString();
                var action = ViewContext.RouteData.Values["action"]?.ToString();
                // The active item is announced, not just coloured: aria-current="page" on the link.
                string? NavCurrent(DeskNavigation.Item item) => item == current ? "page" : null;
                string NavClass(DeskNavigation.Item item) => "desk-nav-link";
            }
            @foreach (var group in groups)
            {
                var groupId = "nav-" + group.Name.ToLowerInvariant();
                var isHome = group.Name == DeskNavigation.Content;
                <div class="desk-nav-group" data-nav-group="@group.Name" data-collapsed="false">
                    @if (!isHome)
                    {
                        <button type="button" class="desk-nav-group-toggle" data-nav-group-toggle aria-expanded="true" aria-controls="@groupId" title="@group.Name">
                            <span class="desk-rail-hide">@group.Name</span>
                            <svg class="desk-nav-chevron desk-rail-hide" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                        </button>
                    }
                    <div id="@groupId" class="desk-nav-group-items space-y-0.5">
                        @foreach (var item in group.Items)
                        {
                            var badge = shell.BadgeFor(item);
                            <a href="@item.Href" class="@NavClass(item)" aria-current="@NavCurrent(item)" title="@item.Label">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(item.Icon)</svg>
                                <span class="desk-rail-hide flex-1 truncate">@item.Label</span>
                                @if (badge > 0)
                                {
                                    <span class="desk-badge desk-rail-hide pill-warn border" aria-label="@badge waiting">@(badge > 99 ? "99+" : badge.ToString())</span>
                                }
                            </a>
                        }
                    </div>
                </div>
            }
        </nav>

        <div class="p-3 border-t border-sidebar-border space-y-2">
            <button type="button" class="desk-btn desk-btn-outline desk-btn-sm w-full justify-between" data-cmdk-open aria-label="Open command palette" title="Jump to… (Ctrl K)">
                <span class="flex items-center gap-2 desk-rail-hide"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">@Html.Raw(DeskNavigation.IcSearch)</svg> Jump to…</span>
                <svg class="hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">@Html.Raw(DeskNavigation.IcSearch)</svg>
                <span class="desk-kbd desk-rail-hide" aria-hidden="true">Ctrl K</span>
            </button>
            <p class="text-center text-[11px] text-muted-foreground desk-rail-hide" data-app-version>Inkwell @Blog.Web.Services.AppVersion.Current</p>
        </div>
    </aside>

    <!-- Overlay for mobile -->
    <div id="sidebar-overlay" data-nav-close class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

    <!-- Main Content -->
    <main id="desk-main" class="flex-1 min-w-0 md:ml-64 flex flex-col min-h-screen transition-[margin] duration-200">
        <!-- Topbar -->
        <header class="h-14 flex items-center justify-between gap-3 px-4 sm:px-6 border-b border-border bg-background/95 backdrop-blur sticky top-0 z-30">
            <div class="flex items-center gap-2 min-w-0">
                <button type="button" class="md:hidden desk-btn desk-btn-ghost desk-btn-icon" data-nav-open aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
                </button>
                <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-sm text-muted-foreground min-w-0">
                    @if (!string.IsNullOrEmpty(crumb))
                    {
                        <span class="hidden sm:inline">@crumb</span>
                        <svg class="hidden sm:inline" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                    }
                    @if (current is not null && current.Label != title)
                    {
                        <a href="@current.Href" class="hover:text-foreground">@current.Label</a>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
                    }
                    <span class="text-foreground font-medium truncate" aria-current="page">@title</span>
                </nav>
            </div>
            <div class="flex items-center gap-1 sm:gap-2">
                <button type="button" class="desk-btn desk-btn-ghost desk-btn-icon" data-cmdk-open aria-label="Jump to… (Ctrl K)" title="Jump to… (Ctrl K)">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">@Html.Raw(DeskNavigation.IcSearch)</svg>
                </button>
                <a href="/" target="_blank" rel="noopener" class="desk-btn desk-btn-ghost desk-btn-icon hidden sm:inline-flex" aria-label="View site (opens in a new tab)" title="View site">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">@Html.Raw(DeskNavigation.IcExternal)</svg>
                </a>
                <details class="desk-menu" data-desk-menu>
                    <summary class="flex items-center gap-2 rounded-full pl-0.5 pr-2 py-0.5 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring" aria-label="Account menu for @shell.UserName" title="Account">
                        <span class="w-8 h-8 rounded-full overflow-hidden bg-muted border border-border shrink-0">
                            <img src="@shell.AvatarUrl" alt="" class="w-full h-full object-cover" loading="lazy" />
                        </span>
                        <span class="hidden sm:block text-sm font-medium max-w-[10rem] truncate">@shell.UserName</span>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="text-muted-foreground hidden sm:block"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <div class="desk-menu-panel w-56">
                        <div class="px-2 py-1.5">
                            <p class="text-sm font-medium truncate">@shell.UserName</p>
                            @if (!string.IsNullOrEmpty(shell.RoleLabel)) { <p class="text-xs text-muted-foreground">@shell.RoleLabel</p> }
                        </div>
                        <div class="desk-menu-sep"></div>
                        <a href="/account/profile" class="desk-menu-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg> Profile</a>
                        <a href="/account/security" class="desk-menu-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Two-factor sign-in</a>
                        <a href="/admin/settings#s-general" class="desk-menu-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg> Colour scheme: @shell.ColorScheme</a>
                        <a href="/" target="_blank" rel="noopener" class="desk-menu-item"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">@Html.Raw(DeskNavigation.IcExternal)</svg> View site</a>
                        <div class="desk-menu-sep"></div>
                        <form method="post" asp-controller="Account" asp-action="Logout">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="desk-menu-item desk-menu-item-danger">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg> Log out
                            </button>
                        </form>
                    </div>
                </details>
            </div>
        </header>

        <!-- Page Content -->
        <div class="p-4 sm:p-6 lg:p-8 w-full max-w-[88rem] mx-auto flex-1">
            <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 max-w-sm w-full" style="pointer-events: none;">
                @if (TempData["Success"] != null)
                {
                    <div id="toast-success" role="status" aria-live="polite" class="desk-toast toast-ok p-4 rounded-lg border border-border bg-card text-card-foreground flex items-center gap-2 shadow-pop animate-slide-in-right pointer-events-auto">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tone-ok shrink-0" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                        <span>@TempData["Success"]</span>
                        <button type="button" aria-label="Dismiss notification" title="Dismiss" data-toast-dismiss class="ml-auto pl-2 text-muted-foreground hover:text-foreground"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div id="toast-error" role="alert" class="desk-toast toast-bad p-4 rounded-lg border border-border bg-card text-card-foreground flex items-center gap-2 shadow-pop animate-slide-in-right pointer-events-auto">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tone-bad shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                        <span>@TempData["Error"]</span>
                        <button type="button" aria-label="Dismiss notification" title="Dismiss" data-toast-dismiss class="ml-auto pl-2 text-muted-foreground hover:text-foreground"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div id="toast-warning" role="alert" class="desk-toast toast-warn p-4 rounded-lg border border-border bg-card text-card-foreground flex items-center gap-2 shadow-pop animate-slide-in-right pointer-events-auto">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tone-warn shrink-0" aria-hidden="true"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                        <span>@TempData["Warning"]</span>
                        <button type="button" aria-label="Dismiss notification" title="Dismiss" data-toast-dismiss class="ml-auto pl-2 text-muted-foreground hover:text-foreground"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    foreach (var modelStateKey in ViewData.ModelState.Keys)
                    {
                        var modelStateVal = ViewData.ModelState[modelStateKey];
                        if (modelStateVal is null) { continue; }
                        foreach (var error in modelStateVal.Errors)
                        {
                            <div role="alert" class="toast-model-error desk-toast toast-bad p-4 rounded-lg border border-border bg-card text-card-foreground flex items-center gap-2 shadow-pop animate-slide-in-right pointer-events-auto">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tone-bad shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                                <span>@error.ErrorMessage</span>
                                <button type="button" aria-label="Dismiss notification" title="Dismiss" data-toast-dismiss class="ml-auto pl-2 text-muted-foreground hover:text-foreground"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
                            </div>
                        }
                    }
                }
            </div>

            @* Only the success toast fades. Error and warning toasts are role="alert" and stay until dismissed, so a failed save is never missed. *@
            <script>
                setTimeout(() => {
                    document.getElementById('toast-success')?.remove();
                }, 8000);
            </script>

            @* ── Desk dialog: the styled replacement for the browser's native popups; logic in wwwroot/js/inkwell-dialog.js ── *@
            <dialog id="inkwell-dialog" class="rounded-xl border border-border bg-card text-card-foreground shadow-pop p-0 w-full max-w-md backdrop:bg-black/50 backdrop:backdrop-blur-[2px]" aria-labelledby="ikd-title" aria-describedby="ikd-body">
                <form id="ikd-form" method="dialog" class="p-6">
                    <div class="flex items-start gap-4">
                        <div id="ikd-icon" class="w-9 h-9 rounded-full flex items-center justify-center text-base font-bold shrink-0 pill-info border">?</div>
                        <div class="min-w-0 flex-1">
                            <h2 id="ikd-title" class="text-base font-semibold leading-snug">Confirm this action?</h2>
                            <p id="ikd-body" class="text-sm text-muted-foreground mt-1.5 leading-relaxed"></p>
                            <div id="ikd-input-wrap" class="mt-4" hidden>
                                <label id="ikd-input-label" for="ikd-input" class="desk-label text-xs text-muted-foreground"></label>
                                <input id="ikd-input" type="text" autocomplete="off" spellcheck="false" class="desk-input" />
                                <p id="ikd-input-hint" class="text-xs mt-1 min-h-[1rem]"></p>
                            </div>
                            <div id="ikd-typed-wrap" class="mt-4" hidden>
                                <label for="ikd-typed" class="desk-label text-xs text-muted-foreground">Type <code id="ikd-typed-word" class="font-mono font-semibold text-foreground"></code> to confirm</label>
                                <input id="ikd-typed" type="text" autocomplete="off" spellcheck="false" class="desk-input font-mono" />
                            </div>
                        </div>
                    </div>
                    <div class="mt-6 flex justify-end gap-2">
                        <button type="button" id="ikd-cancel" class="desk-btn desk-btn-outline">Cancel</button>
                        <button type="button" id="ikd-ok" class="desk-btn desk-btn-primary">Confirm</button>
                    </div>
                </form>
            </dialog>
            <script src="~/js/inkwell-dialog.js" asp-append-version="true"></script>

            @* ── Command palette (Ctrl/Cmd K): navigation, quick actions and a post search, built from DeskNavigation ── *@
            <dialog id="desk-cmdk" class="rounded-xl border border-border bg-popover text-popover-foreground shadow-pop p-0 w-full max-w-lg backdrop:bg-black/50 backdrop:backdrop-blur-[2px] mt-[10vh]" aria-label="Jump to">
                <div class="flex items-center gap-2 px-3 border-b border-border">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-muted-foreground shrink-0" aria-hidden="true">@Html.Raw(DeskNavigation.IcSearch)</svg>
                    <input id="desk-cmdk-input" type="text" autocomplete="off" spellcheck="false" placeholder="Jump to a screen or action…" aria-label="Jump to a screen or action" aria-controls="desk-cmdk-list" aria-autocomplete="list" role="combobox" aria-expanded="true" class="w-full h-12 bg-transparent text-sm focus:outline-none placeholder:text-muted-foreground" />
                    <span class="desk-kbd" aria-hidden="true">Esc</span>
                </div>
                <div id="desk-cmdk-list" role="listbox" class="max-h-[60vh] overflow-y-auto p-2" aria-label="Results"></div>
                <p id="desk-cmdk-empty" class="px-4 py-6 text-sm text-center text-muted-foreground" hidden>No match. Press Enter to search posts instead.</p>
            </dialog>
            <script type="application/json" id="desk-cmdk-data">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
                items = shell.Items.Select(i => new { group = i.Group, label = i.Label, href = i.Href, icon = i.Icon, keywords = i.Keywords ?? "" }),
                commands = shell.Commands.Select(c => new { group = "Actions", label = c.Label, href = c.Href, icon = c.Icon, keywords = c.Keywords ?? "" }),
                search = "/admin/posts?search="
            }))</script>

            @* Busy bar for form posts, htmx requests and uploads; unsaved-changes guard for editors. *@
            <div id="desk-busy" role="progressbar" aria-hidden="true"></div>
            <script src="~/js/inkwell-desk.js" asp-append-version="true"></script>

            @* ── Page header: every screen gets the same title block; a view adds ViewData["Description"] and an optional PageActions section ── *@
            @if (ViewData["HideHeader"] as bool? != true)
            {
                <header class="desk-page-header">
                    <div class="min-w-0">
                        <h1 class="desk-page-title">@title</h1>
                        @if (!string.IsNullOrEmpty(description)) { <p class="desk-page-description">@description</p> }
                    </div>
                    @if (IsSectionDefined("PageActions"))
                    {
                        <div class="desk-page-actions">@await RenderSectionAsync("PageActions", required: false)</div>
                    }
                </header>
            }
            else if (IsSectionDefined("PageActions"))
            {
                @await RenderSectionAsync("PageActions", required: false)
            }

            @RenderBody()
        </div>
    </main>

    <script src="~/lib/htmx/htmx.min.js"></script>
    @* Placed errors (design rule 12): on load, scroll the first field-level validation message into view and focus its input. Works for every editor without per-view code. *@
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var msgs = document.querySelectorAll('.field-validation-error, [data-valmsg-for]');
            var first = null;
            for (var i = 0; i < msgs.length; i++) { if (msgs[i].textContent.trim()) { first = msgs[i]; break; } }
            var field = null;
            if (first) {
                var name = first.getAttribute('data-valmsg-for');
                var scope = first.closest('form') || document;
                if (name) { field = scope.querySelector('[name="' + name.replace(/"/g, '\\"') + '"]'); }
                if (!field && first.parentElement) { field = first.parentElement.querySelector('input:not([type=hidden]), select, textarea'); }
                first.scrollIntoView({ block: 'center' });
            } else {
                field = document.querySelector('.input-validation-error, [aria-invalid="true"]');
                if (!field) { return; }
                field.scrollIntoView({ block: 'center' });
            }
            if (field) { try { field.focus({ preventScroll: true }); } catch (e) { } }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
