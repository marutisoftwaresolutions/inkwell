@*
    Search box for an admin list. GET form on the current URL: ?q=…, page resets to 1.
    ViewData["ListSearchPlaceholder"] sets the placeholder; ViewData["ListSearchKeep"] is a
    dictionary of other query values to preserve (tab, status…) as hidden inputs.
*@
@{
    var q = ViewData[Blog.Web.Models.ListPaging.QueryKey] as string ?? "";
    var total = ViewData[Blog.Web.Models.ListPaging.TotalKey] as int? ?? 0;
    var shown = ViewData[Blog.Web.Models.ListPaging.ShownKey] as int? ?? 0;
    var placeholder = ViewData["ListSearchPlaceholder"] as string ?? "Search…";
    var keep = ViewData["ListSearchKeep"] as IDictionary<string, string?> ?? new Dictionary<string, string?>();
}
<form method="get" class="flex flex-wrap items-center gap-2 mb-4" role="search">
    @foreach (var kv in keep.Where(kv => !string.IsNullOrEmpty(kv.Value)))
    {
        <input type="hidden" name="@kv.Key" value="@kv.Value" />
    }
    <div class="relative">
        <input type="search" name="q" value="@q" placeholder="@placeholder" aria-label="@placeholder"
               class="w-full sm:w-72 pl-9 pr-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
        <svg class="absolute left-3 top-2.5 h-4 w-4 text-muted-foreground pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    </div>
    <button type="submit" class="h-9 px-3 rounded-md border border-input bg-background text-sm hover:bg-muted">Search</button>
    @if (!string.IsNullOrEmpty(q))
    {
        <a href="?@string.Join("&", keep.Where(kv => !string.IsNullOrEmpty(kv.Value)).Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value!)}"))" class="h-9 px-3 rounded-md text-sm text-muted-foreground hover:text-foreground inline-flex items-center">Clear</a>
        <span class="text-xs text-muted-foreground">@total match@(total == 1 ? "" : "es") for “@q”@(shown < total ? $", showing {shown}" : "")</span>
    }
    else if (total > 0)
    {
        <span class="text-xs text-muted-foreground">@total total@(shown < total ? $", showing {shown}" : "")</span>
    }
</form>
