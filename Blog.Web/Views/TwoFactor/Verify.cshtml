@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Two-Factor Sign-In";
    var error = ViewBag.Error as string;
}
<div class="text-center mb-6">
    <h1 class="text-2xl font-bold">Enter your code</h1>
    <p class="text-muted-foreground text-sm mt-1">Open your authenticator app and enter the 6-digit code it shows for this site.</p>
</div>

@if (error is not null)
{
    <p id="code-error" role="alert" class="mb-6 p-3 rounded border border-destructive text-destructive text-sm">@error</p>
}

<form method="post" action="/account/two-factor" class="space-y-5" autocomplete="off" id="code-form">
    @Html.AntiForgeryToken()
    <div>
        <label for="code" class="block text-sm font-medium mb-1.5">Code</label>
        <input type="text" name="code" id="code" inputmode="numeric" autocomplete="one-time-code" maxlength="14" required autofocus
               aria-invalid="@(error is null ? "false" : "true")" aria-describedby="@(error is null ? "code-help" : "code-error code-help")"
               class="w-full px-3 py-2 bg-background border border-input rounded text-lg tracking-widest font-mono focus:outline-none focus:ring-2 focus:ring-ring" />
        <p id="code-help" class="text-xs text-muted-foreground mt-1.5">Lost your phone? Enter one of your recovery codes here instead, for example <span class="font-mono">k7m2q-x9hr4</span>.</p>
    </div>
    <button type="submit" id="code-submit" class="w-full py-2.5 bg-primary text-primary-foreground font-semibold rounded hover:opacity-90 transition-opacity focus-visible:ring-2 focus-visible:ring-ring">Sign in</button>
    <p class="text-center text-sm text-muted-foreground"><a href="/account/login" class="underline underline-offset-2 text-foreground">Use a different account</a></p>
</form>

@section Scripts {
<script>
(function () {
    // One submission per click: a double-click would spend two of the five tries.
    var form = document.getElementById('code-form'), btn = document.getElementById('code-submit');
    if (form && btn) form.addEventListener('submit', function () { btn.disabled = true; btn.setAttribute('aria-busy', 'true'); btn.textContent = 'Checking…'; });
})();
</script>
}
