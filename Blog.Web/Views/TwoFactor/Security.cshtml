@model Blog.Core.Domain.UserTwoFactor?
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Two-Factor Sign-In";
    var on = Model?.IsEnabled == true;
    var required = ViewBag.Required is true;
    int left = ViewBag.CodesLeft ?? 0;
    // A wrong code or password comes back as "field|message" and is shown at that field.
    var fieldError = (TempData["FieldError"] as string)?.Split('|', 2);
    string? ErrorFor(string id) => fieldError is { Length: 2 } && fieldError[0] == id ? fieldError[1] : null;
    var regenError = ErrorFor("regen-code");
    var disableError = ErrorFor("disable-password");
}
<div class="max-w-2xl flex flex-col gap-6">
    <div class="desk-card p-5 flex flex-col gap-3">
        <div class="flex flex-wrap items-center gap-3">
            <h2 class="desk-card-title">Two-factor sign-in</h2>
            <span class="desk-pill @(on ? "pill-ok" : "pill-warn")">@(on ? "On" : "Off")</span>
            @if (required)
            {
                <span class="text-xs text-muted-foreground">Required for your role on this site.</span>
            }
        </div>
        @if (on)
        {
            <p class="text-sm text-muted-foreground">
                Turned on @Dates.Medium(Model!.EnabledAt). After your password you enter a code from your authenticator app.
                You have <strong class="text-foreground">@left</strong> unused recovery @(left == 1 ? "code" : "codes").
            </p>
        }
        else
        {
            <p class="text-sm text-muted-foreground">
                Add a second step to signing in: a 6-digit code from an authenticator app on your phone. Someone who learns your password still can't get in.
            </p>
            <div><a href="/account/two-factor/setup" class="desk-btn desk-btn-primary">Set up two-factor sign-in</a></div>
        }
    </div>

    @if (on)
    {
        <form method="post" action="/account/two-factor/recovery-codes" class="desk-card p-5 flex flex-col gap-3"
              data-confirm-title="Create new recovery codes?"
              data-confirm-body="Your current recovery codes stop working straight away. You'll see the new ones once, on the next page."
              data-confirm-action="Create new codes" data-confirm-tone="warning">
            @Html.AntiForgeryToken()
            <h2 class="desk-card-title">New recovery codes</h2>
            <p class="text-sm text-muted-foreground">For when you've used some, or lost the list. Confirm with a code from your app.</p>
            <div class="flex flex-wrap items-end gap-3">
                <div class="space-y-1">
                    <label for="regen-code" class="desk-label">6-digit code</label>
                    <input id="regen-code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required autofocus="@(regenError is not null)"
                           aria-invalid="@(regenError is null ? "false" : "true")" aria-describedby="@(regenError is null ? null : "regen-code-error")"
                           class="desk-input w-40 font-mono tracking-widest" />
                    @if (regenError is not null) { <p id="regen-code-error" class="desk-error">@regenError</p> }
                </div>
                <button type="submit" class="desk-btn desk-btn-outline">Create new codes</button>
            </div>
        </form>

        @if (!required)
        {
            <form method="post" action="/account/two-factor/disable" class="desk-card p-5 flex flex-col gap-3"
                  data-confirm-title="Turn off two-factor sign-in?"
                  data-confirm-body="Signing in will need only your password again, and your recovery codes stop working. You can set it up again at any time."
                  data-confirm-action="Turn off" data-confirm-tone="danger">
                @Html.AntiForgeryToken()
                <h2 class="desk-card-title">Turn off</h2>
                <div class="flex flex-wrap items-end gap-3">
                    <div class="space-y-1">
                        <label for="disable-password" class="desk-label">Your password</label>
                        <input id="disable-password" name="password" type="password" autocomplete="current-password" required autofocus="@(disableError is not null)"
                               aria-invalid="@(disableError is null ? "false" : "true")" aria-describedby="@(disableError is null ? null : "disable-password-error")"
                               class="desk-input w-64" />
                        @if (disableError is not null) { <p id="disable-password-error" class="desk-error">@disableError</p> }
                    </div>
                    <button type="submit" class="desk-btn desk-btn-danger-outline">Turn off two-factor sign-in</button>
                </div>
            </form>
        }
    }
</div>
