@using System.Security.Claims
@using Blog.Web.Models
@model List<Blog.Core.Domain.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";
    ViewData["Description"] = "Manage user accounts and assign roles.";
    var allRoles = (List<Blog.Core.Domain.Role>)ViewBag.AllRoles;
    var userRoles = (Dictionary<Guid, string>)ViewBag.UserRoles;
    var currentUserIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    Guid.TryParse(currentUserIdStr, out var currentUserId);
    var isAdmin = User.IsInRole("Admin");
    var listQuery = ViewData[ListPaging.QueryKey] as string;

    // Reading TempData consumes it, so the password panel renders exactly once and never on refresh.
    var invitePassword = TempData["InvitePassword"] as string;
    var inviteEmail = TempData["InviteEmail"] as string;
}

@section PageActions {
    @if (isAdmin)
    {
        <a href="#invite-user" class="desk-btn desk-btn-primary">Invite user</a>
    }
}

<div class="max-w-5xl mx-auto">
    @if (!allRoles.Any())
    {
        <div class="rounded-lg border p-4 mb-6 pill-bad">
            <p class="text-sm font-medium">Roles and permissions are not seeded yet. <a href="/admin/dashboard/seed" class="underline font-semibold">Seed roles and permissions</a> before assigning roles.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(invitePassword))
    {
    <!-- One-time password panel: rendered only on the redirect after a successful invite -->
    <section id="invite-once" class="desk-card p-5 mb-6" role="status" aria-labelledby="invite-once-title" aria-describedby="invite-once-body">
        <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-full flex items-center justify-center text-base font-bold shrink-0 pill-warn border" aria-hidden="true">!</div>
            <div class="flex-1 min-w-0">
                <h2 id="invite-once-title" class="desk-card-title">Password for @inviteEmail</h2>
                <p id="invite-once-body" class="text-sm mt-1 text-muted-foreground">Copy it now and pass it on securely. It is shown only this once and cannot be read back later; if it is lost, a new one has to be set. Nothing has been emailed.</p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                    <code id="invite-once-password" class="px-3 py-2 rounded-md border border-border bg-muted text-foreground font-mono text-sm select-all">@invitePassword</code>
                    <button type="button" id="invite-once-copy" class="desk-btn desk-btn-primary">Copy password</button>
                </div>
            </div>
            <button type="button" id="invite-once-dismiss" aria-label="Dismiss password panel" class="desk-btn desk-btn-ghost desk-btn-icon desk-btn-sm"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
        </div>
    </section>
    }

    @if (isAdmin)
    {
    <!-- Invite Author Form -->
    <div id="invite-user" class="desk-card mb-6 scroll-mt-16">
        <div class="desk-card-header">
            <h2 class="desk-card-title">Invite author</h2>
            <p class="desk-card-description">Create an account for a new author. The password is shown to you once after the account is created; nothing is emailed.</p>
        </div>
        <form method="post" action="/admin/users/invite" class="desk-card-body flex flex-wrap items-end gap-3">
            @Html.AntiForgeryToken()
            <div class="flex-1 min-w-[150px]">
                <label for="invite-name" class="desk-label">Display name *</label>
                <input type="text" id="invite-name" name="displayName" autocomplete="off" placeholder="Jane Doe" class="desk-input" required />
            </div>
            <div class="flex-1 min-w-[150px]">
                <label for="invite-email" class="desk-label">Email *</label>
                <input type="email" id="invite-email" name="email" autocomplete="off" placeholder="jane@example.com" class="desk-input" required />
            </div>
            <div class="flex-1 min-w-[240px]">
                <label for="invite-password" class="desk-label">Password</label>
                <div class="flex items-stretch gap-1">
                    <input type="password" id="invite-password" name="password" autocomplete="new-password" minlength="8" placeholder="Leave blank to generate one" aria-describedby="invite-password-hint" class="desk-input min-w-0 font-mono" />
                    <button type="button" id="invite-password-toggle" aria-pressed="false" aria-label="Show password" aria-controls="invite-password" class="desk-btn desk-btn-outline desk-btn-icon shrink-0"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
                    <button type="button" id="invite-password-generate" class="desk-btn desk-btn-outline shrink-0">Generate</button>
                </div>
                <p id="invite-password-hint" class="desk-hint">At least 8 characters. Leave it blank and one is generated for you.</p>
            </div>
            <div class="min-w-[100px]">
                <label for="invite-role" class="desk-label">Role</label>
                <select id="invite-role" name="roleName" class="desk-select">
                    <option value="Author">Author</option>
                    <option value="Editor">Editor</option>
                    <option value="Contributor">Contributor</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <button type="submit" class="desk-btn desk-btn-primary">
                Add user
            </button>
        </form>
    </div>
    }

    <div class="desk-card overflow-hidden">
        <partial name="_ListSearch" />
        @if (Model.Count == 0)
        {
            if (!string.IsNullOrEmpty(listQuery))
            {
                ViewData["EmptyQuery"] = listQuery;
                ViewData["EmptyClearHref"] = "/admin/users";
            }
            else
            {
                ViewData["EmptyTitle"] = "No other users yet.";
                ViewData["EmptyHint"] = isAdmin ? "Invite an author above to give someone else access to the Desk." : "Accounts you create appear here.";
                if (isAdmin) { ViewData["EmptyHref"] = "#invite-user"; ViewData["EmptyAction"] = "Invite user"; }
            }
            <partial name="_EmptyState" />
        }
        else
        {
<div class="table-scroll"><table class="desk-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Status</th>
                    <th class="text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var currentRole = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "None";
                    var displayName = user.DisplayName ?? user.Username ?? "This user";
                    var isSelf = user.Id == currentUserId;
                    <tr>
                        <td>
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full overflow-hidden flex-shrink-0">
                                    <img src="@(!string.IsNullOrEmpty(user.AvatarUrl) ? user.AvatarUrl : $"/avatar/{System.Net.WebUtility.UrlEncode(user.DisplayName ?? "U")}")" alt="" class="w-full h-full object-cover" loading="lazy" />
                                </div>
                                <div>
                                    <p class="font-medium">@(user.DisplayName ?? user.Username ?? "Unknown") @if (isSelf) { <span class="text-xs font-normal text-muted-foreground">(you)</span> }</p>
                                    <p class="text-xs text-muted-foreground">@("@")@(user.Username)</p>
                                </div>
                            </div>
                        </td>
                        <td class="text-muted-foreground">@user.Email</td>
                        <td>
                            @if (isAdmin && allRoles.Any())
                            {
                                @* No auto-submit: the role only changes after an explicit Change click and a confirmation
                                   that names the old and new role. The script below fills the dialog copy per selection;
                                   the static attributes are the fallback so the dialog is never skipped. *@
                                <form method="post" action="/admin/users/update-role" class="flex items-center gap-2" data-role-form data-user-name="@displayName" data-confirm-title="Change this user's role?" data-confirm-body="@displayName gets the permissions of the new role the next time they sign in." data-confirm-action="Change role" data-confirm-tone="warning">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <label for="role-@user.Id" class="sr-only">Role for @displayName</label>
                                    <select id="role-@user.Id" name="roleName" data-current="@currentRole" class="desk-select desk-select-sm w-auto">
                                        @foreach (var role in allRoles)
                                        {
                                            <option value="@role.Name" data-description="@role.Description" selected="@(currentRole == role.Name)">@role.Name</option>
                                        }
                                    </select>
                                    <button type="submit" disabled aria-label="Change role for @displayName" class="desk-btn desk-btn-outline desk-btn-sm">Change</button>
                                </form>
                            }
                            else
                            {
                                <span class="desk-pill desk-pill-muted">@currentRole</span>
                            }
                        </td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="desk-pill pill-ok">Active</span>
                            }
                            else
                            {
                                <span class="desk-pill pill-bad">Disabled</span>
                            }
                            @if (user.TwoFactorEnabled)
                            {
                                <span class="desk-pill pill-ok ml-1" title="Signs in with an authenticator app code">2FA<span class="sr-only">: two-factor sign-in on</span></span>
                            }
                        </td>
                        <td class="text-right whitespace-nowrap">
                            @* Never offered on your own row: disabling yourself locks you out. The controller refuses it too. *@
                            @if (isAdmin && !isSelf)
                            {
                                if (user.TwoFactorEnabled)
                                {
                                <form method="post" action="/account/two-factor/reset/@user.Id" class="inline mr-2" data-confirm-title="Turn off two-factor sign-in for this user?" data-confirm-body="Use this when @displayName has lost their phone and their recovery codes. They sign in with a password only until they set it up again; if their role requires it, they are asked to at their next visit to the Desk." data-confirm-action="Turn off two-factor" data-confirm-tone="warning">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="desk-btn desk-btn-outline desk-btn-sm">Reset 2FA<span class="sr-only"> for @displayName</span></button>
                                </form>
                                }
                                if (user.IsActive)
                                {
                                <form method="post" action="/admin/users/toggle-active" class="inline" data-confirm-title="Disable this user?" data-confirm-body="@displayName is signed out and cannot sign in until re-enabled. Their posts, pages and comments stay." data-confirm-action="Disable user" data-confirm-tone="warning">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" aria-label="Disable @displayName" class="desk-btn desk-btn-outline desk-btn-sm">Disable</button>
                                </form>
                                }
                                else
                                {
                                <form method="post" action="/admin/users/toggle-active" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" aria-label="Enable @displayName" class="desk-btn desk-btn-outline desk-btn-sm">Enable</button>
                                </form>
                                }
                            }

                            @{
                                bool canDelete = false;
                                if (!isSelf)
                                {
                                    if (isAdmin) canDelete = true;
                                    else if (user.CreatedByUserId == currentUserId && user.Role != "Admin" && user.Role != "Editor") canDelete = true;
                                }
                            }
                            @if (canDelete)
                            {
                                <form method="post" action="/admin/users/delete" class="inline ml-2" data-confirm-title="Delete this user?" data-confirm-body="@displayName (@user.Email) loses access immediately and their profile is removed. This cannot be undone." data-confirm-action="Delete user" data-confirm-tone="danger">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" aria-label="Delete @displayName" class="desk-btn desk-btn-danger-outline desk-btn-sm">
                                        Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
        }
<partial name="_ListPager" />
    </div>

    <div class="mt-6 rounded-lg border p-4 pill-info text-sm">
        <strong>Note:</strong> Blog visitors (consumers) can read posts and leave comments without any account. Roles only control access to the admin panel.
        After changing a user's role, they must <strong>log out and back in</strong> for the new permissions to take effect.
    </div>

    <details class="mt-6 text-sm text-muted-foreground">
        <summary class="cursor-pointer">Development helpers</summary>
        <div class="mt-2 flex flex-wrap items-center gap-3">
            <span>Seeds the default roles, permissions and sample content on a fresh install. Not needed on a configured site.</span>
            <a href="/admin/dashboard/seed" class="desk-btn desk-btn-outline desk-btn-sm">Seed data</a>
        </div>
    </details>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    /* -- Invite form: show/hide and generate ------------------------------------------------
       The alphabet mirrors Blog.Core.Services.PasswordGenerator (no 0 O 1 l I); keep them in step. */
    var pw = document.getElementById('invite-password');
    var toggle = document.getElementById('invite-password-toggle');
    var gen = document.getElementById('invite-password-generate');

    function setVisible(show) {
        pw.type = show ? 'text' : 'password';
        toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
        toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    }

    var LOWER = 'abcdefghijkmnopqrstuvwxyz', UPPER = 'ABCDEFGHJKLMNPQRSTUVWXYZ', DIGITS = '23456789';
    var ALL = LOWER + UPPER + DIGITS;

    // Unbiased integer in [0, n) from crypto.getRandomValues (rejection sampling, no modulo bias).
    function randInt(n) {
        var limit = Math.floor(4294967296 / n) * n;
        var buf = new Uint32Array(1);
        do { crypto.getRandomValues(buf); } while (buf[0] >= limit);
        return buf[0] % n;
    }
    function pick(set) { return set.charAt(randInt(set.length)); }
    function generate(len) {
        var chars = [pick(LOWER), pick(UPPER), pick(DIGITS)];
        while (chars.length < len) chars.push(pick(ALL));
        for (var i = chars.length - 1; i > 0; i--) { var j = randInt(i + 1); var t = chars[i]; chars[i] = chars[j]; chars[j] = t; }
        return chars.join('');
    }

    if (pw && toggle && gen) {
        toggle.addEventListener('click', function () { setVisible(pw.type === 'password'); });
        gen.addEventListener('click', function () {
            pw.value = generate(16);
            setVisible(true);
            pw.focus();
        });
    }

    /* -- One-time password panel: copy and dismiss ---------------------------------------- */
    var once = document.getElementById('invite-once');
    var copy = document.getElementById('invite-once-copy');
    var code = document.getElementById('invite-once-password');
    var dismiss = document.getElementById('invite-once-dismiss');
    if (once && copy && code) {
        copy.addEventListener('click', function () {
            var text = code.textContent.trim();
            var done = function () { copy.textContent = 'Copied'; InkwellDialog.toast('success', 'Password copied.'); };
            var fallback = function () {
                var range = document.createRange(); range.selectNodeContents(code);
                var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
                InkwellDialog.toast('warning', 'Copy is blocked in this browser. The password is selected; press Ctrl+C.');
            };
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback);
            else fallback();
        });
        if (dismiss) dismiss.addEventListener('click', function () { once.remove(); });
    }

    /* -- Role change: explicit Change button + dialog copy per selection ------------------ */
    document.querySelectorAll('form[data-role-form]').forEach(function (form) {
        var select = form.querySelector('select[name="roleName"]');
        var button = form.querySelector('button[type="submit"]');
        if (!select || !button) return;
        var name = form.dataset.userName || 'This user';
        var current = select.dataset.current || '';

        function sync() {
            var next = select.value;
            var changed = next !== current;
            button.disabled = !changed;
            if (!changed) return;
            var opt = select.options[select.selectedIndex];
            var desc = (opt && opt.dataset.description) ? opt.dataset.description
                     : (next === 'Admin' ? 'Full access to users, settings and all content' : '');
            form.dataset.confirmTitle = 'Change role to ' + next + '?';
            form.dataset.confirmBody = name + ' moves from ' + current + ' to ' + next + '.'
                + (desc ? ' ' + next + ': ' + desc + '.' : '')
                + ' The new permissions apply the next time they sign in.';
            form.dataset.confirmAction = 'Change to ' + next;
            form.dataset.confirmTone = 'warning';
        }
        select.addEventListener('change', sync);
        sync();
    });
})();
</script>
}
