@using System.Security.Claims
@model List<Blog.Core.Domain.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "User Management";
    var allRoles = (List<Blog.Core.Domain.Role>)ViewBag.AllRoles;
    var userRoles = (Dictionary<Guid, string>)ViewBag.UserRoles;
    var currentUserIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier);
    Guid.TryParse(currentUserIdStr, out var currentUserId);
    var isAdmin = User.IsInRole("Admin");

    // Reading TempData consumes it, so the password panel renders exactly once and never on refresh.
    var invitePassword = TempData["InvitePassword"] as string;
    var inviteEmail = TempData["InviteEmail"] as string;
}

<div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-6">
        <div>
            <p class="text-sm" style="color: var(--muted-foreground);">Manage user accounts and assign roles</p>
        </div>
        <a href="/admin/dashboard/seed" class="px-4 py-2 text-sm font-medium rounded-md hover:opacity-90 transition-opacity" style="background: var(--secondary); color: var(--secondary-foreground); border: 1px solid var(--border);">
            Seed data
        </a>
    </div>

    @if (!allRoles.Any())
    {
        <div class="p-4 mb-6 rounded-lg border border-dashed" style="background: var(--muted); border-color: var(--border);">
            <p class="text-sm font-medium" style="color: var(--destructive);">Roles and permissions are not seeded yet. <a href="/admin/dashboard/seed" class="underline font-bold">Seed roles and permissions</a> before assigning roles.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(invitePassword))
    {
    <!-- One-time password panel: rendered only on the redirect after a successful invite -->
    <section id="invite-once" class="p-5 mb-6 border rounded-xl" role="status" aria-labelledby="invite-once-title" aria-describedby="invite-once-body" style="background: var(--card); border-color: var(--border);">
        <div class="flex items-start gap-3">
            <div class="w-9 h-9 rounded-full flex items-center justify-center text-base font-bold shrink-0 text-amber-700 bg-amber-50" aria-hidden="true">!</div>
            <div class="flex-1 min-w-0">
                <h3 id="invite-once-title" class="text-base font-semibold">Password for @inviteEmail</h3>
                <p id="invite-once-body" class="text-sm mt-1" style="color: var(--muted-foreground);">Copy it now and pass it on securely. It is shown only this once and cannot be read back later; if it is lost, a new one has to be set. Nothing has been emailed.</p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                    <code id="invite-once-password" class="px-3 py-2 rounded-md border font-mono text-sm select-all" style="background: var(--muted); border-color: var(--border); color: var(--foreground);">@invitePassword</code>
                    <button type="button" id="invite-once-copy" class="h-9 px-4 rounded-md text-sm font-medium transition-colors focus-visible:ring" style="background: var(--primary); color: var(--primary-foreground);">Copy password</button>
                </div>
            </div>
            <button type="button" id="invite-once-dismiss" aria-label="Dismiss password panel" class="p-1 rounded-md hover:opacity-80 focus-visible:ring" style="color: var(--muted-foreground);"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></button>
        </div>
    </section>
    }

    @if (isAdmin)
    {
    <!-- Invite Author Form -->
    <div class="p-5 mb-6 border rounded-xl" style="background: var(--card); border-color: var(--border);">
        <h3 class="text-base font-semibold mb-3">Invite Author</h3>
        <p class="text-xs mb-4" style="color: var(--muted-foreground);">Create an account for a new author. The password is shown to you once after the account is created; nothing is emailed.</p>
        <form method="post" action="/admin/users/invite" class="flex flex-wrap items-end gap-3">
            @Html.AntiForgeryToken()
            <div class="flex-1 min-w-[150px]">
                <label for="invite-name" class="block text-xs font-medium mb-1">Display name *</label>
                <input type="text" id="invite-name" name="displayName" autocomplete="off" placeholder="Jane Doe" class="w-full px-3 py-2 text-sm border rounded-md focus:outline-none focus:ring-1" style="background: var(--background); border-color: var(--border); color: var(--foreground);" required />
            </div>
            <div class="flex-1 min-w-[150px]">
                <label for="invite-email" class="block text-xs font-medium mb-1">Email *</label>
                <input type="email" id="invite-email" name="email" autocomplete="off" placeholder="jane@example.com" class="w-full px-3 py-2 text-sm border rounded-md focus:outline-none focus:ring-1" style="background: var(--background); border-color: var(--border); color: var(--foreground);" required />
            </div>
            <div class="flex-1 min-w-[240px]">
                <label for="invite-password" class="block text-xs font-medium mb-1">Password</label>
                <div class="flex items-stretch gap-1">
                    <input type="password" id="invite-password" name="password" autocomplete="new-password" minlength="8" placeholder="Leave blank to generate one" aria-describedby="invite-password-hint" class="w-full min-w-0 px-3 py-2 text-sm border rounded-md font-mono focus:outline-none focus:ring-1" style="background: var(--background); border-color: var(--border); color: var(--foreground);" />
                    <button type="button" id="invite-password-toggle" aria-pressed="false" aria-label="Show password" aria-controls="invite-password" class="px-2 rounded-md border hover:opacity-80 transition-opacity focus-visible:ring shrink-0" style="border-color: var(--border); color: var(--muted-foreground);"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
                    <button type="button" id="invite-password-generate" class="px-3 text-xs font-medium rounded-md border hover:opacity-80 transition-opacity focus-visible:ring shrink-0" style="border-color: var(--border); color: var(--foreground);">Generate</button>
                </div>
                <p id="invite-password-hint" class="text-xs mt-1" style="color: var(--muted-foreground);">At least 8 characters. Leave it blank and one is generated for you.</p>
            </div>
            <div class="min-w-[100px]">
                <label for="invite-role" class="block text-xs font-medium mb-1">Role</label>
                <select id="invite-role" name="roleName" class="w-full px-3 py-2 text-sm border rounded-md focus:outline-none focus:ring-1" style="background: var(--background); border-color: var(--border); color: var(--foreground);">
                    <option value="Author">Author</option>
                    <option value="Editor">Editor</option>
                    <option value="Contributor">Contributor</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <button type="submit" class="px-5 py-2 text-sm font-medium rounded-md hover:opacity-90 transition-opacity focus-visible:ring" style="background: var(--primary); color: var(--primary-foreground);">
                Add user
            </button>
        </form>
    </div>
    }

    <div class="border rounded-xl overflow-hidden" style="border-color: var(--border); background: var(--card);">
        <partial name="_ListSearch" />
<div class="table-scroll"><table class="w-full text-sm">
            <thead>
                <tr style="background: var(--muted);">
                    <th class="text-left px-6 py-3 font-semibold" style="color: var(--muted-foreground);">User</th>
                    <th class="text-left px-6 py-3 font-semibold" style="color: var(--muted-foreground);">Email</th>
                    <th class="text-left px-6 py-3 font-semibold" style="color: var(--muted-foreground);">Role</th>
                    <th class="text-left px-6 py-3 font-semibold" style="color: var(--muted-foreground);">Status</th>
                    <th class="text-right px-6 py-3 font-semibold" style="color: var(--muted-foreground);">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var currentRole = userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "None";
                    var displayName = user.DisplayName ?? user.Username ?? "This user";
                    var isSelf = user.Id == currentUserId;
                    <tr class="border-t" style="border-color: var(--border);">
                        <td class="px-6 py-4">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full overflow-hidden flex-shrink-0">
                                    <img src="@(!string.IsNullOrEmpty(user.AvatarUrl) ? user.AvatarUrl : $"/avatar/{System.Net.WebUtility.UrlEncode(user.DisplayName ?? "U")}")" alt="" class="w-full h-full object-cover" loading="lazy" />
                                </div>
                                <div>
                                    <p class="font-medium">@(user.DisplayName ?? user.Username ?? "Unknown") @if (isSelf) { <span class="text-xs font-normal" style="color: var(--muted-foreground);">(you)</span> }</p>
                                    <p class="text-xs" style="color: var(--muted-foreground);">@("@")@(user.Username)</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-6 py-4" style="color: var(--muted-foreground);">@user.Email</td>
                        <td class="px-6 py-4">
                            @if (isAdmin && allRoles.Any())
                            {
                                @* No auto-submit: the role only changes after an explicit Change click and a confirmation
                                   that names the old and new role. The script below fills the dialog copy per selection;
                                   the static attributes are the fallback so the dialog is never skipped. *@
                                <form method="post" action="/admin/users/update-role" class="flex items-center gap-2" data-role-form data-user-name="@displayName" data-confirm-title="Change this user's role?" data-confirm-body="@displayName gets the permissions of the new role the next time they sign in." data-confirm-action="Change role" data-confirm-tone="warning">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <label for="role-@user.Id" class="sr-only">Role for @displayName</label>
                                    <select id="role-@user.Id" name="roleName" data-current="@currentRole" class="px-2 py-1 text-xs rounded-md border focus:outline-none focus:ring-1 focus:ring-primary" style="background: var(--background); border-color: var(--border); color: var(--foreground);">
                                        @foreach (var role in allRoles)
                                        {
                                            <option value="@role.Name" data-description="@role.Description" selected="@(currentRole == role.Name)">@role.Name</option>
                                        }
                                    </select>
                                    <button type="submit" disabled aria-label="Change role for @displayName" class="px-3 py-1 text-xs font-medium rounded-md border hover:opacity-80 transition-opacity disabled:opacity-50 disabled:cursor-not-allowed focus-visible:ring" style="border-color: var(--border); color: var(--foreground);">Change</button>
                                </form>
                            }
                            else
                            {
                                <span class="px-2 py-1 text-xs rounded-full font-medium" style="background: var(--muted); color: var(--muted-foreground);">@currentRole</span>
                            }
                        </td>
                        <td class="px-6 py-4">
                            @if (user.IsActive)
                            {
                                <span class="px-2 py-1 text-xs rounded-full font-medium bg-emerald-100 text-emerald-800">Active</span>
                            }
                            else
                            {
                                <span class="px-2 py-1 text-xs rounded-full font-medium bg-red-100 text-red-800">Disabled</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right">
                            @* Never offered on your own row: disabling yourself locks you out. The controller refuses it too. *@
                            @if (isAdmin && !isSelf)
                            {
                                if (user.IsActive)
                                {
                                <form method="post" action="/admin/users/toggle-active" class="inline" data-confirm-title="Disable this user?" data-confirm-body="@displayName is signed out and cannot sign in until re-enabled. Their posts, pages and comments stay." data-confirm-action="Disable user" data-confirm-tone="warning">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" aria-label="Disable @displayName" class="px-3 py-1 text-xs rounded-md border hover:opacity-80 transition-opacity focus-visible:ring" style="border-color: var(--border); color: var(--muted-foreground);">Disable</button>
                                </form>
                                }
                                else
                                {
                                <form method="post" action="/admin/users/toggle-active" class="inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" aria-label="Enable @displayName" class="px-3 py-1 text-xs rounded-md border hover:opacity-80 transition-opacity focus-visible:ring" style="border-color: var(--border); color: var(--muted-foreground);">Enable</button>
                                </form>
                                }
                            }

                            @{
                                bool canDelete = false;
                                if (!isSelf)
                                {
                                    if (isAdmin) canDelete = true;
                                    else if (user.CreatedByUserId == currentUserId && user.Role != "Admin" && user.Role != "Editor") canDelete = true;
                                }
                            }
                            @if (canDelete)
                            {
                                <form method="post" action="/admin/users/delete" class="inline ml-2" data-confirm-title="Delete this user?" data-confirm-body="@displayName (@user.Email) loses access immediately and their profile is removed. This cannot be undone." data-confirm-action="Delete user" data-confirm-tone="danger">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" aria-label="Delete @displayName" class="px-3 py-1 text-xs rounded-md border hover:bg-red-50 transition-colors focus-visible:ring" style="border-color: var(--destructive); color: var(--destructive);">
                                        Delete
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
<partial name="_ListPager" />
    </div>

    <div class="mt-6 p-4 rounded-lg border border-dashed text-sm" style="background: var(--muted); border-color: var(--border); color: var(--muted-foreground);">
        <strong>Note:</strong> Blog visitors (consumers) can read posts and leave comments without any account. Roles only control access to the admin panel.
        After changing a user's role, they must <strong>log out and back in</strong> for the new permissions to take effect.
    </div>
</div>

@section Scripts {
<script>
(function () {
    'use strict';

    /* -- Invite form: show/hide and generate ------------------------------------------------
       The alphabet mirrors Blog.Core.Services.PasswordGenerator (no 0 O 1 l I); keep them in step. */
    var pw = document.getElementById('invite-password');
    var toggle = document.getElementById('invite-password-toggle');
    var gen = document.getElementById('invite-password-generate');

    function setVisible(show) {
        pw.type = show ? 'text' : 'password';
        toggle.setAttribute('aria-pressed', show ? 'true' : 'false');
        toggle.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
    }

    var LOWER = 'abcdefghijkmnopqrstuvwxyz', UPPER = 'ABCDEFGHJKLMNPQRSTUVWXYZ', DIGITS = '23456789';
    var ALL = LOWER + UPPER + DIGITS;

    // Unbiased integer in [0, n) from crypto.getRandomValues (rejection sampling, no modulo bias).
    function randInt(n) {
        var limit = Math.floor(4294967296 / n) * n;
        var buf = new Uint32Array(1);
        do { crypto.getRandomValues(buf); } while (buf[0] >= limit);
        return buf[0] % n;
    }
    function pick(set) { return set.charAt(randInt(set.length)); }
    function generate(len) {
        var chars = [pick(LOWER), pick(UPPER), pick(DIGITS)];
        while (chars.length < len) chars.push(pick(ALL));
        for (var i = chars.length - 1; i > 0; i--) { var j = randInt(i + 1); var t = chars[i]; chars[i] = chars[j]; chars[j] = t; }
        return chars.join('');
    }

    if (pw && toggle && gen) {
        toggle.addEventListener('click', function () { setVisible(pw.type === 'password'); });
        gen.addEventListener('click', function () {
            pw.value = generate(16);
            setVisible(true);
            pw.focus();
        });
    }

    /* -- One-time password panel: copy and dismiss ---------------------------------------- */
    var once = document.getElementById('invite-once');
    var copy = document.getElementById('invite-once-copy');
    var code = document.getElementById('invite-once-password');
    var dismiss = document.getElementById('invite-once-dismiss');
    if (once && copy && code) {
        copy.addEventListener('click', function () {
            var text = code.textContent.trim();
            var done = function () { copy.textContent = 'Copied'; InkwellDialog.toast('success', 'Password copied.'); };
            var fallback = function () {
                var range = document.createRange(); range.selectNodeContents(code);
                var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
                InkwellDialog.toast('warning', 'Copy is blocked in this browser. The password is selected; press Ctrl+C.');
            };
            if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fallback);
            else fallback();
        });
        if (dismiss) dismiss.addEventListener('click', function () { once.remove(); });
    }

    /* -- Role change: explicit Change button + dialog copy per selection ------------------ */
    document.querySelectorAll('form[data-role-form]').forEach(function (form) {
        var select = form.querySelector('select[name="roleName"]');
        var button = form.querySelector('button[type="submit"]');
        if (!select || !button) return;
        var name = form.dataset.userName || 'This user';
        var current = select.dataset.current || '';

        function sync() {
            var next = select.value;
            var changed = next !== current;
            button.disabled = !changed;
            if (!changed) return;
            var opt = select.options[select.selectedIndex];
            var desc = (opt && opt.dataset.description) ? opt.dataset.description
                     : (next === 'Admin' ? 'Full access to users, settings and all content' : '');
            form.dataset.confirmTitle = 'Change role to ' + next + '?';
            form.dataset.confirmBody = name + ' moves from ' + current + ' to ' + next + '.'
                + (desc ? ' ' + next + ': ' + desc + '.' : '')
                + ' The new permissions apply the next time they sign in.';
            form.dataset.confirmAction = 'Change to ' + next;
            form.dataset.confirmTone = 'warning';
        }
        select.addEventListener('change', sync);
        sync();
    });
})();
</script>
}
