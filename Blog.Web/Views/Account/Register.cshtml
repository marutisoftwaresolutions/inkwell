@model dynamic
@inject Blog.Core.Interfaces.IUserRepository UsersRepo
@inject Blog.Core.Interfaces.ISettingRepository SettingsRepo
@{
    Layout = null;
    ViewData["Title"] = "Setup Admin Account";
    // Colour scheme resolves the same way as _AdminLayout (owner's Settings → Colour scheme); fails open to "system".
    var colorScheme = "system";
    try
    {
        var primaryAdmin = await UsersRepo.GetFirstAdminAsync();
        var settings = await SettingsRepo.GetSettingsAsync(primaryAdmin?.Id ?? Guid.Empty);
        if (settings?.Theme is "light" or "dark") colorScheme = settings.Theme;
    }
    catch { }
    var hasError = ViewBag.Error != null;
}
<!DOCTYPE html>
<html lang="en" data-theme="@colorScheme">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="robots" content="noindex,nofollow" />

    <!-- Fonts (self-hosted) -->
    <link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true">
    <!-- Desk tokens (light + dark scheme) -->
    <link rel="stylesheet" href="~/css/desk-tokens.css" asp-append-version="true">

    <!-- Tailwind CSS (self-hosted) -->
    <script src="~/lib/tailwindcss/tailwind.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: 'var(--background)',
                        foreground: 'var(--foreground)',
                        card: 'var(--card)',
                        'card-foreground': 'var(--card-foreground)',
                        primary: 'var(--primary)',
                        'primary-foreground': 'var(--primary-foreground)',
                        muted: 'var(--muted)',
                        'muted-foreground': 'var(--muted-foreground)',
                        accent: 'var(--accent)',
                        'accent-foreground': 'var(--accent-foreground)',
                        destructive: 'var(--destructive)',
                        'destructive-foreground': 'var(--destructive-foreground)',
                        border: 'var(--border)',
                        input: 'var(--input)',
                        ring: 'var(--ring)',
                    },
                    fontFamily: {
                        sans: ["'Geist'", 'Inter', 'system-ui', 'sans-serif'],
                    },
                    borderRadius: {
                        DEFAULT: 'var(--radius)',
                    }
                }
            }
        }
    </script>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    <main class="w-full max-w-md bg-card text-card-foreground border border-border rounded-lg shadow-lg p-8">
        <div class="text-center mb-8">
            <div class="w-12 h-12 bg-primary text-primary-foreground rounded mx-auto flex items-center justify-center mb-4" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <h1 class="text-2xl font-bold">Register Your Account</h1>
            <p class="text-muted-foreground text-sm mt-1">Create your admin account to get started.</p>
        </div>

        @if (hasError)
        {
            <p id="form-error" role="alert" class="mb-6 p-3 rounded border border-destructive text-destructive text-sm">@ViewBag.Error</p>
        }

        <form id="register-form" method="post" action="/Account/Register" class="space-y-4">
            @Html.AntiForgeryToken()

            <div>
                <label for="name" class="block text-sm font-medium mb-1.5 uppercase tracking-wide text-muted-foreground text-xs">Full name</label>
                <input type="text" name="name" id="name" value="@ViewBag.Name" placeholder="Your name" autocomplete="name" aria-describedby="@(hasError ? "form-error" : null)" class="w-full px-3 py-2 bg-background border border-input rounded text-sm focus:outline-none focus:ring-2 focus:ring-ring" required autofocus />
            </div>

            <div>
                <label for="email" class="block text-sm font-medium mb-1.5 uppercase tracking-wide text-muted-foreground text-xs">Email address</label>
                <input type="email" name="email" id="email" value="@ViewBag.Email" placeholder="you@example.com" autocomplete="username" aria-describedby="email-error" class="w-full px-3 py-2 bg-background border border-input rounded text-sm focus:outline-none focus:ring-2 focus:ring-ring" required />
                <p id="email-error" class="text-xs text-destructive mt-1.5 hidden">Enter a valid email address.</p>
            </div>

            <div>
                <label for="password" class="block text-sm font-medium mb-1.5 uppercase tracking-wide text-muted-foreground text-xs">Password</label>
                <div class="relative">
                    <input type="password" name="password" id="password" autocomplete="new-password" aria-describedby="password-hint" class="w-full px-3 py-2 pr-16 bg-background border border-input rounded text-sm focus:outline-none focus:ring-2 focus:ring-ring" required />
                    <button type="button" data-toggle-password="password" aria-pressed="false" aria-label="Show password" class="absolute inset-y-0 right-0 px-3 text-xs font-medium text-muted-foreground hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded">Show</button>
                </div>
                <p id="password-hint" class="text-xs text-muted-foreground mt-1.5 transition-colors">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</p>
            </div>

            <div>
                <label for="confirmPassword" class="block text-sm font-medium mb-1.5 uppercase tracking-wide text-muted-foreground text-xs">Confirm password</label>
                <div class="relative">
                    <input type="password" name="confirmPassword" id="confirmPassword" autocomplete="new-password" aria-describedby="confirm-error" class="w-full px-3 py-2 pr-16 bg-background border border-input rounded text-sm focus:outline-none focus:ring-2 focus:ring-ring" required />
                    <button type="button" data-toggle-password="confirmPassword" aria-pressed="false" aria-label="Show password" class="absolute inset-y-0 right-0 px-3 text-xs font-medium text-muted-foreground hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded">Show</button>
                </div>
                <p id="confirm-error" class="text-xs text-destructive mt-1.5 hidden">Passwords don't match.</p>
            </div>

            <button type="submit" id="submit-btn" class="w-full py-2.5 bg-primary text-primary-foreground font-semibold rounded hover:opacity-90 transition-opacity shadow-sm mt-6">
                Create account
            </button>
            <div class="text-center text-sm mt-5 text-muted-foreground">
                Already have an account? <a href="/account/login" class="text-foreground hover:underline font-medium">Sign in</a>
            </div>
        </form>

        <script>
            document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var input = document.getElementById(btn.getAttribute('data-toggle-password'));
                    if (!input) return;
                    var show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    btn.textContent = show ? 'Hide' : 'Show';
                });
            });

            const emailInput = document.getElementById('email');
            const passwordInput = document.getElementById('password');
            const confirmInput = document.getElementById('confirmPassword');
            const form = document.getElementById('register-form');
            const emailError = document.getElementById('email-error');
            const passwordHint = document.getElementById('password-hint');
            const confirmError = document.getElementById('confirm-error');

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[a-zA-Z]{2,}$/;

            function isStrongPassword(pwd) {
                if (pwd.length < 8) return false;
                let hasUpper = false, hasLower = false, hasDigit = false;
                for (let i = 0; i < pwd.length; i++) {
                    const c = pwd[i];
                    if (c >= 'A' && c <= 'Z') hasUpper = true;
                    else if (c >= 'a' && c <= 'z') hasLower = true;
                    else if (c >= '0' && c <= '9') hasDigit = true;
                }
                return hasUpper && hasLower && hasDigit;
            }

            function updateInputState(input, isValid) {
                const invalid = !isValid && input.value !== '';
                input.classList.toggle('border-destructive', invalid);
                input.classList.toggle('focus:ring-destructive', invalid);
                input.classList.toggle('border-input', !invalid);
                input.classList.toggle('focus:ring-ring', !invalid);
                if (invalid) input.setAttribute('aria-invalid', 'true'); else input.removeAttribute('aria-invalid');
            }

            function validateEmail() {
                const isValid = emailRegex.test(emailInput.value);
                updateInputState(emailInput, isValid);
                emailError.classList.toggle('hidden', isValid || emailInput.value === '');
                return isValid;
            }

            function validatePassword() {
                const isValid = isStrongPassword(passwordInput.value);
                updateInputState(passwordInput, isValid);
                const bad = !isValid && passwordInput.value !== '';
                passwordHint.classList.toggle('text-muted-foreground', !bad);
                passwordHint.classList.toggle('text-destructive', bad);
                if (confirmInput.value !== '') validateConfirm();
                return isValid;
            }

            function validateConfirm() {
                const isValid = confirmInput.value === passwordInput.value;
                updateInputState(confirmInput, isValid);
                confirmError.classList.toggle('hidden', isValid || confirmInput.value === '');
                return isValid;
            }

            emailInput.addEventListener('input', validateEmail);
            passwordInput.addEventListener('input', validatePassword);
            confirmInput.addEventListener('input', validateConfirm);

            form.addEventListener('submit', function (e) {
                const ok = validateEmail() & validatePassword() & validateConfirm();
                if (!ok) {
                    e.preventDefault();
                    const first = form.querySelector('[aria-invalid="true"]');
                    if (first) first.focus();
                }
            });
        </script>
    </main>
</body>
</html>
