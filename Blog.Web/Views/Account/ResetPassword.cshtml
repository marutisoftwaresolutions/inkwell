@inject Blog.Core.Interfaces.IUserRepository UsersRepo
@inject Blog.Core.Interfaces.ISettingRepository SettingsRepo
@{
    Layout = null;
    ViewData["Title"] = "Reset password – Admin";
    // Colour scheme resolves the same way as _AdminLayout (owner's Settings → Colour scheme); fails open to "system".
    var colorScheme = "system";
    try
    {
        var primaryAdmin = await UsersRepo.GetFirstAdminAsync();
        var settings = await SettingsRepo.GetSettingsAsync(primaryAdmin?.Id ?? Guid.Empty);
        if (settings?.Theme is "light" or "dark") colorScheme = settings.Theme;
    }
    catch { }
    var hasError = ViewBag.Error != null;
}
<!DOCTYPE html>
<html lang="en" data-theme="@colorScheme">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <meta name="robots" content="noindex,nofollow" />

    <!-- Fonts (self-hosted) -->
    <link rel="stylesheet" href="~/fonts/fonts.css" asp-append-version="true">
    <!-- Desk tokens (light + dark scheme) -->
    <link rel="stylesheet" href="~/css/desk-tokens.css" asp-append-version="true">

    <!-- Tailwind CSS (self-hosted) -->
    <script src="~/lib/tailwindcss/tailwind.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        background: 'var(--background)',
                        foreground: 'var(--foreground)',
                        card: 'var(--card)',
                        'card-foreground': 'var(--card-foreground)',
                        primary: 'var(--primary)',
                        'primary-foreground': 'var(--primary-foreground)',
                        muted: 'var(--muted)',
                        'muted-foreground': 'var(--muted-foreground)',
                        accent: 'var(--accent)',
                        'accent-foreground': 'var(--accent-foreground)',
                        destructive: 'var(--destructive)',
                        'destructive-foreground': 'var(--destructive-foreground)',
                        border: 'var(--border)',
                        input: 'var(--input)',
                        ring: 'var(--ring)',
                    },
                    fontFamily: {
                        sans: ["'Geist'", 'Inter', 'system-ui', 'sans-serif'],
                    },
                    borderRadius: {
                        DEFAULT: 'var(--radius)',
                    }
                }
            }
        }
    </script>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
    <main class="w-full max-w-md bg-card text-card-foreground border border-border rounded-lg shadow-lg p-8">
        <div class="text-center mb-8">
            <div class="w-12 h-12 bg-primary text-primary-foreground rounded mx-auto flex items-center justify-center mb-4" aria-hidden="true">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
            <h1 class="text-2xl font-bold">Choose a new password</h1>
            <p class="text-muted-foreground text-sm mt-1">The link you followed lets you set a new password</p>
        </div>

        @if (hasError)
        {
            <p id="form-error" role="alert" class="mb-6 p-3 rounded border border-destructive text-destructive text-sm">@ViewBag.Error</p>
        }

        @if (ViewBag.Invalid == true)
        {
            <p role="status" class="p-4 rounded bg-muted border border-border text-sm">
                This reset link is invalid, has expired, or has already been used. Request a new one.
            </p>
            <div class="text-center text-sm mt-6 text-muted-foreground">
                <a href="/account/forgot-password" class="text-foreground hover:underline font-medium">Request a new link</a>
            </div>
        }
        else
        {
            <form method="post" action="/account/reset-password" class="space-y-6">
                @Html.AntiForgeryToken()
                <input type="hidden" name="token" value="@ViewBag.Token" />
                <div>
                    <label for="password" class="block text-sm font-medium mb-1.5 uppercase tracking-wide text-muted-foreground text-xs">New password</label>
                    <div class="relative">
                        <input type="password" name="password" id="password" required minlength="8" autocomplete="new-password" autofocus aria-describedby="@(hasError ? "form-error password-hint" : "password-hint")" class="w-full px-3 py-2 pr-16 bg-background border border-input rounded text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                        <button type="button" data-toggle-password="password" aria-pressed="false" aria-label="Show password" class="absolute inset-y-0 right-0 px-3 text-xs font-medium text-muted-foreground hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded">Show</button>
                    </div>
                    <p id="password-hint" class="text-xs text-muted-foreground mt-1">At least 8 characters.</p>
                </div>
                <div>
                    <label for="confirmPassword" class="block text-sm font-medium mb-1.5 uppercase tracking-wide text-muted-foreground text-xs">Confirm password</label>
                    <div class="relative">
                        <input type="password" name="confirmPassword" id="confirmPassword" required minlength="8" autocomplete="new-password" class="w-full px-3 py-2 pr-16 bg-background border border-input rounded text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                        <button type="button" data-toggle-password="confirmPassword" aria-pressed="false" aria-label="Show password" class="absolute inset-y-0 right-0 px-3 text-xs font-medium text-muted-foreground hover:text-foreground focus:outline-none focus-visible:ring-2 focus-visible:ring-ring rounded">Show</button>
                    </div>
                </div>
                <button type="submit" class="w-full py-2.5 bg-primary text-primary-foreground font-semibold rounded hover:opacity-90 transition-opacity shadow-sm">
                    Set new password
                </button>
            </form>
        }
    </main>
    <script>
        document.querySelectorAll('[data-toggle-password]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = document.getElementById(btn.getAttribute('data-toggle-password'));
                if (!input) return;
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                btn.textContent = show ? 'Hide' : 'Show';
            });
        });
    </script>
</body>
</html>
