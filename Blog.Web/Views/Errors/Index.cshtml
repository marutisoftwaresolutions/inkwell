@using Blog.Core.Domain
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Error Monitor";
    ViewData["Description"] = "Missing resources (4xx) and server errors (5xx), grouped by signature. Admin-only, read-only.";

    var items = (IReadOnlyList<ErrorLog>)ViewBag.Items;
    var stats = (ErrorStats)ViewBag.Stats;
    var page = (int)ViewBag.Page;
    int? filterStatus = ViewBag.FilterStatus;
    string? filterQuery = ViewBag.FilterQuery;

    string Ago(DateTime utc)
    {
        var d = DateTime.UtcNow - utc;
        if (d.TotalMinutes < 1) return "just now";
        if (d.TotalHours < 1) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalDays < 1) return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }
    string Badge(int code) => code >= 500 ? "pill-bad"
        : code == 404 ? "pill-warn"
        : "desk-pill-muted";
}

@* ── Summary tiles ─────────────────────────────────────────────── *@
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <div class="desk-kpi">
        <div class="desk-kpi-value">@stats.TotalGroups.ToString("N0")</div>
        <div class="desk-kpi-label">Distinct errors</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value">@stats.TotalOccurrences.ToString("N0")</div>
        <div class="desk-kpi-label">Total occurrences</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value tone-warn">@stats.NotFoundGroups.ToString("N0")</div>
        <div class="desk-kpi-label">404 signatures</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value tone-bad">@stats.ServerErrorGroups.ToString("N0")</div>
        <div class="desk-kpi-label">5xx signatures</div>
    </div>
</div>

@* ── Filters: status code is its own small form that carries the search along; the search box is the shared partial. ── *@
<div class="flex flex-wrap items-start gap-2">
    <form method="get" class="flex items-center gap-2 mb-4">
        <input type="hidden" name="q" value="@filterQuery" />
        <select name="status" aria-label="Filter by status code" class="desk-select w-auto">
            <option value="">All status codes</option>
            <option value="404" selected="@(filterStatus == 404)">404 Not Found</option>
            <option value="500" selected="@(filterStatus == 500)">500 Server Error</option>
            <option value="403" selected="@(filterStatus == 403)">403 Forbidden</option>
        </select>
        <button type="submit" class="desk-btn desk-btn-outline">Apply</button>
    </form>
    <partial name="_ListSearch" />
</div>

@* ── Grouped listing ───────────────────────────────────────────── *@
<div class="desk-card overflow-hidden">
    @if (items.Count == 0)
    {
        if (!string.IsNullOrEmpty(filterQuery))
        {
            ViewData["EmptyQuery"] = filterQuery;
            ViewData["EmptyClearHref"] = filterStatus is null ? "/admin/errors" : $"/admin/errors?status={filterStatus}";
            ViewData["EmptyHint"] = "to see every recorded error.";
        }
        else
        {
            ViewData["EmptyTitle"] = filterStatus is null ? "No errors recorded" : $"No {filterStatus} errors recorded";
            ViewData["EmptyHint"] = filterStatus is null ? "Missing pages and server errors appear here as visitors hit them." : "Choose “All status codes” to see every signature.";
        }
        <partial name="_EmptyState" />
    }
    else
    {
    <div class="table-scroll"><table class="desk-table">
        <thead>
            <tr>
                <th>Status</th>
                <th>Path</th>
                <th>Type / Message</th>
                <th class="text-right">Count</th>
                <th>First</th>
                <th>Last</th>
                <th>Last IP</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var e in items)
            {
                <tr class="align-top">
                    <td class="align-top">
                        <span class="desk-pill @Badge(e.StatusCode)">@e.StatusCode</span>
                        <div class="text-[10px] text-muted-foreground mt-1">@e.Method</div>
                    </td>
                    <td class="align-top font-mono text-xs text-foreground break-all max-w-[22rem]">@e.Path</td>
                    <td class="align-top max-w-[26rem]">
                        @if (!string.IsNullOrEmpty(e.ExceptionType))
                        {
                            <div class="text-xs font-medium tone-bad break-all">@e.ExceptionType</div>
                        }
                        @if (!string.IsNullOrEmpty(e.Message))
                        {
                            <div class="text-xs text-muted-foreground break-words">@(e.Message!.Length > 200 ? e.Message[..200] + "…" : e.Message)</div>
                        }
                    </td>
                    <td class="align-top text-right font-semibold text-foreground">@e.OccurrenceCount.ToString("N0")</td>
                    <td class="align-top text-xs text-muted-foreground whitespace-nowrap" title="@Dates.DateTimeSeconds(e.FirstSeenAt)">@Ago(e.FirstSeenAt)</td>
                    <td class="align-top text-xs text-muted-foreground whitespace-nowrap" title="@Dates.DateTimeSeconds(e.LastSeenAt)">@Ago(e.LastSeenAt)</td>
                    <td class="align-top whitespace-nowrap">
                        @if (string.IsNullOrEmpty(e.LastIpAddress))
                        {
                            <span class="text-xs text-muted-foreground">—</span>
                        }
                        else
                        {
                            <div class="font-mono text-[11px] text-foreground">@e.LastIpAddress</div>
                            <form method="post" action="/admin/security/block" class="inline"
                                  data-confirm-title="Block this address for 24 hours?" data-confirm-body="@e.LastIpAddress receives 403 for every request until the block expires. Allowlisted addresses and your own address cannot be blocked; lift it early under Admin → Security." data-confirm-action="Block for 24 hours" data-confirm-tone="warning">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ip" value="@e.LastIpAddress" />
                                <input type="hidden" name="hours" value="24" />
                                <input type="hidden" name="reason" value="Blocked from the Error Monitor (@e.StatusCode on @e.Path)" />
                                <input type="hidden" name="returnUrl" value="@($"/admin/errors?status={filterStatus}&q={filterQuery}&page={page}")" />
                                <button type="submit" aria-label="Block @e.LastIpAddress for 24 hours" class="desk-btn desk-btn-danger-outline desk-btn-sm h-6 px-2 text-[11px] mt-1">Block</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table></div>
    }
</div>

<partial name="_ListPager" />
