@using Blog.Core.Domain
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Error Monitor";

    var items = (IReadOnlyList<ErrorLog>)ViewBag.Items;
    var stats = (ErrorStats)ViewBag.Stats;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    int? filterStatus = ViewBag.FilterStatus;
    string? filterQuery = ViewBag.FilterQuery;

    string Ago(DateTime utc)
    {
        var d = DateTime.UtcNow - utc;
        if (d.TotalMinutes < 1) return "just now";
        if (d.TotalHours < 1) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalDays < 1) return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }
    string Badge(int code) => code >= 500 ? "bg-red-100 text-red-700"
        : code == 404 ? "bg-amber-100 text-amber-700"
        : "bg-slate-100 text-slate-700";
}

<div class="mb-5">
    <h2 class="text-lg font-semibold text-foreground">Error Monitor</h2>
    <p class="text-xs text-muted-foreground mt-0.5">Missing resources (4xx) and server errors (5xx), grouped by signature. Admin-only, read-only.</p>
</div>

@* ── Summary tiles ─────────────────────────────────────────────── *@
<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <div class="rounded-xl border border-border bg-card p-4">
        <div class="text-2xl font-bold text-foreground">@stats.TotalGroups.ToString("N0")</div>
        <div class="text-xs text-muted-foreground mt-1">Distinct errors</div>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
        <div class="text-2xl font-bold text-foreground">@stats.TotalOccurrences.ToString("N0")</div>
        <div class="text-xs text-muted-foreground mt-1">Total occurrences</div>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
        <div class="text-2xl font-bold text-amber-600">@stats.NotFoundGroups.ToString("N0")</div>
        <div class="text-xs text-muted-foreground mt-1">404 signatures</div>
    </div>
    <div class="rounded-xl border border-border bg-card p-4">
        <div class="text-2xl font-bold text-red-600">@stats.ServerErrorGroups.ToString("N0")</div>
        <div class="text-xs text-muted-foreground mt-1">5xx signatures</div>
    </div>
</div>

@* ── Filters ───────────────────────────────────────────────────── *@
<form method="get" class="flex flex-wrap gap-2 mb-4">
    <select name="status" class="h-8 rounded border border-input bg-background px-2 text-xs text-foreground focus:outline-none focus:ring-1 focus:ring-ring">
        <option value="">All status codes</option>
        <option value="404" selected="@(filterStatus == 404)">404 Not Found</option>
        <option value="500" selected="@(filterStatus == 500)">500 Server Error</option>
        <option value="403" selected="@(filterStatus == 403)">403 Forbidden</option>
    </select>
    <input type="text" name="q" value="@filterQuery" placeholder="Search path / message / type"
           class="h-8 rounded border border-input bg-background px-2 text-xs text-foreground placeholder-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring w-64" />
    <button type="submit" class="h-8 px-3 rounded bg-emerald-600 text-white text-xs font-medium hover:bg-emerald-700">Filter</button>
    @if (filterStatus != null || !string.IsNullOrEmpty(filterQuery))
    {
        <a href="/admin/errors" class="h-8 px-3 rounded border border-input text-xs text-foreground flex items-center hover:bg-muted">Clear</a>
    }
</form>

@* ── Grouped listing ───────────────────────────────────────────── *@
<div class="rounded-xl border border-border bg-card overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-border text-left text-xs text-muted-foreground">
                <th class="px-4 py-2 font-medium">Status</th>
                <th class="px-4 py-2 font-medium">Path</th>
                <th class="px-4 py-2 font-medium">Type / Message</th>
                <th class="px-4 py-2 font-medium text-right">Count</th>
                <th class="px-4 py-2 font-medium">First</th>
                <th class="px-4 py-2 font-medium">Last</th>
                <th class="px-4 py-2 font-medium">Last IP</th>
            </tr>
        </thead>
        <tbody>
            @if (items.Count == 0)
            {
                <tr><td colspan="7" class="px-4 py-10 text-center text-muted-foreground">No errors recorded. 🎉</td></tr>
            }
            @foreach (var e in items)
            {
                <tr class="border-b border-border/50 align-top hover:bg-muted/40">
                    <td class="px-4 py-2">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold @Badge(e.StatusCode)">@e.StatusCode</span>
                        <div class="text-[10px] text-muted-foreground mt-1">@e.Method</div>
                    </td>
                    <td class="px-4 py-2 font-mono text-xs text-foreground break-all max-w-[22rem]">@e.Path</td>
                    <td class="px-4 py-2 max-w-[26rem]">
                        @if (!string.IsNullOrEmpty(e.ExceptionType))
                        {
                            <div class="text-xs font-medium text-red-600 break-all">@e.ExceptionType</div>
                        }
                        @if (!string.IsNullOrEmpty(e.Message))
                        {
                            <div class="text-xs text-muted-foreground break-words">@(e.Message!.Length > 200 ? e.Message[..200] + "…" : e.Message)</div>
                        }
                    </td>
                    <td class="px-4 py-2 text-right font-semibold text-foreground">@e.OccurrenceCount.ToString("N0")</td>
                    <td class="px-4 py-2 text-xs text-muted-foreground whitespace-nowrap" title="@e.FirstSeenAt.ToString("u")">@Ago(e.FirstSeenAt)</td>
                    <td class="px-4 py-2 text-xs text-muted-foreground whitespace-nowrap" title="@e.LastSeenAt.ToString("u")">@Ago(e.LastSeenAt)</td>
                    <td class="px-4 py-2 whitespace-nowrap">
                        @if (string.IsNullOrEmpty(e.LastIpAddress))
                        {
                            <span class="text-xs text-muted-foreground">—</span>
                        }
                        else
                        {
                            <div class="font-mono text-[11px] text-foreground">@e.LastIpAddress</div>
                            <form method="post" action="/admin/security/block" class="inline"
                                  onsubmit="return confirm('Block @e.LastIpAddress for 24 hours?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ip" value="@e.LastIpAddress" />
                                <input type="hidden" name="hours" value="24" />
                                <input type="hidden" name="reason" value="Blocked from the Error Monitor (@e.StatusCode on @e.Path)" />
                                <input type="hidden" name="returnUrl" value="@($"/admin/errors?status={filterStatus}&q={filterQuery}&page={page}")" />
                                <button type="submit" class="mt-1 h-6 px-2 rounded border border-input text-[11px] text-red-600 hover:bg-red-50">Block</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <div class="flex items-center justify-between mt-4 text-xs text-muted-foreground">
        <span>Page @(page) of @totalPages</span>
        <div class="flex gap-2">
            @if (page > 1)
            {
                <a href="?status=@filterStatus&q=@filterQuery&page=@(page-1)" class="h-8 px-3 rounded border border-input flex items-center hover:bg-muted">Prev</a>
            }
            @if (page < totalPages)
            {
                <a href="?status=@filterStatus&q=@filterQuery&page=@(page+1)" class="h-8 px-3 rounded border border-input flex items-center hover:bg-muted">Next</a>
            }
        </div>
    </div>
}
