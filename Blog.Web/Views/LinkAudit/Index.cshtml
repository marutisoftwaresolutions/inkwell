@using Blog.Core.Services
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Link Audit";

    var issues = (IReadOnlyList<LinkIssue>)ViewBag.Issues;
    var filter = (string)ViewBag.Filter;
    int scanned = ViewBag.Scanned, broken = ViewBag.Broken, gone = ViewBag.Gone,
        redirects = ViewBag.Redirects, chains = ViewBag.Chains;

    string Tile(string key) => filter == key
        ? "rounded-xl border-2 border-emerald-500 bg-card p-4 block"
        : "rounded-xl border border-border bg-card p-4 block hover:border-emerald-400";

    string Badge(LinkIssueKind k) => k switch
    {
        LinkIssueKind.Broken   => "bg-red-100 text-red-700",
        LinkIssueKind.Gone     => "bg-red-100 text-red-700",
        LinkIssueKind.Chain    => "bg-amber-100 text-amber-700",
        _                      => "bg-slate-100 text-slate-700"
    };
}

<div class="mb-5">
    <h2 class="text-lg font-semibold text-foreground">Link Audit</h2>
    <p class="text-xs text-muted-foreground mt-0.5">
        Internal links across @scanned published posts and pages. Dead ends and retired targets cost the
        reader; a redirect hop costs link equity. Read-only — each row links to the post that needs editing.
    </p>
</div>

<div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
    <a href="?filter=severe" class="@Tile("severe")">
        <div class="text-2xl font-bold @((broken + gone) > 0 ? "text-red-600" : "text-foreground")">@(broken + gone)</div>
        <div class="text-xs text-muted-foreground mt-1">Need fixing</div>
    </a>
    <a href="?filter=broken" class="@Tile("broken")">
        <div class="text-2xl font-bold @(broken > 0 ? "text-red-600" : "text-foreground")">@broken</div>
        <div class="text-xs text-muted-foreground mt-1">Broken</div>
    </a>
    <a href="?filter=gone" class="@Tile("gone")">
        <div class="text-2xl font-bold @(gone > 0 ? "text-red-600" : "text-foreground")">@gone</div>
        <div class="text-xs text-muted-foreground mt-1">Points at 410</div>
    </a>
    <a href="?filter=chain" class="@Tile("chain")">
        <div class="text-2xl font-bold @(chains > 0 ? "text-amber-600" : "text-foreground")">@chains</div>
        <div class="text-xs text-muted-foreground mt-1">Redirect chains</div>
    </a>
    <a href="?filter=redirect" class="@Tile("redirect")">
        <div class="text-2xl font-bold @(redirects > 0 ? "text-amber-600" : "text-foreground")">@redirects</div>
        <div class="text-xs text-muted-foreground mt-1">Single hops</div>
    </a>
</div>

@if (filter != "all")
{
    <a href="?filter=all" class="inline-block mb-4 text-xs text-emerald-700 hover:underline">Show every issue →</a>
}

<div class="rounded-xl border border-border bg-card overflow-hidden">
    <table class="w-full text-sm">
        <thead>
            <tr class="border-b border-border text-left text-xs text-muted-foreground">
                <th class="px-4 py-2 font-medium">Issue</th>
                <th class="px-4 py-2 font-medium">Link</th>
                <th class="px-4 py-2 font-medium">In post</th>
                <th class="px-4 py-2 font-medium">What to do</th>
            </tr>
        </thead>
        <tbody>
            @if (issues.Count == 0)
            {
                <tr><td colspan="4" class="px-4 py-10 text-center text-muted-foreground">Every internal link resolves cleanly. 🎉</td></tr>
            }
            @foreach (var i in issues)
            {
                <tr class="border-b border-border/50 align-top hover:bg-muted/40">
                    <td class="px-4 py-2 whitespace-nowrap">
                        <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold @Badge(i.Kind)">@i.Kind</span>
                    </td>
                    <td class="px-4 py-2 max-w-[20rem]">
                        <div class="font-mono text-[11px] text-foreground break-all">@i.Href</div>
                        @if (!string.IsNullOrEmpty(i.Anchor))
                        {
                            <div class="text-[11px] text-muted-foreground italic">“@i.Anchor”</div>
                        }
                    </td>
                    <td class="px-4 py-2 max-w-[16rem]">
                        <div class="text-xs text-foreground">@i.SourceTitle</div>
                        <a href="/@i.SourceSlug" target="_blank" rel="noopener"
                           class="text-[11px] font-mono text-muted-foreground hover:underline break-all">/@i.SourceSlug</a>
                    </td>
                    <td class="px-4 py-2 text-xs text-muted-foreground max-w-[22rem]">@i.Detail</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<p class="text-[11px] text-muted-foreground mt-3">
    Generated routes (<span class="font-mono">/tag/</span>, <span class="font-mono">/category/</span>,
    <span class="font-mono">/author/</span>, uploads) and external links are out of scope — they are not
    authored slugs, so a check here would report false positives rather than real faults.
</p>
