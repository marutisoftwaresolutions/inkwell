@using Blog.Core.Services
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Link Audit";

    var issues = (IReadOnlyList<LinkIssue>)ViewBag.Issues;
    var filter = (string)ViewBag.Filter;
    var q = ViewData[Blog.Web.Models.ListPaging.QueryKey] as string ?? "";
    int scanned = ViewBag.Scanned, broken = ViewBag.Broken, gone = ViewBag.Gone,
        redirects = ViewBag.Redirects, chains = ViewBag.Chains;
    ViewData["Description"] = $"Internal links across {scanned} published posts and pages. Dead ends and retired targets cost the reader; a redirect hop costs link equity. Read-only: each row links to the post that needs editing.";

    string Tile(string key) => filter == key
        ? "desk-card p-4 block ring-2 ring-primary"
        : "desk-card p-4 block hover:border-primary/60";
    string? Current(string key) => filter == key ? "page" : null;

    string Badge(LinkIssueKind k) => k switch
    {
        LinkIssueKind.Broken   => "pill-bad",
        LinkIssueKind.Gone     => "pill-bad",
        LinkIssueKind.Chain    => "pill-warn",
        _                      => "desk-pill-muted"
    };
}

@section PageActions {
    @if (filter != "all")
    {
        <a href="?filter=all" class="desk-btn desk-btn-outline">Show every issue</a>
    }
}

<div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
    <a href="?filter=severe" class="@Tile("severe")" aria-current="@Current("severe")">
        <div class="text-2xl font-bold tabular-nums @((broken + gone) > 0 ? "tone-bad" : "text-foreground")">@(broken + gone)</div>
        <div class="text-xs text-muted-foreground mt-1">Need fixing</div>
    </a>
    <a href="?filter=broken" class="@Tile("broken")" aria-current="@Current("broken")">
        <div class="text-2xl font-bold tabular-nums @(broken > 0 ? "tone-bad" : "text-foreground")">@broken</div>
        <div class="text-xs text-muted-foreground mt-1">Broken</div>
    </a>
    <a href="?filter=gone" class="@Tile("gone")" aria-current="@Current("gone")">
        <div class="text-2xl font-bold tabular-nums @(gone > 0 ? "tone-bad" : "text-foreground")">@gone</div>
        <div class="text-xs text-muted-foreground mt-1">Points at 410</div>
    </a>
    <a href="?filter=chain" class="@Tile("chain")" aria-current="@Current("chain")">
        <div class="text-2xl font-bold tabular-nums @(chains > 0 ? "tone-warn" : "text-foreground")">@chains</div>
        <div class="text-xs text-muted-foreground mt-1">Redirect chains</div>
    </a>
    <a href="?filter=redirect" class="@Tile("redirect")" aria-current="@Current("redirect")">
        <div class="text-2xl font-bold tabular-nums @(redirects > 0 ? "tone-warn" : "text-foreground")">@redirects</div>
        <div class="text-xs text-muted-foreground mt-1">Single hops</div>
    </a>
</div>

<partial name="_ListSearch" />

<div class="desk-card overflow-hidden">
    @if (issues.Count == 0)
    {
        if (!string.IsNullOrEmpty(q))
        {
            ViewData["EmptyQuery"] = q;
            ViewData["EmptyClearHref"] = "?filter=" + filter;
            ViewData["EmptyHint"] = "to see every issue in this view.";
        }
        else
        {
            ViewData["EmptyTitle"] = "Every internal link resolves cleanly.";
            ViewData["EmptyHint"] = filter == "all" ? "Nothing needs editing." : "Nothing in this view needs editing.";
            ViewData["EmptyIcon"] = "<path d=\"M20 6 9 17l-5-5\"/>";
        }
        <partial name="_EmptyState" />
    }
    else
    {
    <div class="table-scroll"><table class="desk-table desk-table-compact">
        <thead>
            <tr>
                <th>Issue</th>
                <th>Link</th>
                <th>In post</th>
                <th>What to do</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in issues)
            {
                <tr class="align-top">
                    <td class="whitespace-nowrap">
                        <span class="desk-pill @Badge(i.Kind)">@i.Kind</span>
                    </td>
                    <td class="max-w-[20rem]">
                        <div class="font-mono text-[11px] text-foreground break-all">@i.Href</div>
                        @if (!string.IsNullOrEmpty(i.Anchor))
                        {
                            <div class="text-[11px] text-muted-foreground italic">“@i.Anchor”</div>
                        }
                    </td>
                    <td class="max-w-[16rem]">
                        <div class="text-xs text-foreground">@i.SourceTitle</div>
                        <a href="/@i.SourceSlug" target="_blank" rel="noopener"
                           class="text-[11px] font-mono text-muted-foreground hover:underline break-all">/@i.SourceSlug</a>
                    </td>
                    <td class="text-xs text-muted-foreground max-w-[22rem]">@i.Detail</td>
                </tr>
            }
        </tbody>
    </table></div>
    }
</div>

<partial name="_ListPager" />

<p class="text-[11px] text-muted-foreground mt-3">
    Generated routes (<span class="font-mono">/tag/</span>, <span class="font-mono">/category/</span>,
    <span class="font-mono">/author/</span>, uploads) and external links are out of scope: they are not
    authored slugs, so a check here would report false positives rather than real faults.
</p>
