@{
    Layout = "_SetupLayout";
    ViewData["Title"] = "Setup Complete";
}

<div class="setup-container">
    <div class="setup-card setup-complete">
        <div class="setup-logo">
            <svg class="setup-mark" width="72" height="72" viewBox="0 0 72 72" fill="none" aria-hidden="true" focusable="false"><circle cx="36" cy="36" r="36"/><path d="M20 36l10 10 22-22" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <h1 class="setup-title">Setup complete</h1>
        <p class="setup-subtitle">Your blog is live. Open the Desk — the admin area — to write the first post, or view the site as readers will see it.</p>
        <a href="/admin/dashboard" class="btn btn-primary btn-lg">Open the Desk</a>
        <a href="/" class="btn btn-ghost">View your blog</a>
    </div>
</div>
