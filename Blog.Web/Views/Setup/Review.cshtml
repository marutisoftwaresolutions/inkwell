@{
    Layout = "_SetupLayout";
    ViewData["Title"] = "Review and Launch";
}

<div class="setup-container">
    <div class="setup-card">
        <div class="setup-step-badge">Step 4 of 4</div>
        <h1 class="setup-title">Ready to launch</h1>
        <p class="setup-subtitle">Check these details, then launch. Both can be changed later in Settings.</p>

        <dl class="review-list">
            <div class="review-item">
                <dt class="review-label">Blog name</dt>
                <dd class="review-value">@ViewBag.BlogName</dd>
            </div>
            <div class="review-item">
                <dt class="review-label">Admin email</dt>
                <dd class="review-value">@ViewBag.AdminEmail</dd>
            </div>
        </dl>

        <form method="post" action="/setup/launch" id="launchForm">
            @Html.AntiForgeryToken()
            <div class="setup-steps-preview" aria-hidden="true">
                <div class="step-dot done"></div>
                <div class="step-dot done"></div>
                <div class="step-dot done"></div>
                <div class="step-dot active"></div>
            </div>
            <button type="submit" class="btn btn-primary btn-lg btn-launch" id="launchBtn">Launch blog</button>
            <a href="/setup/step2" class="btn btn-ghost">Go back and change something</a>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    // Launch creates the admin account and settings; a second click must not create them twice.
    var form = document.getElementById('launchForm');
    var btn = document.getElementById('launchBtn');
    if (!form || !btn) return;
    form.addEventListener('submit', function () {
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
        btn.textContent = 'Launching…';
    });
})();
</script>
}
