@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "404 - Page Not Found";
    ViewData["Robots"] = "noindex,follow";
    var requested = ViewBag.RequestedPath as string ?? "";
    var popular = ViewBag.PopularPosts as List<Blog.Core.Domain.Post> ?? new List<Blog.Core.Domain.Post>();
    // A guess at what they meant: the last path segment, de-slugged, seeds the search box.
    var seed = System.Text.RegularExpressions.Regex.Replace(requested.Trim('/').Split('/').LastOrDefault() ?? "", @"[-_]+", " ").Trim();
    if (seed.Length > 60) seed = seed[..60];
}

@* A 404 is not the reader's fault and should not be a dead end: say what was asked for, offer
   search seeded with it, and show what other readers open most. *@
<section class="ink-404">
    <p class="ink-404__code" aria-hidden="true">404</p>
    <h1>That page isn't here</h1>
    <p>
        Nothing lives at <code>@requested</code>. It may have moved, the link may be out of date, or there may be a typo.
    </p>

    <form method="get" action="/search" role="search">
        <input type="search" name="q" value="@seed" placeholder="Search articles…" aria-label="Search articles" required minlength="2" />
        <button type="submit">Search</button>
    </form>

    @if (popular.Count > 0)
    {
        <div class="ink-404__popular">
            <h2>Most read</h2>
            <ul>
                @foreach (var p in popular)
                {
                    <li><a href="/@p.Slug">@p.Title</a></li>
                }
            </ul>
        </div>
    }

    <p class="ink-404__links">
        <a href="/">Home</a> · <a href="/feed">RSS</a><span id="ink-404-back" hidden> · <button type="button" class="ink-404__back" onclick="history.back()">Go back</button></span>
    </p>
</section>
<script>
    // "Go back" only means something when there is somewhere to go back to; without JavaScript it stays hidden.
    (function () { if (window.history.length > 1) { var b = document.getElementById('ink-404-back'); if (b) b.hidden = false; } })();
</script>
