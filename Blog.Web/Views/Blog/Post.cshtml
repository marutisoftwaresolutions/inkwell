@model Blog.Core.Domain.Post
@inject Microsoft.Extensions.Configuration.IConfiguration _rcfg
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = !string.IsNullOrEmpty(Model.MetaTitle) ? Model.MetaTitle : Model.Title;
    ViewData["Description"] = !string.IsNullOrEmpty(Model.MetaDescription) ? Model.MetaDescription : Blog.Core.Services.TextHelper.SmartTruncate(Model.Plaintext);
    ViewData["SiteName"] = ViewBag.SiteName ?? "Blog";
    ViewData["SiteLogoUrl"] = ViewBag.SiteLogoUrl ?? "";

    // Canonical is emitted once by _PublicLayout from this value — do not emit a second <link> here.
    ViewData["Canonical"] = !string.IsNullOrEmpty(Model.CanonicalUrl)
        ? Model.CanonicalUrl
        : $"{Context.Request.Scheme}://{Context.Request.Host}/{Model.Slug}";

    var blogLayout = (string)(ViewBag.LayoutPost ?? "Neutral");
    var reCaptchaSiteKey = _rcfg["ReCaptcha:SiteKey"];

    // Twitter site handle (normalize URL or bare handle → @handle)
    string PostTwitterHandle(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return string.Empty;
        raw = raw.Trim();
        if (raw.Contains("twitter.com/", StringComparison.OrdinalIgnoreCase) || raw.Contains("x.com/", StringComparison.OrdinalIgnoreCase))
            raw = raw.TrimEnd('/').Split('/').LastOrDefault() ?? string.Empty;
        raw = raw.TrimStart('@');
        return string.IsNullOrEmpty(raw) ? string.Empty : "@" + raw;
    }
    var siteTwitter = PostTwitterHandle((string)(ViewBag.SiteTwitter ?? ""));
}

@section MetaTags {
    <!-- Open Graph -->
    @{
        var canonical = (string?)ViewData["Canonical"] ?? "";
        var ogImageUrl = !string.IsNullOrEmpty(Model.OgImage) ? Model.OgImage
            : !string.IsNullOrEmpty(Model.FeatureImage) ? Model.FeatureImage
            : $"{Context.Request.Scheme}://{Context.Request.Host}/og-image/{Model.Slug}.png";
        var twitterImageUrl = !string.IsNullOrEmpty(Model.TwitterImage) ? Model.TwitterImage
            : !string.IsNullOrEmpty(Model.FeatureImage) ? Model.FeatureImage
            : ogImageUrl;
        var imageAlt = Model.Title;
        // og:image / twitter:image must be ABSOLUTE — most social scrapers reject relative paths.
        if (ogImageUrl.StartsWith("/")) ogImageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{ogImageUrl}";
        if (twitterImageUrl.StartsWith("/")) twitterImageUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{twitterImageUrl}";
    }
    <meta property="og:type" content="article" />
    <meta property="og:title" content="@(!string.IsNullOrEmpty(Model.OgTitle) ? Model.OgTitle : ViewData["Title"])" />
    <meta property="og:description" content="@(!string.IsNullOrEmpty(Model.OgDescription) ? Model.OgDescription : ViewData["Description"])" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImageUrl" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="@imageAlt" />
    <meta property="og:site_name" content="@ViewData["SiteName"]" />
    <meta property="og:locale" content="@Blog.Core.Services.LocaleHelper.OgLocale((string?)ViewData["SiteLanguage"])" />
    @if (Model.PublishedAt.HasValue)
    {
        <meta property="article:published_time" content="@Model.PublishedAt.Value.ToString("O")" />
    }
    <meta property="article:modified_time" content="@Model.UpdatedAt.ToString("O")" />
    @if (!string.IsNullOrEmpty(Model.AuthorName))
    {
        <meta property="article:author" content="@Model.AuthorName" />
    }
    @if (Model.Categories.Any())
    {
        <meta property="article:section" content="@Model.Categories.First().Name" />
    }
    @foreach (var tag in Model.Tags)
    {
        <meta property="article:tag" content="@tag.Name" />
    }
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(!string.IsNullOrEmpty(Model.TwitterTitle) ? Model.TwitterTitle : ViewData["Title"])" />
    <meta name="twitter:description" content="@(!string.IsNullOrEmpty(Model.TwitterDescription) ? Model.TwitterDescription : ViewData["Description"])" />
    <meta name="twitter:image" content="@twitterImageUrl" />
    <meta name="twitter:image:alt" content="@imageAlt" />
    @if (!string.IsNullOrEmpty(siteTwitter))
    {
        <meta name="twitter:site" content="@siteTwitter" />
        <meta name="twitter:creator" content="@siteTwitter" />
    }
    <partial name="_SchemaJsonLd" model="Model" view-data="ViewData" />
}

@* If this post belongs to a series, show the "Part N of M · Prev/Next" reading-flow banner. *@
@if (ViewBag.PostSeriesNav != null)
{
    <partial name="_SeriesNav" model="(Blog.Core.Domain.SeriesNav)ViewBag.PostSeriesNav" />
}

@* A post carrying roundup data always renders as a Verdict comparison, whatever the
   site's layout-post setting — the format is driven by the content, not the theme. *@
@if (ViewBag.IsPreview == true)
{
    <div role="status" style="background:var(--surface);color:var(--fg);border-bottom:1px solid var(--border);font-family:var(--sans, system-ui, sans-serif);font-size:13px;text-align:center;padding:10px 16px;">
        <strong>Preview</strong> — this is the post as last saved, shown through a private link@(ViewBag.PreviewExpires is DateTime pe ? $" valid until {pe:d MMM yyyy HH:mm} UTC" : ""). It is not published@(Model.Status == Blog.Core.Domain.PostStatus.Published ? " differently from the live page" : ""), not indexed, and comments are closed here.
    </div>
}
@if (Model.IsRoundup || blogLayout == "Verdict")
{
    <partial name="_Post_Verdict" model="Model" />
}
else if (blogLayout == "Magazine")
{
    <partial name="_Post_Magazine" model="Model" />
}
else
{
    <partial name="_Post_Neutral" model="Model" />
}

<script>
(function () {
  // Works for both Magazine (.ink-essay-body) and Neutral (.post-prose)
  var body = document.querySelector('.ink-essay-body, .post-prose');
  if (!body) return;

  // ── Table enhancement: inject .blog-table class + scrollable wrapper ──
  // Runs after Tailwind Play CDN settles, guaranteeing styles apply on all themes.
  body.querySelectorAll('table:not(.blog-table)').forEach(function (t) {
    t.classList.add('blog-table');
    var wrap = document.createElement('div');
    wrap.className = 'blog-table-wrap';
    t.parentNode.insertBefore(wrap, t);
    wrap.appendChild(t);
  });

  // The table of contents and reading-progress bar are rendered server-side
  // (_TableOfContents / _ReadingProgress); nothing else to build here.
}());
</script>

<!-- Newsletter Signup -->
<div class="max-w-4xl mx-auto px-4">
    <partial name="_NewsletterSignup" view-data="ViewData" />
</div>

<!-- Comments Section (Shared across layouts) -->
@if ((bool)(ViewBag.CommentsEnabled ?? false))
{
    var comments = (List<Blog.Core.Domain.Comment>)ViewBag.Comments;
    ViewData["PostSlug"] = Model.Slug;

    // After a rejected submission AddComment redirects back to #comments with the reader's draft
    // stashed in TempData, so nothing they typed is lost. A reply draft re-opens its own form.
    var commentError = TempData["CommentError"] as string;
    var commentSuccess = TempData["CommentSuccess"] as string;
    var draftName = TempData["CommentDraftName"] as string ?? "";
    var draftEmail = TempData["CommentDraftEmail"] as string ?? "";
    var draftContent = TempData["CommentDraftContent"] as string ?? "";
    var draftParentId = TempData["CommentDraftParentId"] as string;
    var mainFormError = draftParentId == null ? commentError : null;
    ViewData["CommentError"] = commentError;
    ViewData["CommentDraftName"] = draftName;
    ViewData["CommentDraftEmail"] = draftEmail;
    ViewData["CommentDraftContent"] = draftContent;
    ViewData["CommentDraftParentId"] = draftParentId;

    @if (blogLayout == "Magazine")
    {
        <section class="ink-comments" id="comments" tabindex="-1">
            <h2 class="ink-comments-title">
                Letters <span class="meta" style="font-weight:400;">(@comments.Count)</span>
            </h2>
            @if (commentSuccess != null)
            {
                <div class="ink-form-alert" role="status">@commentSuccess</div>
            }
            <div style="display:flex;flex-direction:column;gap:var(--sp-6);margin-bottom:var(--sp-10);">
                @foreach (var comment in comments)
                {
                    <partial name="_CommentThread" model="comment" view-data="ViewData" />
                }
            </div>
            <div class="ink-comment-form">
                <h3 id="comment-form-heading">Leave a letter</h3>
                @if (mainFormError != null)
                {
                    <div class="ink-form-alert ink-form-alert--error" role="alert" id="comment-error">@mainFormError</div>
                }
                <form method="post" action="/@Model.Slug/comment" style="display:flex;flex-direction:column;gap:var(--sp-6);" aria-labelledby="comment-form-heading" aria-describedby="@(mainFormError != null ? "comment-error" : null)">
                    @Html.AntiForgeryToken()
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-6);">
                        <div>
                            <label class="eyebrow" for="comment-name" style="display:block;margin-bottom:var(--sp-2);">Name *</label>
                            <input type="text" id="comment-name" name="authorName" class="ink-input" required autocomplete="name" placeholder="Your name" value="@draftName" />
                        </div>
                        <div>
                            <label class="eyebrow" for="comment-email" style="display:block;margin-bottom:var(--sp-2);">Email *</label>
                            <input type="email" id="comment-email" name="authorEmail" class="ink-input" required autocomplete="email" placeholder="you@example.com" value="@draftEmail" />
                        </div>
                    </div>
                    <div>
                        <label class="eyebrow" for="comment-content" style="display:block;margin-bottom:var(--sp-2);">Letter *</label>
                        <textarea id="comment-content" name="content" rows="5" class="ink-input" required
                                  style="resize:vertical;border:1px solid var(--ink-black);padding:var(--sp-3);border-radius:var(--r-1);font-family:var(--serif);font-size:var(--fs-body);line-height:var(--lh-prose);"
                                  placeholder="Write your thoughts…">@draftContent</textarea>
                    </div>
                    <partial name="_CommentSpamFields" view-data="ViewData" />
                    @if (!string.IsNullOrEmpty(reCaptchaSiteKey))
                    {
                        <div>
                            <div class="g-recaptcha" data-sitekey="@reCaptchaSiteKey"></div>
                        </div>
                    }
                    <div>
                        <button type="submit" class="ink-btn">Post letter</button>
                    </div>
                </form>
            </div>
        </section>
    }
    else
    {
        <section class="max-w-4xl mx-auto px-4 py-8 lg:py-12" id="comments" tabindex="-1">
            <div>
                <h2 class="text-xl font-medium mb-6 border-b border-dashed pb-2" style="border-color: var(--border);">
                    Comments <span class="text-sm font-normal" style="color: var(--muted-foreground);">(@comments.Count)</span>
                </h2>
                @if (commentSuccess != null)
                {
                    <div class="mb-6 p-4 text-sm border border-dashed rounded-lg" role="status" style="background: var(--muted); border-color: var(--border);">@commentSuccess</div>
                }
                <div class="space-y-6 mb-10">
                    @foreach (var comment in comments)
                    {
                        <partial name="_CommentThread" model="comment" view-data="ViewData" />
                    }
                </div>
                <div class="p-6 border border-dashed rounded-xl" style="background: var(--muted); border-color: var(--border);">
                    <h3 class="text-lg font-medium mb-4" id="comment-form-heading">Leave a Reply</h3>
                    @if (mainFormError != null)
                    {
                        <div class="mb-4 p-4 text-sm border border-dashed rounded-lg" role="alert" id="comment-error" style="background: var(--muted); border-color: var(--border); color: var(--destructive);">@mainFormError</div>
                    }
                    <form method="post" action="/@Model.Slug/comment" class="space-y-4" aria-labelledby="comment-form-heading" aria-describedby="@(mainFormError != null ? "comment-error" : null)">
                        @Html.AntiForgeryToken()
                        <div class="grid md:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium mb-1" for="comment-name" style="color: var(--foreground);">Name *</label>
                                <input type="text" id="comment-name" name="authorName" class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-primary" style="background: var(--background); border-color: var(--border); color: var(--foreground);" required autocomplete="name" value="@draftName" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium mb-1" for="comment-email" style="color: var(--foreground);">Email *</label>
                                <input type="email" id="comment-email" name="authorEmail" class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-primary" style="background: var(--background); border-color: var(--border); color: var(--foreground);" required autocomplete="email" value="@draftEmail" />
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-1" for="comment-content" style="color: var(--foreground);">Comment *</label>
                            <textarea id="comment-content" name="content" rows="4" class="w-full px-4 py-2 border rounded-md focus:outline-none focus:ring-1 focus:ring-primary resize-y" style="background: var(--background); border-color: var(--border); color: var(--foreground);" required>@draftContent</textarea>
                        </div>
                        <partial name="_CommentSpamFields" view-data="ViewData" />
                        @if (!string.IsNullOrEmpty(reCaptchaSiteKey))
                        {
                            <div class="mb-2">
                                <div class="g-recaptcha" data-sitekey="@reCaptchaSiteKey"></div>
                            </div>
                        }
                        <button type="submit" class="px-6 py-2.5 font-medium text-sm rounded-md hover:opacity-90 transition-opacity" style="background: var(--primary); color: var(--primary-foreground);">Post Comment</button>
                    </form>
                </div>
            </div>
        </section>
    }

    <script>
        function toggleReplyForm(btn) {
            var form = btn.nextElementSibling;
            if (!form || !form.classList.contains('reply-form')) {
                form = btn.closest('.reply-form');
                if (form) {
                    form.classList.add('hidden');
                    var trigger = form.previousElementSibling;
                    if (trigger) { trigger.setAttribute('aria-expanded', 'false'); trigger.focus(); }
                }
                return;
            }
            var open = !form.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            if (open) { var first = form.querySelector('input:not([type=hidden]), textarea'); if (first) first.focus(); }
        }
    </script>
}
