@using Blog.Core.Interfaces
@model PagedResult<Blog.Core.Domain.Post>
@{
    Layout = "_PublicLayout";
    ViewData["SiteName"] = ViewBag.SiteName;
    ViewData["Tagline"] = ViewBag.Tagline;
    // Home sets the default title/description here; category & tag actions set their own before this runs.
    var searchQuery = ViewBag.SearchTerm as string;
    if (ViewData["Title"] == null)
        ViewData["Title"] = !string.IsNullOrWhiteSpace(searchQuery)
            ? $"Search: {searchQuery} – {(string)ViewBag.SiteName}"
            : (string)ViewBag.SiteName + " – " + (string)ViewBag.Tagline;
    if (ViewData["Description"] == null)
    {
        // Home page: enrich the (often short) tagline into a fuller, keyword-relevant meta
        // description built from the tenant's OWN categories — tenant-neutral, nothing hardcoded.
        var tagline = (string)(ViewBag.Tagline ?? "");
        var searchT = ViewBag.SearchTerm as string;
        var selCats = ViewBag.SelectedCategories as List<string> ?? new List<string>();
        var selTags = ViewBag.SelectedTags as List<string> ?? new List<string>();
        var isHome = string.IsNullOrEmpty(searchT) && !selCats.Any() && !selTags.Any() && Model.Page <= 1;
        if (isHome)
        {
            var catNames = (ViewBag.Categories as IEnumerable<Blog.Core.Domain.Category>)?
                .Select(c => c.Name).Take(3).ToList() ?? new List<string>();
            var homeDesc = catNames.Any()
                ? $"{tagline}. Compare {string.Join(", ", catNames)} and more — hands-on reviews, side-by-side comparisons, and practical buyer's guides."
                : $"{tagline}. Hands-on reviews, in-depth comparisons, and practical buyer's guides.";
            ViewData["Description"] = Blog.Core.Services.TextHelper.SmartTruncate(homeDesc, 158);
        }
        else
        {
            ViewData["Description"] = tagline;
        }
    }

    var blogLayout = (string)(ViewBag.LayoutIndex ?? "Neutral");

    // ── CollectionPage schema (listing pages: home / category / tag) ──────────
    var collBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var collData = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "CollectionPage",
        ["name"] = (string)(ViewData["Title"] ?? ViewBag.SiteName ?? ""),
        ["url"] = collBase + Context.Request.Path,
        ["isPartOf"] = new Dictionary<string, string> { ["@id"] = $"{collBase}/#website" }
    };
    var collDesc = (string)(ViewData["Description"] ?? "");
    if (!string.IsNullOrEmpty(collDesc)) collData["description"] = collDesc;
    var collOpts = new System.Text.Json.JsonSerializerOptions { WriteIndented = false };
}
<script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(collData, collOpts))</script>


@if (!string.IsNullOrWhiteSpace(searchQuery))
{
    <section class="ink-search-head" aria-labelledby="search-results-heading">
        <h1 id="search-results-heading">@(Model.TotalItems == 0 ? "No results" : Model.TotalItems == 1 ? "1 result" : $"{Model.TotalItems} results") for “@searchQuery”</h1>
        <p>@(Model.TotalItems == 0 ? "Try a shorter or more general word, or browse by category below." : Model.TotalPages > 1 ? $"Page {Model.Page} of {Model.TotalPages}." : "Sorted by relevance to the title, then by date.")</p>
        <form method="get" action="/search" role="search">
            <input type="search" name="q" value="@searchQuery" aria-label="Search articles" required minlength="2" />
            <button type="submit">Search</button>
            <a href="/">Clear</a>
        </form>
    </section>
}

