@using Blog.Core.Interfaces
@model PagedResult<Blog.Core.Domain.Post>
@{
    Layout = "_PublicLayout";
    ViewData["SiteName"] = ViewBag.SiteName;
    ViewData["Tagline"] = ViewBag.Tagline;
    // Home sets the default title/description here; category & tag actions set their own before this runs.
    var searchQuery = ViewBag.SearchTerm as string;
    if (ViewData["Title"] == null)
        ViewData["Title"] = !string.IsNullOrWhiteSpace(searchQuery)
            ? $"Search: {searchQuery} – {(string)ViewBag.SiteName}"
            : (string)ViewBag.SiteName + " – " + (string)ViewBag.Tagline;
    if (ViewData["Description"] == null)
    {
        // Home page: enrich the (often short) tagline into a fuller, keyword-relevant meta
        // description built from the tenant's OWN categories — tenant-neutral, nothing hardcoded.
        var tagline = (string)(ViewBag.Tagline ?? "");
        var searchT = ViewBag.SearchTerm as string;
        var selCats = ViewBag.SelectedCategories as List<string> ?? new List<string>();
        var selTags = ViewBag.SelectedTags as List<string> ?? new List<string>();
        var isHome = string.IsNullOrEmpty(searchT) && !selCats.Any() && !selTags.Any() && Model.Page <= 1;
        if (isHome)
        {
            var catNames = (ViewBag.Categories as IEnumerable<Blog.Core.Domain.Category>)?
                .Select(c => c.Name).Take(3).ToList() ?? new List<string>();
            var homeDesc = catNames.Any()
                ? $"{tagline}. Compare {string.Join(", ", catNames)} and more — hands-on reviews, side-by-side comparisons, and practical buyer's guides."
                : $"{tagline}. Hands-on reviews, in-depth comparisons, and practical buyer's guides.";
            ViewData["Description"] = Blog.Core.Services.TextHelper.SmartTruncate(homeDesc, 158);
        }
        else
        {
            ViewData["Description"] = tagline;
        }
    }

    var blogLayout = (string)(ViewBag.LayoutIndex ?? "Neutral");

    // Magazine draws its own masthead, section nav and footer, so the layout's Navbar and Footer
    // components must stay out. The flag has to be set HERE, in the view: a partial gets a copy of
    // ViewData, so a flag set inside _Index_Magazine never reached _PublicLayout and the home page
    // rendered two headers and two footers (issue #2, "theming doesn't work", 2026-10-31).
    if (blogLayout == "Magazine")
    {
        ViewData["HideLayoutChrome"] = true;
    }

    // ── CollectionPage schema (listing pages: home / category / tag) ──────────
    var collBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var collData = new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "CollectionPage",
        ["name"] = (string)(ViewData["Title"] ?? ViewBag.SiteName ?? ""),
        ["url"] = collBase + Context.Request.Path,
        ["isPartOf"] = new Dictionary<string, string> { ["@id"] = $"{collBase}/#website" }
    };
    var collDesc = (string)(ViewData["Description"] ?? "");
    if (!string.IsNullOrEmpty(collDesc)) collData["description"] = collDesc;
    var collOpts = new System.Text.Json.JsonSerializerOptions { WriteIndented = false };
}
<script type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(collData, collOpts))</script>


@{
    // Exactly one h1 on every listing page. Search results and category / tag archives get theirs here; a layout whose
    // hero prints a post title steps that down to h2 because ViewData["PageHasHeading"] is set. The home page's h1 is
    // always the site's own name and tagline, never the newest post's title: a heading that changes with every post
    // tells a search engine nothing stable about the site (2026-11-21: the live home page drew its impressions at
    // position 70 with a post title as its only h1). Only Magazine prints that heading visibly, in its masthead; every
    // other layout carries it visually hidden.
    var archiveHeading = ViewBag.ArchiveHeading as string;
    var archiveKind = ViewBag.ArchiveKind as string;
    var hasArchiveHeading = string.IsNullOrWhiteSpace(searchQuery) && !string.IsNullOrWhiteSpace(archiveHeading);
    var layoutsWithHomeHeading = new HashSet<string>(StringComparer.OrdinalIgnoreCase) { "Magazine" };
    var isHomeListing = string.IsNullOrWhiteSpace(searchQuery) && !hasArchiveHeading
        && !((ViewBag.SelectedCategories as List<string>)?.Any() ?? false) && !((ViewBag.SelectedTags as List<string>)?.Any() ?? false);
    var needsHiddenHeading = isHomeListing && (!layoutsWithHomeHeading.Contains(blogLayout) || Model.Page > 1 || !Model.Items.Any());
    if (!string.IsNullOrWhiteSpace(searchQuery) || hasArchiveHeading || needsHiddenHeading || !isHomeListing)
    {
        ViewData["PageHasHeading"] = true;
    }
}
@if (needsHiddenHeading || (!isHomeListing && string.IsNullOrWhiteSpace(searchQuery) && !hasArchiveHeading))
{
    // Site name, then the tagline on the first page of the home listing (the same words as the <title>).
    var homeHeadingTagline = isHomeListing && Model.Page <= 1 ? ((string?)ViewBag.Tagline ?? "").Trim() : "";
    <h1 class="ink-visually-hidden">@((string)ViewBag.SiteName)@(homeHeadingTagline.Length > 0 ? ": " + homeHeadingTagline : "")@(Model.Page > 1 ? $", page {Model.Page}" : "")</h1>
}
@if (hasArchiveHeading)
{
    <header class="ink-search-head ink-archive-head">
        <p class="ink-archive-head__kind">@archiveKind</p>
        <h1>@archiveHeading</h1>
        @if (ViewBag.ArchiveIntroHtml is string archiveIntro && archiveIntro.Length > 0)
        {
            @* Encoded and link-checked by ArchiveIntro.ToHtml; no author markup reaches this point. *@
            <div class="ink-archive-head__intro">@Html.Raw(archiveIntro)</div>
        }
        <p>@(Model.TotalItems == 0 ? "Nothing published here yet." : Model.TotalItems == 1 ? "1 article" : $"{Model.TotalItems} articles")@(Model.TotalPages > 1 ? $", page {Model.Page} of {Model.TotalPages}" : "")</p>
    </header>
}

@if (!string.IsNullOrWhiteSpace(searchQuery))
{
    <section class="ink-search-head" aria-labelledby="search-results-heading">
        <h1 id="search-results-heading">@(Model.TotalItems == 0 ? "No results" : Model.TotalItems == 1 ? "1 result" : $"{Model.TotalItems} results") for “@searchQuery”</h1>
        <p>@(Model.TotalItems == 0 ? "Try a shorter or more general word, or browse by category below." : Model.TotalPages > 1 ? $"Page {Model.Page} of {Model.TotalPages}." : "Sorted by relevance to the title, then by date.")</p>
        <form method="get" action="/search" role="search">
            <input type="search" name="q" value="@searchQuery" aria-label="Search articles" required minlength="2" />
            <button type="submit">Search</button>
            <a href="/">Clear</a>
        </form>
    </section>
}

@{
    // Nested categories: where this category sits and what lies beneath it. Plain links, shown by every layout.
    var categoryPath = ViewBag.CategoryPath as List<Blog.Core.Domain.Category>;
    var subcategories = ViewBag.Subcategories as List<Blog.Core.Domain.Category>;

    // BreadcrumbList for a category archive: Home, each category above this one, then this one. The same trail readers see.
    string? categoryBreadcrumb = null;
    if (categoryPath is { Count: > 0 })
    {
        var crumbs = new List<object> { new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "Home", ["item"] = collBase + "/" } };
        for (var i = 0; i < categoryPath.Count; i++)
            crumbs.Add(new Dictionary<string, object> { ["@type"] = "ListItem", ["position"] = i + 2, ["name"] = categoryPath[i].Name, ["item"] = collBase + "/category/" + categoryPath[i].Slug });
        categoryBreadcrumb = System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object> { ["@context"] = "https://schema.org", ["@type"] = "BreadcrumbList", ["itemListElement"] = crumbs }, collOpts);
    }
}
@if (categoryBreadcrumb is not null)
{
    <script type="application/ld+json">@Html.Raw(categoryBreadcrumb)</script>
}
@if ((categoryPath?.Count ?? 0) > 1 || (subcategories?.Count ?? 0) > 0)
{
    <nav class="ink-category-trail" aria-label="Category">
        @if (categoryPath is { Count: > 1 })
        {
            <ol>
                @for (var i = 0; i < categoryPath.Count; i++)
                {
                    if (i < categoryPath.Count - 1) { <li><a href="/category/@categoryPath[i].Slug">@categoryPath[i].Name</a></li> }
                    else { <li aria-current="page">@categoryPath[i].Name</li> }
                }
            </ol>
        }
        @if (subcategories is { Count: > 0 })
        {
            <ul aria-label="Subcategories">
                @foreach (var sub in subcategories)
                {
                    <li><a href="/category/@sub.Slug">@sub.Name</a></li>
                }
            </ul>
        }
    </nav>
}

