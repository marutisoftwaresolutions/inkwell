@using Blog.Core.Interfaces
@model PagedResult<Blog.Core.Domain.Post>
@{
    var searchTerm = ViewBag.SearchTerm as string;
    var selectedCategories = ViewBag.SelectedCategories as List<string> ?? new List<string>();
    var selectedTags = ViewBag.SelectedTags as List<string> ?? new List<string>();
    var qParts = new List<string>();
    if (!string.IsNullOrEmpty(searchTerm)) qParts.Add("search=" + Uri.EscapeDataString(searchTerm));
    if (selectedCategories.Any()) qParts.Add("category=" + string.Join(",", selectedCategories));
    if (selectedTags.Any()) qParts.Add("tags=" + string.Join(",", selectedTags));
    var baseQuery = qParts.Any() ? "&" + string.Join("&", qParts) : "";

    // Roundup posts lead — they're the money pages. Everything else follows underneath.
    var roundups = Model.Items.Where(p => p.IsRoundup).ToList();
    var articles = Model.Items.Where(p => !p.IsRoundup).ToList();
}

@* ── VERDICT LAYOUT — buyer's-guide index: roundups first, then articles ── *@
<div class="vd-wrap" style="padding-top:var(--sp-10);padding-bottom:var(--sp-12);">

    @if (!string.IsNullOrEmpty(searchTerm))
    {
        <p style="margin-bottom:var(--sp-8);font-size:var(--fs-sm);color:var(--fg-meta);">
            Results for <strong>"@searchTerm"</strong> — <a href="/" style="color:inherit;">clear</a>
        </p>
    }

    @if (!Model.Items.Any())
    {
        <p style="text-align:center;padding:var(--sp-16) 0;color:var(--fg-meta);">Nothing published yet.</p>
    }
    else
    {
        @if (roundups.Any())
        {
            <h2 style="margin-top:0;">Buyer's guides</h2>
            <div class="vd-picks">
                @foreach (var post in roundups)
                {
                    var data = post.Roundup!;
                    var top = data.Ranked.FirstOrDefault();
                    <a href="/@post.Slug" class="vd-pick" style="text-decoration:none;">
                        @if (!string.IsNullOrEmpty(post.FeatureImage))
                        {
                            <img src="@post.FeatureImage" alt="@post.Title" loading="lazy" decoding="async"
                                 style="width:100%;height:140px;object-fit:cover;border-radius:var(--r-2);"
                                 asp-append-version="true" />
                        }

                        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                            <span class="vd-badge">@data.Entries.Count compared</span>
                            @if (post.Categories.Any())
                            {
                                <span class="vd-chip">@post.Categories.First().Name</span>
                            }
                        </div>

                        <h3 class="vd-pick-name">@post.Title</h3>

                        @if (top is not null)
                        {
                            <p class="vd-pick-blurb">
                                <strong>Top pick:</strong> @top.Name
                                @if (top.Score > 0)
                                {
                                    <span class="vd-score-max">— @top.Score.ToString("0.0")/10</span>
                                }
                            </p>
                        }

                        <span class="vd-cta vd-cta--ghost" style="align-self:flex-start;">Read the guide →</span>
                    </a>
                }
            </div>
        }

        @if (articles.Any())
        {
            <h2 style="margin-top:var(--sp-12);">Latest articles</h2>
            <div class="vd-table-wrap">
                <table class="vd-table">
                    <tbody>
                        @foreach (var post in articles)
                        {
                            var readingMinutes = Math.Max(1, (post.Plaintext?.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length ?? 0) / 238);
                            <tr>
                                <td style="width:60%;">
                                    <a href="/@post.Slug" class="vd-table-name">@post.Title</a>
                                    @if (post.Categories.Any())
                                    {
                                        <div style="margin-top:4px;">
                                            <span class="vd-chip">@post.Categories.First().Name</span>
                                        </div>
                                    }
                                </td>
                                <td style="color:var(--fg-meta);font-size:var(--fs-sm);">
                                    @(string.IsNullOrEmpty(post.AuthorName) ? "Anonymous" : post.AuthorName)
                                </td>
                                <td style="color:var(--fg-meta);font-size:var(--fs-sm);white-space:nowrap;">
                                    @post.PublishedAt?.ToString("d MMM yyyy")
                                </td>
                                <td style="color:var(--fg-meta);font-size:var(--fs-sm);white-space:nowrap;">
                                    @readingMinutes min
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* Pagination *@
    @if (Model.TotalPages > 1)
    {
        <div style="margin-top:var(--sp-12);display:flex;align-items:center;justify-content:space-between;padding-top:var(--sp-8);border-top:1px solid var(--border);">
            @if (Model.Page > 1)
            {
                <a href="?page=@(Model.Page-1)@baseQuery" class="vd-cta vd-cta--ghost">← Newer</a>
            }
            else { <span></span> }
            <span style="font-size:var(--fs-xs);color:var(--fg-meta);">@Model.Page / @Model.TotalPages</span>
            @if (Model.Page < Model.TotalPages)
            {
                <a href="?page=@(Model.Page+1)@baseQuery" class="vd-cta vd-cta--ghost">Older →</a>
            }
            else { <span></span> }
        </div>
    }
</div>
