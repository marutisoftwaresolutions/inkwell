@model Blog.Web.Models.CommentRespondViewModel
@inject IConfiguration _rcfg
@{
    Layout = "_PublicLayout";
    var p = Model.Post;
    ViewData["Title"] = (Model.Parent is null ? "Comment on " : "Reply on ") + p.Title;
    ViewData["Robots"] = "noindex, follow";   // a form page, not content
    ViewData["Canonical"] = $"{Context.Request.Scheme}://{Context.Request.Host}/{p.Slug}";
    ViewData["CommentRequestToken"] = Model.RequestToken;
    ViewData["CommentFormToken"] = Model.FormToken;
    var reCaptchaSiteKey = _rcfg["ReCaptcha:SiteKey"];
    var parentName = Model.Parent is null ? null : string.IsNullOrEmpty(Model.Parent.AuthorName) ? "Anonymous" : Model.Parent.AuthorName;
}

<div class="max-w-2xl mx-auto px-4 py-10" style="color: var(--foreground);">
    <p class="text-sm mb-4"><a href="/@p.Slug#comments" class="underline">← Back to “@p.Title”</a></p>
    <h1 class="text-2xl font-medium mb-2">@(Model.Parent is null ? "Leave a comment" : $"Reply to {parentName}")</h1>
    @{ bool Bad(string field) => Model.Invalid?.Contains(field) == true; }
    @if (Model.Parent is not null)
    {
        <blockquote class="mb-6 ps-4 text-sm" style="border-inline-start: 3px solid var(--border); color: var(--muted-foreground);">@Model.Parent.Content</blockquote>
    }

    @if (Model.Message is not null)
    {
        <div class="mb-6 p-4 text-sm border border-dashed rounded-lg" role="@(Model.Sent ? "status" : "alert")" style="background: var(--muted); border-color: var(--border); color: var(--foreground);">
            @Model.Message
            @if (Model.Sent)
            {
                <a href="/@p.Slug#comments" class="underline ms-1">Return to the post</a>
            }
        </div>
    }

    @if (!Model.Sent)
    {
        <form method="post" action="/@p.Slug/comment" class="space-y-4" aria-label="@(Model.Parent is null ? "Comment" : "Reply")">
            @if (Model.Parent is not null)
            {
                <input type="hidden" name="parentId" value="@Model.Parent.Id" />
            }
            <partial name="_CommentSpamFields" view-data="ViewData" />
            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium mb-1" for="respond-name">Name *</label>
                    <input type="text" id="respond-name" name="authorName" value="@Model.Name" required autocomplete="name"
                           aria-invalid="@(Bad("authorName") ? "true" : null)" aria-describedby="@(Bad("authorName") ? "respond-name-error" : null)"
                           class="w-full px-4 py-2 border rounded-md" style="background: var(--background); border-color: var(--border); color: var(--foreground);" />
                    @if (Bad("authorName")) { <p id="respond-name-error" class="ink-form-field-error text-sm">Enter your name.</p> }
                </div>
                <div>
                    <label class="block text-sm font-medium mb-1" for="respond-email">Email *</label>
                    <input type="email" id="respond-email" name="authorEmail" value="@Model.Email" required autocomplete="email"
                           aria-invalid="@(Bad("authorEmail") ? "true" : null)" aria-describedby="@(Bad("authorEmail") ? "respond-email-error" : null)"
                           class="w-full px-4 py-2 border rounded-md" style="background: var(--background); border-color: var(--border); color: var(--foreground);" />
                    @if (Bad("authorEmail")) { <p id="respond-email-error" class="ink-form-field-error text-sm">Enter your email address.</p> }
                </div>
            </div>
            <div>
                <label class="block text-sm font-medium mb-1" for="respond-content">@(Model.Parent is null ? "Comment" : "Reply") *</label>
                <textarea id="respond-content" name="content" rows="6" required class="w-full px-4 py-2 border rounded-md resize-y"
                          aria-invalid="@(Bad("content") ? "true" : null)" aria-describedby="@(Bad("content") ? "respond-content-error" : null)"
                          style="background: var(--background); border-color: var(--border); color: var(--foreground);">@Model.Content</textarea>
                @if (Bad("content")) { <p id="respond-content-error" class="ink-form-field-error text-sm">Write your @(Model.Parent is null ? "comment" : "reply").</p> }
            </div>
            @if (!string.IsNullOrEmpty(reCaptchaSiteKey))
            {
                <div class="g-recaptcha" data-sitekey="@reCaptchaSiteKey"></div>
            }
            <button type="submit" class="px-6 py-2.5 font-medium text-sm rounded-md" style="background: var(--primary); color: var(--primary-foreground);">
                @(Model.Parent is null ? "Post comment" : "Post reply")
            </button>
        </form>
    }
</div>
