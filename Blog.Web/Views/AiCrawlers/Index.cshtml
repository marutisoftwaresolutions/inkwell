@using Blog.Core.Domain
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "AI Crawlers";
    ViewData["Description"] = "Which AI answer engines and search crawlers actually fetch this site, and what they read. Search Console reports generative-AI impressions without naming the engine — this names it. A crawler's name is self-declared, so each visit is checked against the network its operator publishes; visits that fail are someone else using the name and are left out of the totals, trend and top pages.";

    var ai       = (IReadOnlyList<CrawlerActivity>)ViewBag.Ai;
    var search   = (IReadOnlyList<CrawlerActivity>)ViewBag.Search;
    var topPages = (IReadOnlyList<CrawledPage>)ViewBag.TopPages;
    var queried  = (IReadOnlyList<CrawledRequest>)ViewBag.Queried;
    var daily    = (IReadOnlyList<CrawlerDay>)ViewBag.Daily;
    int days = ViewBag.Days, aiVisits = ViewBag.AiVisits, aiEngines = ViewBag.AiEngines;

    var peak = daily.Count > 0 ? daily.Max(d => d.Visits) : 0;

    string Ago(DateTime? utc)
    {
        if (utc is null) return "never";
        var d = DateTime.UtcNow - utc.Value;
        if (d.TotalHours < 1) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalDays < 1) return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }

    // What the network check found. "Not checkable" when the operator publishes no method.
    string Check(CrawlerActivity c)
    {
        if (c.Visits == 0) return "";
        if (Blog.Core.Services.CrawlerVerification.For(c.Crawler) is null) return "not checkable";
        var parts = new List<string>();
        if (c.VerifiedVisits > 0) parts.Add($"{c.VerifiedVisits:N0} verified");
        if (c.FailedVisits > 0) parts.Add($"{c.FailedVisits:N0} failed");
        var unchecked_ = c.Visits - c.VerifiedVisits - c.FailedVisits;
        if (unchecked_ > 0) parts.Add($"{unchecked_:N0} unchecked");
        return string.Join(" · ", parts);
    }
}

@section PageActions {
    <nav class="desk-tabs" aria-label="Period">
        @foreach (var d in new[] { 7, 30, 90 })
        {
            <a href="?days=@d" class="desk-tab" aria-current="@(days == d ? "page" : null)">Last @d days</a>
        }
    </nav>
}

<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
    <div class="desk-kpi">
        <div class="desk-kpi-value">@aiVisits.ToString("N0")</div>
        <div class="desk-kpi-label">AI crawler visits</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value @(aiEngines > 0 ? "tone-ok" : "tone-warn")">@aiEngines</div>
        <div class="desk-kpi-label">AI engines reading you</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value">@topPages.Count</div>
        <div class="desk-kpi-label">Pages fetched by AI</div>
    </div>
    <div class="desk-kpi">
        <div class="desk-kpi-value">@search.Sum(s => s.Visits).ToString("N0")</div>
        <div class="desk-kpi-label">Search crawler visits</div>
    </div>
</div>

@if (aiVisits == 0)
{
    <div class="mb-6 rounded-lg border pill-warn px-4 py-3 text-sm">
        No AI crawler has fetched this site in the last @days days. That is worth knowing: if the pages
        are not being read, no amount of answer-capsule or structured-data work can produce a citation.
        Check that <code>robots.txt</code> permits these agents, and that the site is reachable and indexed.
    </div>
}

@if (peak > 0)
{
    <div class="desk-card mb-6">
        <div class="desk-card-header">
            <h2 class="desk-card-title">AI crawler visits per day</h2>
        </div>
        <div class="desk-card-body">
        <div class="flex items-end gap-1 h-24" role="img" aria-label="AI crawler visits per day: @string.Join(", ", daily.Select(x => $"{x.Day:d MMM} {x.Visits}"))">
            @foreach (var d in daily)
            {
                var h = d.Visits == 0 ? 2 : (int)Math.Max(4, Math.Round(d.Visits * 100.0 / peak));
                <div class="flex-1 rounded-t @(d.Visits == 0 ? "bg-border" : "bg-primary/70")"
                     style="height:@(h)%"
                     title="@Dates.CalendarDate(d.Day, Blog.Core.Services.DateStyle.Medium): @d.Visits visits"></div>
            }
        </div>
        </div>
    </div>
}

<div class="desk-card overflow-hidden mb-6">
    <div class="desk-card-header">
        <h2 class="desk-card-title">AI answer engines</h2>
    </div>
    <div class="table-scroll"><table class="desk-table">
        <thead>
            <tr>
                <th>Crawler</th>
                <th>Operator</th>
                <th>What it is for</th>
                <th class="text-right">Visits</th>
                <th class="text-right">Pages</th>
                <th>Identity check</th>
                <th>Last seen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in ai)
            {
                <tr class="@(c.Visits == 0 ? "opacity-50" : "")">
                    <td class="font-mono text-xs text-foreground">@c.Crawler</td>
                    <td class="text-xs text-foreground">@c.Operator</td>
                    <td class="text-xs text-muted-foreground max-w-[22rem]">@c.Purpose</td>
                    <td class="text-right font-semibold @(c.Visits > 0 ? "text-foreground" : "text-muted-foreground")">@c.Visits.ToString("N0")</td>
                    <td class="text-right text-xs text-muted-foreground">@c.Pages</td>
                    <td class="text-xs @(c.FailedVisits > 0 ? "tone-bad" : "text-muted-foreground") whitespace-nowrap">@Check(c)</td>
                    <td class="text-xs text-muted-foreground whitespace-nowrap">@Ago(c.LastSeen)</td>
                </tr>
            }
        </tbody>
    </table></div>
</div>

@if (topPages.Count > 0)
{
    <div class="desk-card overflow-hidden mb-6">
        <div class="desk-card-header">
            <h2 class="desk-card-title">Pages AI engines read most</h2>
        </div>
        <div class="table-scroll"><table class="desk-table">
            <thead>
                <tr>
                    <th>Page</th>
                    <th class="text-right">Visits</th>
                    <th class="text-right">Engines</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in topPages)
                {
                    <tr>
                        <td>
                            <a href="@p.Path" target="_blank" rel="noopener" class="font-mono text-[11px] text-foreground hover:underline break-all">@p.Path</a>
                        </td>
                        <td class="text-right font-semibold text-foreground">@p.Visits.ToString("N0")</td>
                        <td class="text-right text-xs text-muted-foreground">@p.Crawlers</td>
                    </tr>
                }
            </tbody>
        </table></div>
    </div>
}

@* Many URLs share one path (/?page=…, /?p=…), so the page table above cannot say what crawlers
   actually fetch. Shown as text, never as a link: these are addresses crawlers chose, not ours. *@
<div class="desk-card overflow-hidden mb-6">
    <div class="desk-card-header">
        <h2 class="desk-card-title">Requests with a query string</h2>
        <p class="desk-card-description">What search and AI crawlers requested when the address carried parameters. Visits that failed the identity check are left out.</p>
    </div>
    @if (queried.Count == 0)
    {
        <p class="px-5 py-4 text-xs text-muted-foreground">No crawler requests with a query string in the last @days days. Visits recorded before this report existed were stored without one.</p>
    }
    else
    {
        <div class="table-scroll"><table class="desk-table">
            <thead>
                <tr>
                    <th>Path</th>
                    <th>Query string</th>
                    <th class="text-right">Visits</th>
                    <th class="text-right">Crawlers</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in queried)
                {
                    <tr>
                        <td class="font-mono text-[11px] text-foreground break-all">@r.Path</td>
                        <td class="font-mono text-[11px] text-muted-foreground break-all">?@r.Query</td>
                        <td class="text-right font-semibold text-foreground">@r.Visits.ToString("N0")</td>
                        <td class="text-right text-xs text-muted-foreground">@r.Crawlers</td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</div>

<details class="desk-card overflow-hidden">
    <summary class="px-5 py-4 cursor-pointer text-base font-semibold text-foreground">Search crawlers</summary>
    <div class="table-scroll"><table class="desk-table border-t border-border">
        <thead>
            <tr>
                <th>Crawler</th>
                <th>Operator</th>
                <th class="text-right">Visits</th>
                <th>Identity check</th>
                <th>Last seen</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in search)
            {
                <tr class="@(c.Visits == 0 ? "opacity-50" : "")">
                    <td class="font-mono text-xs text-foreground">@c.Crawler</td>
                    <td class="text-xs text-muted-foreground">@c.Operator</td>
                    <td class="text-right font-semibold text-foreground">@c.Visits.ToString("N0")</td>
                    <td class="text-xs @(c.FailedVisits > 0 ? "tone-bad" : "text-muted-foreground") whitespace-nowrap">@Check(c)</td>
                    <td class="text-xs text-muted-foreground whitespace-nowrap">@Ago(c.LastSeen)</td>
                </tr>
            }
        </tbody>
    </table></div>
</details>

<p class="text-[11px] text-muted-foreground mt-3">
    A user-agent is self-asserted and can be forged, so this shows <em>claimed</em> identity. It is a
    visibility report and is never used to allow or deny a request — the firewall decides that on
    behaviour, not on a name.
</p>
<p class="text-[11px] text-muted-foreground mt-1">
    Visits are kept for <strong>@ViewBag.RetentionDays days</strong> and pruned nightly; change the window under Admin → Settings.
</p>
