@model IEnumerable<Blog.Core.Domain.Series>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Series";
}

<div class="flex flex-col gap-6">

    @if (TempData["Success"] != null)
    {
        <div class="rounded-md border border-border bg-primary/10 text-foreground px-4 py-3 text-sm">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="rounded-md border border-destructive/40 bg-destructive/10 text-destructive px-4 py-3 text-sm">@TempData["Error"]</div>
    }

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- List -->
        <div class="md:col-span-2 space-y-4">
            <div class="bg-card rounded-lg border border-border overflow-hidden">
                <partial name="_ListSearch" />
<div class="table-scroll"><table class="w-full text-left text-sm">
                    <thead>
                        <tr class="bg-muted text-muted-foreground border-b border-border">
                            <th class="px-4 py-3 font-medium">Title</th>
                            <th class="px-4 py-3 font-medium">Slug</th>
                            <th class="px-4 py-3 font-medium w-[80px]">Posts</th>
                            <th class="px-4 py-3 font-medium w-[120px]">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="px-4 py-8 text-center text-muted-foreground">
                                    No series yet. Create one to group posts into an ordered reading sequence.
                                </td>
                            </tr>
                        }
                        @foreach (var series in Model)
                        {
                            <tr class="group hover:bg-muted/50 transition-colors">
                                <td class="px-4 py-3 font-medium">
                                    <a href="/admin/series/edit/@series.Id" class="hover:text-primary hover:underline">@series.Title</a>
                                </td>
                                <td class="px-4 py-3 text-muted-foreground">@series.Slug</td>
                                <td class="px-4 py-3 text-muted-foreground">@series.PostCount</td>
                                <td class="px-4 py-3">
                                    <div class="flex items-center gap-2">
                                        <a href="/admin/series/edit/@series.Id" class="text-muted-foreground hover:text-primary transition-colors p-1 rounded hover:bg-muted" title="Edit / manage posts" aria-label="Edit series @series.Title">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                                        </a>
                                        <form method="post" action="/admin/series/delete/@series.Id" data-confirm-title="Delete this series?" data-confirm-body="“@series.Title” groups @series.PostCount post(s). The posts are kept; only the grouping, its Part N of M navigation and /series/@series.Slug are removed." data-confirm-action="Delete series" data-confirm-tone="danger">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" aria-label="Delete series @series.Title" class="text-destructive hover:text-destructive/80 transition-colors p-1 rounded hover:bg-destructive/10">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table></div>
<partial name="_ListPager" />
            </div>
        </div>

        <!-- Create Form -->
        <div class="md:col-span-1">
            <div class="bg-card rounded-lg border border-border p-4 sticky top-6">
                <h2 class="font-semibold mb-4">Add New Series</h2>
                <form method="post" action="/admin/series/create" class="space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="block text-sm font-medium mb-1">Title</label>
                        <input type="text" name="title" id="seriesTitle" required class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" placeholder="e.g. Getting Started with Optical Retail" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Slug</label>
                        <input type="text" name="slug" id="seriesSlug" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" placeholder="optional — auto-generated from title" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Description</label>
                        <textarea name="description" rows="3" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" placeholder="Optional — shown on the series page."></textarea>
                    </div>
                    <button type="submit" class="w-full px-4 py-2 bg-primary text-primary-foreground hover:bg-primary/90 rounded-md text-sm font-medium shadow-sm transition-colors">
                        Add Series
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function slugify(v) {
        return v.toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/[\s_]+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-+|-+$/g, '');
    }
    document.getElementById('seriesTitle').addEventListener('input', function () {
        document.getElementById('seriesSlug').value = slugify(this.value);
    });
    document.getElementById('seriesSlug').addEventListener('input', function () {
        this.value = slugify(this.value);
    });
</script>
