@model IEnumerable<Blog.Core.Domain.Series>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Series";
    ViewData["Description"] = "Group posts into an ordered reading sequence with Part N of M navigation.";
    var listQuery = ViewData[Blog.Web.Models.ListPaging.QueryKey] as string ?? "";
}

<div class="flex flex-col gap-6">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- List -->
        <div class="md:col-span-2 space-y-4">
            <partial name="_ListSearch" />
            <div class="desk-card overflow-hidden">
                @if (!Model.Any())
                {
                    if (!string.IsNullOrEmpty(listQuery)) { ViewData["EmptyQuery"] = listQuery; }
                    else
                    {
                        ViewData["EmptyTitle"] = "No series yet";
                        ViewData["EmptyHint"] = "Add the first one on the right to group posts into an ordered reading sequence.";
                    }
                    <partial name="_EmptyState" />
                }
                else
                {
                <div class="table-scroll"><table class="desk-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Slug</th>
                            <th class="w-[80px]">Posts</th>
                            <th class="w-[120px] text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var series in Model)
                        {
                            <tr>
                                <td class="font-medium">
                                    <a href="/admin/series/edit/@series.Id" class="hover:text-primary hover:underline">@series.Title</a>
                                </td>
                                <td class="text-muted-foreground">@series.Slug</td>
                                <td class="text-muted-foreground">@series.PostCount</td>
                                <td>
                                    <div class="desk-row-actions">
                                        <a href="/admin/series/edit/@series.Id" class="desk-btn desk-btn-ghost desk-btn-icon desk-btn-sm" title="Edit / manage posts" aria-label="Edit series @series.Title">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4z"/></svg>
                                        </a>
                                        <form method="post" action="/admin/series/delete/@series.Id" data-confirm-title="Delete this series?" data-confirm-body="“@series.Title” groups @series.PostCount post(s). The posts are kept; only the grouping, its Part N of M navigation and /series/@series.Slug are removed." data-confirm-action="Delete series" data-confirm-tone="danger">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" aria-label="Delete series @series.Title" class="desk-btn desk-btn-ghost desk-btn-icon desk-btn-sm text-destructive hover:bg-destructive/10 hover:text-destructive">
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table></div>
                }
            </div>
            <partial name="_ListPager" />
        </div>

        <!-- Create Form -->
        <div class="md:col-span-1">
            <div class="desk-card sticky top-20">
                <div class="desk-card-header">
                    <h2 class="desk-card-title">Add new series</h2>
                </div>
                <form method="post" action="/admin/series/create" class="desk-card-body space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="desk-label" for="seriesTitle">Title</label>
                        <input type="text" name="title" id="seriesTitle" required class="desk-input" placeholder="e.g. Getting Started with Optical Retail" />
                    </div>
                    <div>
                        <label class="desk-label" for="seriesSlug">Slug</label>
                        <input type="text" name="slug" id="seriesSlug" class="desk-input" placeholder="optional — auto-generated from title" />
                    </div>
                    <div>
                        <label class="desk-label" for="seriesDescription">Description</label>
                        <textarea name="description" id="seriesDescription" rows="3" class="desk-textarea" placeholder="Optional — shown on the series page."></textarea>
                    </div>
                    <button type="submit" class="desk-btn desk-btn-primary w-full">
                        Add series
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function slugify(v) {
        return v.toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/[\s_]+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-+|-+$/g, '');
    }
    document.getElementById('seriesTitle').addEventListener('input', function () {
        document.getElementById('seriesSlug').value = slugify(this.value);
    });
    document.getElementById('seriesSlug').addEventListener('input', function () {
        this.value = slugify(this.value);
    });
</script>
