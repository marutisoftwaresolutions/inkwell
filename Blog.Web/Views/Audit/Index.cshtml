@using Blog.Core.Domain
@{
	Layout = "_AdminLayout";
	ViewData["Title"] = "Audit Trail";

	var items = (IReadOnlyList<AuditLog>)ViewBag.Items;
	var total = (int)ViewBag.Total;

	ViewData["Description"] = $"{total:N0} total entries. Admin-only and read-only: nothing here can be edited or removed.";

	string? filterEntityType = ViewBag.FilterEntityType;
	string? filterAction = ViewBag.FilterAction;
	string? filterUserId = ViewBag.FilterUserId;
	string? filterFrom = ViewBag.FilterFrom;
	string? filterTo = ViewBag.FilterTo;
	var filtered = filterEntityType != null || filterAction != null || filterUserId != null || filterFrom != null || filterTo != null;

	var entityTypes = (string[])ViewBag.EntityTypes;
	var allUsers = (List<(Guid Id, string Name)>)ViewBag.AllUsers;

	string Qs(int p) =>
		$"?page={p}" +
		(filterEntityType != null ? $"&entityType={Uri.EscapeDataString(filterEntityType)}" : "") +
		(filterAction != null ? $"&action={Uri.EscapeDataString(filterAction)}" : "") +
		(filterUserId != null ? $"&userId={Uri.EscapeDataString(filterUserId)}" : "") +
		(filterFrom != null ? $"&from={Uri.EscapeDataString(filterFrom)}" : "") +
		(filterTo != null ? $"&to={Uri.EscapeDataString(filterTo)}" : "");

	string BadgeColor(string action) => action switch
	{
		var a when a.Contains("Deleted") => "pill-bad",
		var a when a.Contains("Created") => "pill-ok",
		var a when a.Contains("Published") => "pill-info",
		var a when a.Contains("LoggedIn") => "pill-info",
		var a when a.Contains("Failed") => "pill-warn",
		_ => "desk-pill-muted"
	};
}

@section PageActions {
	<a href="/admin/audit/export/csv@Qs(1)" class="desk-btn desk-btn-outline">
		<svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
		Export CSV
	</a>
}

@* Filter bar *@
<form method="get" class="flex flex-wrap items-center gap-2 mb-5">
	<input type="hidden" name="page" value="1" />

	<select name="entityType" aria-label="Filter by entity type" class="desk-select desk-select-sm w-auto">
		<option value="">All types</option>
		@foreach (var et in entityTypes)
		{
			<option value="@et" selected="@(filterEntityType == et)">@et</option>
		}
	</select>

	<input type="text" name="action" value="@filterAction" placeholder="Action (e.g. Post.Published)" aria-label="Filter by action" class="desk-input desk-input-sm w-48" />

	<select name="userId" aria-label="Filter by user" class="desk-select desk-select-sm w-auto">
		<option value="">All users</option>
		@foreach (var u in allUsers)
		{
			<option value="@u.Id" selected="@(filterUserId == u.Id.ToString())">@u.Name</option>
		}
	</select>

	<input type="date" name="from" value="@filterFrom" aria-label="From date" class="desk-input desk-input-sm w-auto" />
	<span class="text-xs text-muted-foreground">to</span>
	<input type="date" name="to" value="@filterTo" aria-label="To date" class="desk-input desk-input-sm w-auto" />

	<button type="submit" class="desk-btn desk-btn-primary desk-btn-sm">Filter</button>
	@if (filtered)
	{
		<a href="/admin/audit" class="desk-btn desk-btn-ghost desk-btn-sm">Clear</a>
	}
</form>

@* Table *@
<div class="desk-card overflow-hidden">
	@if (items.Count == 0)
	{
		ViewData["EmptyTitle"] = filtered ? "No audit entries match these filters" : "No audit entries yet";
		ViewData["EmptyHint"] = filtered ? "Widen the date range or clear the filters to see every entry." : "Every create, update, delete and sign-in is recorded here as it happens.";
		ViewData["EmptyIcon"] = "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\" /><polyline points=\"14 2 14 8 20 8\" />";
		<partial name="_EmptyState" />
	}
	else
	{
		<div class="table-scroll"><table class="desk-table desk-table-compact text-xs">
			<thead>
				<tr>
					<th>Time (UTC)</th>
					<th>User</th>
					<th>Action</th>
					<th>Entity</th>
					<th>Name / ID</th>
					<th>IP</th>
					<th><span class="sr-only">Details</span></th>
				</tr>
			</thead>
			<tbody>
				@foreach (var row in items)
				{
					var rowId = $"row-{row.Id}";
					var hasDetail = row.OldValues != null || row.NewValues != null;
					<tr>
							<td class="text-muted-foreground whitespace-nowrap font-mono">
								@Dates.DateTimeSeconds(row.CreatedAt)
							</td>
							<td class="font-medium text-foreground">@row.UserName</td>
							<td>
								<span class="desk-pill @BadgeColor(row.Action)">
									@row.Action
								</span>
							</td>
							<td class="text-muted-foreground">@row.EntityType</td>
							<td class="text-foreground truncate max-w-[200px]" title="@row.EntityName">
								@(row.EntityName ?? row.EntityId ?? "—")
							</td>
							<td class="text-muted-foreground font-mono">@(row.IpAddress ?? "—")</td>
							<td class="whitespace-nowrap">
								@if (hasDetail)
								{
									<button type="button" aria-expanded="false" aria-controls="@rowId" aria-label="Details for @row.Action @(row.EntityName ?? row.EntityId)"
											class="desk-btn desk-btn-outline desk-btn-sm h-6 px-2 text-[10px]"
											onclick="var r=document.getElementById('@rowId'); r.hidden=!r.hidden; this.setAttribute('aria-expanded', String(!r.hidden));">Details</button>
								}
							</td>
						</tr>
						@if (hasDetail)
						{
							<tr id="@rowId" hidden class="bg-muted/20">
								<td colspan="7">
									<div class="grid grid-cols-1 md:grid-cols-2 gap-3">
										@if (row.OldValues != null)
										{
											<div>
												<p class="desk-section-title mb-1">Before</p>
												<pre class="text-[10px] bg-background border border-border rounded p-2 overflow-auto max-h-32 text-foreground">@row.OldValues</pre>
											</div>
										}
										@if (row.NewValues != null)
										{
											<div>
												<p class="desk-section-title mb-1">After</p>
												<pre class="text-[10px] bg-background border border-border rounded p-2 overflow-auto max-h-32 text-foreground">@row.NewValues</pre>
											</div>
										}
									</div>
								</td>
							</tr>
						}
					}
				</tbody>
			</table></div>
		}
	</div>

	<partial name="_ListPager" />
