@model IEnumerable<Blog.Core.Domain.Tag>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tags";
    ViewData["Description"] = "Free-form labels readers can browse at /tag/{slug}.";
    var listQuery = ViewData[Blog.Web.Models.ListPaging.QueryKey] as string ?? "";
}

<div class="flex flex-col gap-6">

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- List -->
        <div class="md:col-span-2 space-y-4">
            <partial name="_ListSearch" />
            <div class="desk-card overflow-hidden">
                @if (!Model.Any())
                {
                    if (!string.IsNullOrEmpty(listQuery)) { ViewData["EmptyQuery"] = listQuery; }
                    else
                    {
                        ViewData["EmptyTitle"] = "No tags yet";
                        ViewData["EmptyHint"] = "Add one on the right.";
                    }
                    <partial name="_EmptyState" />
                }
                else
                {
                <div class="table-scroll"><table class="desk-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Slug</th>
                            <th class="w-[100px] text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tag in Model)
                        {
                            <tr>
                                <td class="font-medium">@tag.Name</td>
                                <td class="text-muted-foreground">@tag.Slug</td>
                                <td>
                                    <form method="post" action="/admin/tags/delete/@tag.Id" class="desk-row-actions" data-confirm-title="Delete this tag?" data-confirm-body="“@tag.Name” is removed from every post that carries it and /tag/@tag.Slug will return 404. The posts themselves are untouched." data-confirm-action="Delete tag" data-confirm-tone="danger">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" aria-label="Delete tag @tag.Name" class="desk-btn desk-btn-ghost desk-btn-icon desk-btn-sm text-destructive hover:bg-destructive/10 hover:text-destructive">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table></div>
                }
            </div>
            <partial name="_ListPager" />
        </div>

        <!-- Create Form -->
        <div class="md:col-span-1">
            <div class="desk-card sticky top-20">
                <div class="desk-card-header">
                    <h2 class="desk-card-title">Add new tag</h2>
                </div>
                <form method="post" action="/admin/tags/create" class="desk-card-body space-y-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="desk-label" for="tagName">Name</label>
                        <input type="text" name="name" id="tagName" required class="desk-input" placeholder="e.g. Tutorial" />
                    </div>
                    <div>
                        <label class="desk-label" for="tagSlug">Slug</label>
                        <input type="text" name="slug" id="tagSlug" class="desk-input" placeholder="e.g. tutorial (optional)" />
                    </div>
                    <button type="submit" class="desk-btn desk-btn-primary w-full">
                        Add tag
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('tagName').addEventListener('input', function() {
        const slugInput = document.getElementById('tagSlug');
        slugInput.value = this.value.toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/[\s_]+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-+|-+$/g, '');
    });

    document.getElementById('tagSlug').addEventListener('input', function() {
        this.value = this.value.toLowerCase()
            .replace(/[^a-z0-9\s-]/g, '')
            .replace(/[\s_]+/g, '-')
            .replace(/-+/g, '-')
            .replace(/^-+|-+$/g, '');
    });
</script>
