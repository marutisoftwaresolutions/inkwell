@model Blog.Web.Controllers.WebhookEditModel
@using Blog.Core.Domain
@{
    Layout = "_AdminLayout";
    var isNew = Model.IsNew;
    ViewData["Title"] = isNew ? "New webhook" : "Edit webhook";
    ViewData["Description"] = "A signed JSON request is sent to the address below each time a chosen event happens.";
    var errCls = "desk-error block";
}

@section PageActions {
    @if (!isNew)
    {
        <a href="/admin/webhooks/@Model.Id/deliveries" class="desk-btn desk-btn-ghost">Delivery log</a>
    }
    <a href="/admin/webhooks" class="desk-btn desk-btn-outline">Cancel</a>
    <button type="submit" form="webhook-form" class="desk-btn desk-btn-primary">@(isNew ? "Create webhook" : "Save")</button>
}

<form id="webhook-form" method="post" action="/admin/webhooks/save" data-track-changes novalidate class="max-w-2xl space-y-6">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="IsNew" />

    <div class="flex flex-wrap items-center justify-between gap-3">
        <span data-dirty-indicator hidden class="desk-pill pill-warn">Unsaved changes</span>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-sm text-destructive"></div>

    <section class="desk-card desk-card-body space-y-4">
        <div>
            <label asp-for="Name" class="desk-label">Name</label>
            <input asp-for="Name" class="desk-input" maxlength="100" placeholder="e.g. Rebuild static site" />
            <span asp-validation-for="Name" class="@errCls"></span>
        </div>
        <div>
            <label asp-for="Url" class="desk-label">Payload URL</label>
            <input asp-for="Url" type="url" class="desk-input font-mono" maxlength="2048" placeholder="https://example.com/hooks/inkwell" aria-describedby="url-help" />
            <span id="url-help" class="desk-hint block">A public address starting with https:// (http:// is accepted but not encrypted). Addresses on this server or a private network are refused.</span>
            <span asp-validation-for="Url" class="@errCls"></span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <input asp-for="IsEnabled" type="checkbox" class="desk-checkbox" aria-describedby="enabled-help" />
            <label asp-for="IsEnabled" class="text-sm">Send events</label>
            <span id="enabled-help" class="text-xs text-muted-foreground">Turn off to pause this webhook: events are not queued and nothing is sent.</span>
        </div>
    </section>

    <fieldset class="desk-card desk-card-body space-y-3">
        <legend class="text-sm font-medium px-1">Events</legend>
        @foreach (var (name, description) in WebhookEvents.All)
        {
            var id = "event-" + name.Replace('.', '-');
            <div class="flex items-start gap-2">
                <input type="checkbox" id="@id" name="Events" value="@name" checked="@Model.Events.Contains(name)" class="desk-checkbox mt-0.5" />
                <label for="@id" class="text-sm">
                    <span class="font-mono text-xs text-foreground">@name</span>
                    <span class="block text-xs text-muted-foreground">@description</span>
                </label>
            </div>
        }
        <span asp-validation-for="Events" class="@errCls"></span>
    </fieldset>

    <section class="desk-card desk-card-body space-y-2">
        <label asp-for="Secret" class="desk-label">Signing secret</label>
        <div class="flex flex-wrap gap-2">
            <input asp-for="Secret" autocomplete="off" aria-describedby="secret-help" spellcheck="false" class="desk-input font-mono min-w-0 flex-1"
                   placeholder="@(isNew ? "" : "Leave blank to keep the current secret")" />
            <button type="button" id="webhook-secret-generate" class="desk-btn desk-btn-outline">Generate</button>
            <button type="button" id="webhook-secret-copy" class="desk-btn desk-btn-outline">Copy</button>
        </div>
        <span id="secret-help" class="desk-hint block">
            Used to sign every request (<code>X-Inkwell-Signature</code>). Copy it into the receiving service now:
            it is stored encrypted and never shown again. @(isNew ? "" : "Enter a new one only if you are rotating it.")
        </span>
        <span asp-validation-for="Secret" class="@errCls"></span>
    </section>
</form>

<script>
    (function () {
        var input = document.getElementById('Secret');
        document.getElementById('webhook-secret-generate').addEventListener('click', function () {
            var bytes = new Uint8Array(32);
            crypto.getRandomValues(bytes);
            var s = btoa(String.fromCharCode.apply(null, bytes)).replace(/=+$/, '').replace(/\+/g, '-').replace(/\//g, '_');
            input.value = s;
            input.dispatchEvent(new Event('input', { bubbles: true }));
        });
        function say(message, type) { if (window.InkwellDialog) InkwellDialog.toast(type || 'info', message); }
        function selectForManualCopy() {
            input.focus();
            input.select();
            say('Press Ctrl+C (or ⌘C) to copy the selected secret.');
        }
        // Always answer: an empty field, a missing clipboard (plain http) and a refused one each say what to do.
        document.getElementById('webhook-secret-copy').addEventListener('click', function () {
            if (!input.value) { say('Generate or enter a secret first.'); input.focus(); return; }
            if (!navigator.clipboard) { selectForManualCopy(); return; }
            navigator.clipboard.writeText(input.value).then(function () { say('Secret copied.', 'success'); }, selectForManualCopy);
        });
    })();
</script>
