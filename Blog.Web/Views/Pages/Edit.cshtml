@model Blog.Core.Domain.Page

@{
    Layout = "_AdminLayout";
    ViewData["HideHeader"] = true; // the editor carries its own toolbar; the layout breadcrumb still names the page
    ViewData["Title"] = "Edit " + Model.Title;
    ViewData["EditorNoun"] = "page";
    ViewData["EditorBase"] = "/admin/pages";
    ViewData["EditorForm"] = "pageForm";
}

<div class="md:h-[calc(100vh-7.5rem)] flex flex-col" id="pageBuilderApp">
    <form method="post" action="/admin/pages/edit/@Model.Id" id="pageForm" data-track-changes class="flex-1 flex flex-col h-full">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Content" id="pageContent" value="@Model.Content" />
        <input type="hidden" name="EditorMode" value="@Model.EditorMode" />

        <!-- Top Toolbar -->
        <div class="flex items-center justify-between mb-3 gap-3 flex-wrap sm:flex-nowrap sticky top-14 md:static z-20 bg-background/95 backdrop-blur md:bg-transparent md:backdrop-blur-none -mx-4 px-4 py-2 md:mx-0 md:px-0 md:py-0 border-b border-border md:border-0">
            <div class="flex items-center gap-4 min-w-0 flex-1">
                <a href="/admin/pages" class="text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1 text-sm font-medium">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                    Back
                </a>
                <span class="text-xs text-muted-foreground hidden sm:inline-block border-l border-border pl-4">Editing: <span class="font-mono">@Model.Slug</span></span>
                <input type="text" name="Title" id="pageTitle" value="@Model.Title" aria-label="Title" placeholder="Page title…" required
                       class="text-xl font-bold bg-transparent focus:outline-none placeholder:text-muted-foreground/40 min-w-0 flex-1 sm:flex-none sm:w-64 border-b border-transparent focus:border-primary transition-colors" />
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <span data-dirty-indicator hidden>Unsaved changes</span>
                <button type="submit" form="editorModeForm" data-editor-switch data-editor-draft-safe="@(Model.IsPublished ? "false" : "true")" class="hidden md:inline-flex px-3 py-1.5 text-xs font-medium text-muted-foreground hover:text-foreground underline underline-offset-2 rounded-md focus-visible:ring-2 focus-visible:ring-ring">@(Model.IsMarkdown ? "Use the visual editor" : "Write in Markdown")</button>
                <button type="submit" name="action" value="draft" class="desk-btn desk-btn-outline desk-btn-sm">
                    @(Model.IsPublished ? "Unpublish" : "Save Draft")
                </button>
                <button type="button" id="publishBtn" class="desk-btn desk-btn-primary desk-btn-sm">
                    @(Model.IsPublished ? "Update" : "Publish")
                </button>
                <button type="button" id="settingsToggle" onclick="toggleSettingsPanel()" aria-label="Page settings" aria-expanded="false" aria-controls="settingsPanel" class="md:hidden desk-btn desk-btn-outline desk-btn-icon desk-btn-sm">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                </button>
            </div>
        </div>



        <div class="flex-1 flex gap-0 overflow-hidden rounded-xl border border-border shadow-sm">

            <!-- LEFT: Component Palette -->
            @{ ViewData["BuilderForms"] = true; ViewData["PaletteHidden"] = Model.IsMarkdown; }
            <partial name="_BuilderPalette" />

            <!-- CENTER: Canvas, or the Markdown source (ADR-0022) -->
            @if (Model.IsMarkdown)
            {
                <div class="flex-1 flex flex-col bg-card overflow-hidden min-w-0"><partial name="_MarkdownPane" model="Model" /></div>
            }
            <div class="flex-1 overflow-y-auto bg-muted/20" id="canvasScroll" hidden="@Model.IsMarkdown">
                <div class="max-w-3xl mx-auto py-8 px-6 min-h-full" id="canvas">
                    <div id="canvasEmpty" class="flex flex-col items-center justify-center py-20 text-center" style="display:none;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" class="text-muted-foreground/30 mb-4"><rect x="3" y="3" width="18" height="18" rx="2"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                        <p class="text-muted-foreground/50 text-sm font-medium">Drag components here to start building</p>
                    </div>
                </div>
            </div>

            <!-- RIGHT: Settings Panel -->
            <aside id="settingsPanel" class="hidden md:flex flex-col fixed inset-0 z-40 md:static md:inset-auto md:z-auto w-full md:w-72 bg-card md:border-l border-border overflow-y-auto shrink-0" aria-labelledby="settingsPanelTitle">
                <div id="pageSettingsView" class="p-4">
                    <div class="flex items-center justify-between mb-4">
                        <h3 id="settingsPanelTitle" class="font-semibold text-sm">Page Settings</h3>
                        <button type="button" data-settings-close onclick="toggleSettingsPanel(false)" aria-label="Close page settings" class="md:hidden h-8 w-8 inline-flex items-center justify-center rounded-md border border-input hover:bg-muted">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </button>
                    </div>
                    <div class="md:hidden mb-4">
                        <button type="submit" form="editorModeForm" data-editor-switch data-editor-draft-safe="@(Model.IsPublished ? "false" : "true")" class="w-full min-h-10 px-3 border border-input rounded-md text-sm font-medium hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring">@(Model.IsMarkdown ? "Use the visual editor" : "Write in Markdown")</button>
                    </div>
                    <details class="group" data-desk-section="page-publishing" open>
                    <summary class="cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden flex items-center justify-between py-2 text-sm font-semibold text-foreground">
                        <span>Publishing</span>
                        <svg class="transition-transform group-open:rotate-180 text-muted-foreground" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                    <div class="space-y-4 pt-2 pb-4">
                        <div>
                            <label class="block text-xs font-medium mb-1 text-muted-foreground">URL Slug</label>
                            <input type="text" name="Slug" id="slugInput" value="@Model.Slug" placeholder="auto-generated" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium mb-1 text-muted-foreground">Sort Order</label>
                            <input type="number" name="SortOrder" value="@Model.SortOrder" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                        </div>
                        <div class="pt-3 border-t border-border">
                            <label class="block text-xs font-medium mb-2 text-muted-foreground">Featured Image</label>
                            <input type="hidden" name="FeaturedImageId" id="FeaturedImageIdInput" value="@Model.FeaturedImageId" />
                            <input type="hidden" name="FeaturedImageUrl" id="FeaturedImageUrlInput" value="@Model.FeaturedImageUrl" />
                            <img id="FeaturedImagePreview" src="@Model.FeaturedImageUrl" alt="" class="w-full h-auto rounded-md mb-2 border border-border @(string.IsNullOrEmpty(Model.FeaturedImageUrl) ? "hidden" : "")" />
                            <button type="button" onclick="window.dispatchEvent(new CustomEvent('open-media-selector', { detail: { targetInput: 'FeaturedImageUrlInput', targetIdInput: 'FeaturedImageIdInput', previewImg: 'FeaturedImagePreview' } }))"
                                    class="w-full px-3 py-2 bg-secondary text-secondary-foreground hover:bg-secondary/80 border border-border rounded-md text-xs font-medium flex items-center justify-center gap-1.5">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                Select Image
                            </button>
                            <button type="button" onclick="document.getElementById('FeaturedImageUrlInput').value='';document.getElementById('FeaturedImageIdInput').value='';document.getElementById('FeaturedImagePreview').classList.add('hidden');this.classList.add('hidden');"
                                    class="mt-1 text-xs text-destructive hover:underline @(string.IsNullOrEmpty(Model.FeaturedImageUrl) ? "hidden" : "")" id="RemoveFeaturedImageBtn">Remove</button>
                        </div>
                        
                        <div class="pt-3 border-t border-border">
                            <label class="block text-xs font-semibold text-muted-foreground uppercase tracking-widest mb-2">Revisions</label>
                            <div hx-get="/admin/revisions/page/@Model.Id" hx-trigger="load" hx-swap="innerHTML">
                                <p class="text-[11px] text-muted-foreground">Loading history…</p>
                            </div>
                        </div>

                    </div>
                    </details>

                    @await Html.PartialAsync("_AccessibilityChecks", Model.Content ?? string.Empty)

                    <partial name="_CustomFieldsPanel" />

                    <details class="group border-t border-border" data-desk-section="page-seo">
                    <summary class="cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden flex items-center justify-between py-2 text-sm font-semibold text-foreground">
                        <span>SEO and social</span>
                        <svg class="transition-transform group-open:rotate-180 text-muted-foreground" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
                    </summary>
                        <div class="pt-2 pb-4 space-y-3">

                            <div>
                                <label class="block text-[10px] font-medium mb-1 text-muted-foreground">Meta Title</label>
                                <input type="text" name="MetaTitle" value="@Model.MetaTitle" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                            </div>
                            
                            <div>
                                <label class="block text-[10px] font-medium mb-1 text-muted-foreground">Meta Description</label>
                                <textarea name="MetaDescription" rows="2" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring">@Model.MetaDescription</textarea>
                            </div>

                            <div>
                                <label class="block text-[10px] font-medium mb-1 text-muted-foreground">Canonical URL</label>
                                <input type="text" name="CanonicalUrl" value="@Model.CanonicalUrl" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                            </div>
                            
                            <hr class="border-border opacity-50 my-2" />
                            <label class="block text-[10px] font-semibold text-muted-foreground uppercase mt-2 mb-1">Open Graph</label>
                            <div>
                                <label class="block text-[10px] font-medium mb-1 text-muted-foreground">OG Title</label>
                                <input type="text" name="OgTitle" value="@Model.OgTitle" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                            </div>
                            <div>
                                <label class="block text-[10px] font-medium mb-1 text-muted-foreground">OG Description</label>
                                <textarea name="OgDescription" rows="2" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring">@Model.OgDescription</textarea>
                            </div>
                            <div>
                                <label class="block text-[10px] font-medium mb-1 text-muted-foreground">OG Image</label>
                                <div class="flex gap-2 mb-2 @(string.IsNullOrEmpty(Model.OgImage) ? "hidden" : "")" id="OgImagePreviewWrapper">
                                    <img id="OgImagePreview" src="@Model.OgImage" alt="Open Graph image preview" class="w-full h-auto rounded border" />
                                </div>
                                <div class="flex gap-2">
                                    <input type="text" name="OgImage" id="OgImageInput" value="@Model.OgImage" class="flex-1 px-3 py-2 bg-background border border-input rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-ring" placeholder="https://" />
                                    <button type="button" 
                                            onclick="window.dispatchEvent(new CustomEvent('open-media-selector', { detail: { targetInput: 'OgImageInput', previewImg: 'OgImagePreview', folder: 'og' } })); document.getElementById('OgImagePreviewWrapper').classList.remove('hidden');" 
                                            class="px-2 py-1 bg-secondary text-secondary-foreground border border-border rounded-md text-xs font-medium shrink-0">Select</button>
                                </div>
                            </div>

                            <hr class="border-border opacity-50 my-2" />
                            <label class="block text-[10px] font-semibold text-muted-foreground uppercase mt-2 mb-1">Twitter Card</label>
                            <div>
                                <label class="block text-[10px] font-medium mb-1 text-muted-foreground">Twitter Title</label>
                                <input type="text" name="TwitterTitle" value="@Model.TwitterTitle" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                            </div>
                            <div>
                                <label class="block text-[10px] font-medium mb-1 text-muted-foreground">Twitter Description</label>
                                <textarea name="TwitterDescription" rows="2" class="w-full px-3 py-2 bg-background border border-input rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-ring">@Model.TwitterDescription</textarea>
                            </div>
                            <div>
                                <label class="block text-[10px] font-medium mb-1 text-muted-foreground">Twitter Image</label>
                                <div class="flex gap-2 mb-2 @(string.IsNullOrEmpty(Model.TwitterImage) ? "hidden" : "")" id="TwitterImagePreviewWrapper">
                                    <img id="TwitterImagePreview" src="@Model.TwitterImage" alt="Twitter card image preview" class="w-full h-auto rounded border" />
                                </div>
                                <div class="flex gap-2">
                                    <input type="text" name="TwitterImage" id="TwitterImageInput" value="@Model.TwitterImage" class="flex-1 px-3 py-2 bg-background border border-input rounded-md text-xs focus:outline-none focus:ring-2 focus:ring-ring" placeholder="https://" />
                                    <button type="button" 
                                            onclick="window.dispatchEvent(new CustomEvent('open-media-selector', { detail: { targetInput: 'TwitterImageInput', previewImg: 'TwitterImagePreview', folder: 'twitter' } })); document.getElementById('TwitterImagePreviewWrapper').classList.remove('hidden');" 
                                            class="px-2 py-1 bg-secondary text-secondary-foreground border border-border rounded-md text-xs font-medium shrink-0">Select</button>
                                </div>
                            </div>
                        </div>
                    </details>
                </div>
                <div id="componentSettingsView" class="p-4 hidden">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-semibold text-sm" id="compSettingsTitle">Component</h3>
                        <button type="button" onclick="showPageSettings()" class="text-xs text-muted-foreground hover:text-foreground flex items-center gap-1">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l-7-7 7-7"/></svg>
                            Page
                        </button>
                    </div>
                    <div id="compSettingsBody" class="space-y-3"></div>
                </div>
            </aside>
        </div>
    </form>
    <partial name="_EditorModeForm" model="Model" />
</div>

<partial name="_MediaSelectorModal" />

<script>
    // Phone-width settings sheet: hidden until asked for, then covers the canvas. Desktop keeps the fixed column.
    window.toggleSettingsPanel = function (open) {
        var panel = document.getElementById('settingsPanel'), toggle = document.getElementById('settingsToggle');
        var show = typeof open === 'boolean' ? open : panel.classList.contains('hidden');
        panel.classList.toggle('hidden', !show);
        panel.classList.toggle('flex', show);
        if (toggle) toggle.setAttribute('aria-expanded', show ? 'true' : 'false');
        if (show) { var close = panel.querySelector('[data-settings-close]'); if (close) close.focus(); }
        else if (toggle) toggle.focus();
    };
    document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape' || !window.matchMedia('(max-width: 767.98px)').matches) return;
        var panel = document.getElementById('settingsPanel');
        if (panel && !panel.classList.contains('hidden')) toggleSettingsPanel(false);
    });
    // Sidebar sections remember whether they were open, per section, in this browser only.
    (function () {
        document.querySelectorAll('details[data-desk-section]').forEach(function (d) {
            var key = 'desk.section.' + d.dataset.deskSection;
            try { var saved = localStorage.getItem(key); if (saved === '1') d.open = true; else if (saved === '0') d.open = false; } catch (e) { /* storage unavailable: keep the default */ }
            d.addEventListener('toggle', function () { try { localStorage.setItem(key, d.open ? '1' : '0'); } catch (e) { /* nothing to remember with */ } });
        });
    })();
</script>

@* Publish confirmation goes through the shared Desk dialog (focus trap, Escape, both schemes); copy: "This will update your page." *@
<script>window.pagePublishBody = @Json.Serialize("This will update your page.");</script>

<link rel="stylesheet" href="~/css/inkwell-builder.css" asp-append-version="true" />

@section Scripts {
<partial name="_EditorSwitchGuard" />
@if (Model.IsMarkdown)
{
    <partial name="_MarkdownEditorScripts" />
}
<script src="~/js/inkwell-builder.js" asp-append-version="true"></script>
<script>
(function() {
    // The block builder is shared with the post editor (wwwroot/js/inkwell-builder.js); this page adds its own slug and publish steps.
    const builder = InkwellBuilder.init({
        canvas: 'canvas', canvasEmpty: 'canvasEmpty', canvasScroll: 'canvasScroll',
        settingsView: 'pageSettingsView', componentView: 'componentSettingsView',
        componentTitle: 'compSettingsTitle', componentBody: 'compSettingsBody',
        content: 'pageContent', hydrate: true
    });
    document.getElementById('pageForm').addEventListener('submit', function() { document.getElementById('pageContent').value = builder.extract(); });

    // ── SLUG ──
    document.getElementById('slugInput').addEventListener('input', function() { this.dataset.manual='true'; this.value=this.value.toLowerCase().replace(/[^a-z0-9\s-]/g,'').replace(/[\s_]+/g,'-').replace(/-+/g,'-').replace(/^-+|-+$/g,''); });

    // ── PUBLISH ──
    document.getElementById('publishBtn').addEventListener('click', () => { InkwellDialog.confirm({ title: 'Ready to publish?', body: window.pagePublishBody, action: 'Publish page', tone: 'neutral' }).then(ok => { if (ok) window.confirmPublish(); }); });
    window.confirmPublish = function() {
        document.getElementById('pageContent').value = builder.extract();
        const form = document.getElementById('pageForm');
        let a = form.querySelector('input[name="action"]'); if(!a){a=document.createElement('input');a.type='hidden';a.name='action';form.appendChild(a);}
        a.value='publish'; InkwellDesk.submit(form);
    };
})();
</script>
}
