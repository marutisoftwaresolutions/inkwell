<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Blog.Core\Blog.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!-- Not used directly. Microsoft.Data.SqlClient 7.1.1 brings in 9.0.18, which has two published
         denial-of-service advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7); 9.0.21 is the fixed
         version. Remove this line once SqlClient depends on a fixed version itself. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Migrations\*.sql" />
    <!-- One source for the reference catalogs (ADR-0027): MigrationService seeds from the dated script itself. -->
    <EmbeddedResource Include="..\DBScripts\2026-10-05_create-and-seed-countries-timezones-date-locales.sql" LogicalName="Blog.Infrastructure.ReferenceData.sql" />
    <!-- The complete schema, applied by DatabaseBootstrapper when the database is empty (first run). -->
    <EmbeddedResource Include="..\DBScripts\init.sql" LogicalName="Blog.Infrastructure.Init.sql" />
  </ItemGroup>

</Project>
