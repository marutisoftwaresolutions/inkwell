# Copy to .env and fill in real values before `docker compose up`. .env itself is gitignored —
# never commit real values, the same rule as appsettings.json.

# Your domain, e.g. blog.example.com. Caddy requests a certificate for it automatically; the app
# uses it for the CanonicalHost redirect (http and any other host name 301 here).
DOMAIN=

# SQL Server's own admin password inside the db container. Any strong password; SQL Server 2022
# requires at least 8 characters with three of: upper, lower, digit, symbol.
MSSQL_SA_PASSWORD=
